# ==============================================================================
# FIVE Mascotas — Variables de Entorno y Configuración de Despliegue
# Host LXC apps-core (192.168.1.60) / NPM network-master (192.168.1.51)
# ==============================================================================

# Entorno y Zona Horaria
NODE_ENV=production
TZ=America/Santiago

# Red y Puertos (Host LXC apps-core)
PORT=3004

# Dominio Público / Subdominio en Cloudflare & NPM
PUBLIC_SITE_URL=https://five.epistia.cl

# Integración ERP Nexo (Producción)
# Las tres variables son exclusivas del servidor Node (nunca PUBLIC_).
NEXO_API_URL=
NEXO_STORE=
NEXO_INTEGRATION_TOKEN=

# Pasarela de Pago: Transbank Webpay Plus (REST API v1.2)
# En desarrollo / test, si se dejan vacías se usan las credenciales de integración oficiales de Transbank
# TBK_ENVIRONMENT: TEST | INTEGRACION | PRODUCCION
TBK_ENVIRONMENT=INTEGRACION
TBK_COMMERCE_CODE=597055555532
TBK_API_KEY_SECRET=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C

# Pasarela de Pago: Khipu (API v3 / Cobro por Transferencia Automatizada)
# Obtén tus credenciales de cobrador en https://khipu.com/
KHIPU_RECEIVER_ID=
KHIPU_SECRET_KEY=
KHIPU_API_URL=https://payment-api.khipu.com/v3

# Rayo · Asistente Nutricional con IA (Google Gemini 2.0 Flash - Free Tier)
# Obtén tu clave gratuita en Google AI Studio: https://aistudio.google.com/
# Si no se configura o se agota la cuota, el asistente usa el motor determinista local de FIVE sin interrumpir el servicio.
GEMINI_API_KEY=
