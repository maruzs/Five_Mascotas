    #pim-imagenes-page .pim-img-option {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding: 8px;
      background: #ffffff;
      border: 1.5px solid var(--admin-border);
      border-radius: 12px;
      cursor: pointer;
      font-family: inherit;
      transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
    }

    #pim-imagenes-page .pim-img-option:hover {
      border-color: var(--admin-primary);
      box-shadow: 0 4px 12px rgba(112, 37, 168, 0.14);
      transform: translateY(-1px);
    }

    #pim-imagenes-page .pim-img-option.is-selected {
      border-color: var(--admin-primary);
      background: var(--admin-primary-soft);
      box-shadow: 0 0 0 3px rgba(112, 37, 168, 0.18);
    }

    #pim-imagenes-page .pim-img-option img {
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: contain;
