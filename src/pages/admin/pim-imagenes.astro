      overflow: hidden;
      font-size: 9.5px;
      line-height: 1.25;
      color: var(--admin-text-muted);
      text-align: center;
      word-break: break-all;
    }

    #pim-imagenes-page .pim-img-option-check {
      position: absolute;
      top: 6px;
      right: 6px;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      align-items: center;
      justify-content: center;
      background: var(--admin-primary);
      color: #ffffff;
      font-size: 11px;
      font-weight: 900;
      display: none;
    }

    #pim-imagenes-page .pim-img-option.is-selected .pim-img-option-check {
      display: flex;
    }

    #pim-imagenes-page .pim-modal .admin-modal-foot {
      justify-content: space-between;
      flex-wrap: wrap;
    }

    #pim-imagenes-page .pim-toast {
      position: fixed;
      top: 20px;
      right: 24px;
      z-index: 3000;
      max-width: 380px;
      padding: 12px 18px;
      border-radius: 12px;
      background: #1a1a2e;
      color: #ffffff;
      font-size: 13px;
      font-weight: 650;
      box-shadow: 0 14px 34px rgba(17, 24, 39, 0.25);
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity 0.22s ease, transform 0.22s ease;
    }

    #pim-imagenes-page .pim-toast.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    #pim-imagenes-page .pim-toast.is-success { background: #15803d; }
    #pim-imagenes-page .pim-toast.is-error { background: #b91c1c; }

    @media (hover: none) {
      #pim-imagenes-page .pim-card-overlay {
        opacity: 1;
        justify-content: flex-end;
        padding-bottom: 14px;
        background: linear-gradient(180deg, rgba(17, 24, 39, 0) 45%, rgba(17, 24, 39, 0.72) 100%);
      }
    }

    @media (max-width: 768px) {
      #pim-imagenes-page .pim-stats {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        max-width: none;
      }

      #pim-imagenes-page .pim-grid {
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 12px;
      }

      #pim-imagenes-page .pim-card-name {
        font-size: 12.5px;
      }

      #pim-imagenes-page .pim-toolbar-count {
        margin-left: 0;
      }
    }

    @media (max-width: 640px) {
      #pim-imagenes-page .pim-savebar {
        left: 12px;
        right: 12px;
        bottom: 12px;
        transform: translateY(12px);
        justify-content: space-between;
        gap: 12px;
        padding: 12px;
      }

      #pim-imagenes-page .pim-savebar.is-visible {
        transform: translateY(0);
      }

      #pim-imagenes-page .pim-toast {
        left: 12px;
        right: 12px;
        max-width: none;
      }
    }

    @media (max-width: 480px) {
      #pim-imagenes-page .pim-stats {
        grid-template-columns: 1fr;
      }

      #pim-imagenes-page .pim-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
      }
    }
  </style>

  <script>
    interface Product {
      id: string;
      name: string;
      pet: string;
      brand: string;
      category: string;
      subcategory?: string;
      detail?: string;
      format: string;
      lifeStage?: string;
      price: number;
      oldPrice: number;
      image?: string;
      images?: string[];
      [key: string]: unknown;
    }

    const FALLBACK_IMAGE = '/five-mascotas/alimento-0.svg';

    const grid = document.getElementById('grid-productos') as HTMLElement;
    const emptyState = document.getElementById('estado-vacio') as HTMLElement;
    const loadingState = document.getElementById('estado-carga') as HTMLElement;
    const errorState = document.getElementById('estado-error') as HTMLElement;
    const errorDetail = document.getElementById('error-detalle') as HTMLElement;
    const modal = document.getElementById('modal-imagen') as HTMLElement;
    const modalGrid = document.getElementById('modal-grid-imagenes') as HTMLElement;
    const modalSearch = document.getElementById('modal-buscar') as HTMLInputElement;
    const modalCount = document.getElementById('modal-conteo') as HTMLElement;
    const modalTitle = document.getElementById('modal-titulo-prod') as HTMLElement;
    const modalSub = document.getElementById('modal-sub-prod') as HTMLElement;
    const saveBar = document.getElementById('barra-cambios') as HTMLElement;
    const saveBarCount = document.getElementById('savebar-count') as HTMLElement;
    const saveBarText = document.getElementById('savebar-text') as HTMLElement;
    const btnSaveHeader = document.getElementById('btn-guardar-todo') as HTMLButtonElement;
    const btnSaveBar = document.getElementById('btn-guardar-savebar') as HTMLButtonElement;
    const saveLabelHeader = document.getElementById('save-label-header') as HTMLElement;
    const saveLabelBar = document.getElementById('save-label-bar') as HTMLElement;
    const searchInput = document.getElementById('filtro-buscar') as HTMLInputElement;
    const filterPet = document.getElementById('filtro-mascota') as HTMLSelectElement;
    const filterCategory = document.getElementById('filtro-categoria') as HTMLSelectElement;
    const filterImage = document.getElementById('filtro-imagen') as HTMLSelectElement;
    const countLabel = document.getElementById('conteo-visibles') as HTMLElement;
    const btnClearFilters = document.getElementById('btn-limpiar-filtros') as HTMLButtonElement;
    const statPlaceholder = document.getElementById('stat-placeholder') as HTMLButtonElement;
    const statTotalValue = document.getElementById('stat-total-value') as HTMLElement;
    const statPlaceholderValue = document.getElementById('stat-placeholder-value') as HTMLElement;
    const statChangesValue = document.getElementById('stat-changes-value') as HTMLElement;
    const uploadInput = document.getElementById('input-upload-nueva') as HTMLInputElement;
    const uploadLabelText = document.getElementById('upload-label-text') as HTMLElement;
    const toastEl = document.getElementById('pim-toast') as HTMLElement;

    let allProducts: Product[] = [];
    let allImages: string[] = [];
    let changes: Record<string, Partial<Product>> = {};
    let currentEditId: string | null = null;
    let toastTimer: number | undefined;

    const esc = (value: unknown): string =>
      String(value ?? '').replace(/[&<>"']/g, (char) => {
        const map: Record<string, string> = {
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;',
        };
        return map[char] ?? char;
      });

    const isPlaceholder = (url?: string): boolean =>
      !url ||
      url.includes('/five-mascotas/alimento') ||
      url.includes('placeholder') ||
      url === '/placeholder.svg' ||
      url.includes('/demos/') ||
      url.includes('/botiquin') ||
      url.includes('/snack.svg') ||
      url.includes('/plato.svg') ||
      url.includes('/pelota.svg');

    const getEffective = (product: Product): Product => ({ ...product, ...(changes[product.id] || {}) });

    function setFilterUIState() {
      const hasFilters =
        searchInput.value.trim() !== '' ||
        filterPet.value !== 'todos' ||
        filterCategory.value !== 'todos' ||
        filterImage.value !== 'todos';

      btnClearFilters.hidden = !hasFilters;
      statPlaceholder.classList.toggle('is-active', filterImage.value === 'sin-imagen');
    }

    function showState(state: 'loading' | 'error' | 'ready') {
      loadingState.hidden = state !== 'loading';
      errorState.hidden = state !== 'error';
      grid.hidden = state !== 'ready';
      if (state !== 'ready') emptyState.hidden = true;
    }

    function matchesFilters(product: Product): boolean {
      const effective = getEffective(product);
      const search = searchInput.value.trim().toLowerCase();

      if (search && !`${effective.name} ${effective.brand} ${effective.format}`.toLowerCase().includes(search)) return false;
      if (filterPet.value !== 'todos' && effective.pet !== filterPet.value) return false;
      if (filterCategory.value !== 'todos' && effective.category !== filterCategory.value) return false;
      if (filterImage.value === 'sin-imagen' && !isPlaceholder(effective.image)) return false;
      if (filterImage.value === 'con-imagen' && isPlaceholder(effective.image)) return false;
      return true;
    }

    function buildCard(product: Product): string {
      const effective = getEffective(product);
      const changed = Boolean(changes[product.id]);
      const placeholder = isPlaceholder(effective.image);
      const imageSrc = effective.image || FALLBACK_IMAGE;
      const pet = effective.pet || '';

      return `
        <article class="pim-card${changed ? ' is-changed' : ''}" data-id="${esc(product.id)}">
          <div class="pim-card-img" data-edit="${esc(product.id)}" role="button" tabindex="0" aria-label="Cambiar imagen de ${esc(effective.name)}">
            <img src="${esc(imageSrc)}" alt="${esc(effective.name)}" loading="lazy" onerror="this.onerror=null;this.src='${FALLBACK_IMAGE}'" />
            ${placeholder ? '<span class="pim-badge pim-badge-alert">Sin foto real</span>' : ''}
            ${changed ? '<span class="pim-badge pim-badge-change">Sin guardar</span>' : ''}
            <span class="pim-card-overlay">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
              </svg>
              Cambiar imagen
            </span>
          </div>
          <div class="pim-card-body">
            <div class="pim-card-top">
              <span class="pim-card-brand">${esc(effective.brand || 'Sin marca')}</span>
              <span class="pim-card-id">${esc(product.id)}</span>
            </div>
            <h3 class="pim-card-name" title="${esc(effective.name)}">${esc(effective.name)}</h3>
            <p class="pim-card-meta">${esc(effective.format || 'Sin formato')} <span>·</span> ${esc(effective.category || 'Sin categoría')}</p>
            <div class="pim-pet-toggle" role="group" aria-label="Mascota de ${esc(effective.name)}">
              <button type="button" class="pim-pet-btn${pet === 'Perros' ? ' is-active' : ''}" data-pet="Perros" aria-pressed="${pet === 'Perros'}">🐶 Perros</button>
              <button type="button" class="pim-pet-btn${pet === 'Gatos' ? ' is-active' : ''}" data-pet="Gatos" aria-pressed="${pet === 'Gatos'}">🐱 Gatos</button>
              <button type="button" class="pim-pet-btn${pet === 'Perros Gatos' ? ' is-active' : ''}" data-pet="Perros Gatos" aria-pressed="${pet === 'Perros Gatos'}">🐾 Ambos</button>
            </div>
          </div>
        </article>
      `;
    }

    function renderGrid() {
      const filtered = allProducts.filter(matchesFilters);
      countLabel.textContent = `${filtered.length} de ${allProducts.length} productos`;

      if (filtered.length === 0) {
        grid.innerHTML = '';
        grid.hidden = true;
        emptyState.hidden = false;
        return;
      }

      emptyState.hidden = true;
      grid.hidden = false;
      grid.innerHTML = filtered.map(buildCard).join('');
    }

    function refreshCard(id: string) {
      const product = allProducts.find((p) => p.id === id);
      if (!product) return;

      if (!matchesFilters(product)) {
        renderGrid();
        return;
      }

      const card = grid.querySelector(`.pim-card[data-id="${CSS.escape(id)}"]`);
      if (card) card.outerHTML = buildCard(product);
    }

    function updateStats() {
      const placeholders = allProducts.filter((p) => isPlaceholder(getEffective(p).image)).length;
      const pending = Object.keys(changes).length;

      statTotalValue.textContent = String(allProducts.length);
      statPlaceholderValue.textContent = String(placeholders);
      statChangesValue.textContent = String(pending);
    }

    function updateSaveBar() {
      const pending = Object.keys(changes).length;
      saveBarCount.textContent = String(pending);
      saveBarText.textContent = pending === 1 ? 'cambio pendiente' : 'cambios pendientes';
      btnSaveHeader.disabled = pending === 0;

      if (pending > 0) {
        if (saveBar.hidden) {
          saveBar.hidden = false;
          requestAnimationFrame(() => saveBar.classList.add('is-visible'));
        }
      } else {
        saveBar.classList.remove('is-visible');
        window.setTimeout(() => {
          if (Object.keys(changes).length === 0) saveBar.hidden = true;
        }, 220);
      }
    }

    function applyChange(id: string, patch: Partial<Product>) {
      const product = allProducts.find((p) => p.id === id);
      if (!product) return;

      const next = { ...(changes[id] || {}), ...patch };
      const isNoop = Object.entries(next).every(
        ([key, value]) => (product as Record<string, unknown>)[key] === value,
      );

      if (isNoop) delete changes[id];
      else changes[id] = next;

      refreshCard(id);
      updateStats();
      updateSaveBar();
    }

    function clearFilters() {
      searchInput.value = '';
      filterPet.value = 'todos';
      filterCategory.value = 'todos';
      filterImage.value = 'todos';
      renderGrid();
      setFilterUIState();
    }

    function toast(message: string, type: 'success' | 'error' | 'info') {
      toastEl.textContent = message;
      toastEl.className = `pim-toast is-${type}`;
      toastEl.hidden = false;
      requestAnimationFrame(() => toastEl.classList.add('is-visible'));
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => {
        toastEl.classList.remove('is-visible');
        window.setTimeout(() => {
          toastEl.hidden = true;
        }, 250);
      }, 3800);
    }

    function setSaving(saving: boolean) {
      btnSaveHeader.disabled = saving || Object.keys(changes).length === 0;
      btnSaveBar.disabled = saving;
      saveLabelHeader.textContent = saving ? 'Guardando…' : 'Guardar cambios';
      saveLabelBar.textContent = saving ? 'Guardando…' : 'Guardar cambios';
    }

    async function saveChanges() {
      const pending = Object.keys(changes).length;
      if (pending === 0) return;

      setSaving(true);
      try {
        const merged = allProducts.map((p) => ({ ...p, ...(changes[p.id] || {}) }));
        const res = await fetch('/api/pim', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ products: merged }),
        });
        const data = await res.json().catch(() => ({}));

        if (!res.ok || !data.ok) {
          throw new Error(data.error || `HTTP ${res.status}`);
        }

        allProducts = merged;
        changes = {};
        renderGrid();
        updateStats();
        updateSaveBar();
        toast(`Se guardaron ${pending} cambio${pending === 1 ? '' : 's'} correctamente.`, 'success');
      } catch (err) {
        toast('No se pudieron guardar los cambios: ' + (err instanceof Error ? err.message : String(err)), 'error');
        btnSaveHeader.disabled = false;
      } finally {
        setSaving(false);
      }
    }

    function discardChanges() {
      const pending = Object.keys(changes).length;
      if (pending === 0) return;
      if (!confirm(`¿Descartar ${pending} cambio${pending === 1 ? '' : 's'} sin guardar?`)) return;

      changes = {};
      renderGrid();
      updateStats();
      updateSaveBar();
      toast('Cambios descartados.', 'info');
    }

    function renderModalImages(query: string, currentImage?: string) {
      const term = query.trim().toLowerCase();
      const filtered = term ? allImages.filter((url) => url.toLowerCase().includes(term)) : allImages;

      modalCount.textContent = `${filtered.length} imagen${filtered.length === 1 ? '' : 'es'} disponible${filtered.length === 1 ? '' : 's'}`;

      if (filtered.length === 0) {
        modalGrid.innerHTML = '<p class="pim-modal-empty">No se encontraron imágenes con ese término.</p>';
        return;
      }

      modalGrid.innerHTML = filtered
        .map((url) => {
          const filename = url.split('/').pop() || url;
          const selected = url === currentImage;
          return `
            <button type="button" class="pim-img-option${selected ? ' is-selected' : ''}" data-url="${esc(url)}" title="${esc(filename)}">
              <img src="${esc(url)}" alt="${esc(filename)}" loading="lazy" onerror="this.onerror=null;this.src='${FALLBACK_IMAGE}'" />
              <span class="pim-img-option-name">${esc(filename)}</span>
              <span class="pim-img-option-check">✓</span>
            </button>
          `;
        })
        .join('');
    }

    function openImageModal(productId: string) {
      const product = allProducts.find((p) => p.id === productId);
      if (!product) return;

      currentEditId = productId;
      const effective = getEffective(product);

      modalTitle.textContent = 'Seleccionar imagen';
      modalSub.textContent = `${effective.name} · ${effective.brand} · ${effective.format}`;
      modalSearch.value = '';
      modal.hidden = false;
      document.body.classList.add('overflow-hidden');
      renderModalImages('', effective.image);
      window.setTimeout(() => modalSearch.focus(), 60);
    }

    function closeImageModal() {
      modal.hidden = true;
      document.body.classList.remove('overflow-hidden');
      currentEditId = null;
    }

    function readFileAsDataURL(file: File): Promise<string> {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(String(reader.result));
        reader.onerror = () => reject(new Error('No se pudo leer el archivo'));
        reader.readAsDataURL(file);
      });
    }

    async function loadData() {
      showState('loading');
      try {
        const [pimRes, imagesRes] = await Promise.all([fetch('/api/pim'), fetch('/api/pim/images')]);

        if (!pimRes.ok) throw new Error(`HTTP ${pimRes.status}`);

        const pimData = await pimRes.json();
        allProducts = pimData?.data?.products || [];

        if (imagesRes.ok) {
          const imagesData = await imagesRes.json().catch(() => ({}));
          allImages = imagesData?.images || [];
        }

        changes = {};
        renderGrid();
        updateStats();
        updateSaveBar();
        setFilterUIState();
        showState('ready');
      } catch (err) {
        errorDetail.textContent = err instanceof Error ? err.message : String(err);
        showState('error');
      }
    }

    grid.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;

      const petButton = target.closest<HTMLButtonElement>('.pim-pet-btn');
      if (petButton) {
        const card = petButton.closest<HTMLElement>('.pim-card');
        if (card?.dataset.id && petButton.dataset.pet) {
          applyChange(card.dataset.id, { pet: petButton.dataset.pet });
        }
        return;
      }

      const imageZone = target.closest<HTMLElement>('.pim-card-img');
      if (imageZone?.dataset.edit) openImageModal(imageZone.dataset.edit);
    });

    grid.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      const imageZone = (event.target as HTMLElement).closest<HTMLElement>('.pim-card-img');
      if (!imageZone?.dataset.edit) return;
      event.preventDefault();
      openImageModal(imageZone.dataset.edit);
    });

    modalGrid.addEventListener('click', (event) => {
      const option = (event.target as HTMLElement).closest<HTMLButtonElement>('.pim-img-option');
      if (!option?.dataset.url || !currentEditId) return;
      applyChange(currentEditId, { image: option.dataset.url });
      closeImageModal();
    });

    modalSearch.addEventListener('input', () => {
      const product = currentEditId ? allProducts.find((p) => p.id === currentEditId) : null;
      renderModalImages(modalSearch.value, product ? getEffective(product).image : undefined);
    });

    document.getElementById('btn-cerrar-modal')!.addEventListener('click', closeImageModal);
    document.getElementById('btn-cancelar-modal')!.addEventListener('click', closeImageModal);

    modal.addEventListener('click', (event) => {
      if (event.target === modal) closeImageModal();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modal.hidden) closeImageModal();
    });

    document.getElementById('btn-quitar-imagen')!.addEventListener('click', () => {
      if (currentEditId) applyChange(currentEditId, { image: FALLBACK_IMAGE });
      closeImageModal();
    });

    uploadInput.addEventListener('change', async () => {
      const file = uploadInput.files?.[0];
      if (!file) return;

      if (file.size > 5 * 1024 * 1024) {
        toast('La imagen no puede superar los 5 MB.', 'error');
        uploadInput.value = '';
        return;
      }

      const previousLabel = uploadLabelText.textContent || 'Subir imagen';
      uploadLabelText.textContent = 'Subiendo…';

      try {
        const base64 = await readFileAsDataURL(file);
        const res = await fetch('/api/upload', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ base64, filename: file.name }),
        });
        const data = await res.json().catch(() => ({}));

        if (!res.ok || !data.ok || !data.url) {
          throw new Error(data.error || `HTTP ${res.status}`);
        }

        if (!allImages.includes(data.url)) allImages.unshift(data.url);
        if (currentEditId) applyChange(currentEditId, { image: data.url });
        closeImageModal();
        toast('Imagen subida y asignada al producto.', 'success');
      } catch (err) {
        toast('No se pudo subir la imagen: ' + (err instanceof Error ? err.message : String(err)), 'error');
      } finally {
        uploadLabelText.textContent = previousLabel;
        uploadInput.value = '';
      }
    });

    [searchInput, filterPet, filterCategory, filterImage].forEach((element) => {
      element.addEventListener('input', () => {
        renderGrid();
        setFilterUIState();
      });
      element.addEventListener('change', () => {
        renderGrid();
        setFilterUIState();
      });
    });

    btnClearFilters.addEventListener('click', clearFilters);
    document.getElementById('btn-limpiar-filtros-vacio')!.addEventListener('click', clearFilters);
    document.getElementById('btn-reintentar')!.addEventListener('click', loadData);

    btnSaveHeader.addEventListener('click', saveChanges);
    btnSaveBar.addEventListener('click', saveChanges);
    document.getElementById('btn-descartar')!.addEventListener('click', discardChanges);

    statPlaceholder.addEventListener('click', () => {
      filterImage.value = filterImage.value === 'sin-imagen' ? 'todos' : 'sin-imagen';
      renderGrid();
      setFilterUIState();
    });

    loadData();
  </script>
</AdminLayout>
