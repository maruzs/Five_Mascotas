    #pim-imagenes-page .pim-modal {
      max-width: 980px;
      height: min(88vh, 780px);
    }

    #pim-imagenes-page .pim-modal .admin-modal-head {
      padding: 18px 24px;
    }

    #pim-imagenes-page .pim-modal-toolbar {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
