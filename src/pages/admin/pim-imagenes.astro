---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="FIVE Admin — Editor de Imágenes y Fichas" activeNav="imagenes" breadcrumbTitle="Editor de Imágenes y Fichas">
  <div class="pim-img-editor" id="pim-imagenes-page">
    <div class="admin-page-header">
      <div class="pim-header-top">
        <div>
          <h1>Editor de Imágenes y Fichas</h1>
          <p>Corrige la foto asignada y la categoría de mascota de cada producto. Los cambios se acumulan y se guardan en un solo paso.</p>
        </div>
        <button type="button" class="admin-btn primary" id="btn-guardar-todo" disabled>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
            <polyline points="17 21 17 13 7 13 7 21"></polyline>
            <polyline points="7 3 7 8 15 8"></polyline>
          </svg>
          <span id="save-label-header">Guardar cambios</span>
        </button>
      </div>

      <div class="pim-stats">
        <div class="pim-stat">
          <span class="pim-stat-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
              <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
          </span>
          <span class="pim-stat-text">
            <strong class="pim-stat-value" id="stat-total-value">—</strong>
            <span class="pim-stat-label">Productos en catálogo</span>
          </span>
        </div>

        <button type="button" class="pim-stat is-warning is-clickable" id="stat-placeholder" title="Filtrar productos sin foto real">
          <span class="pim-stat-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
              <line x1="12" y1="9" x2="12" y2="13"></line>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
          </span>
          <span class="pim-stat-text">
            <strong class="pim-stat-value" id="stat-placeholder-value">—</strong>
            <span class="pim-stat-label">Sin foto real · clic para filtrar</span>
          </span>
        </button>

        <div class="pim-stat is-changes">
          <span class="pim-stat-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
            </svg>
          </span>
          <span class="pim-stat-text">
            <strong class="pim-stat-value" id="stat-changes-value">—</strong>
            <span class="pim-stat-label">Cambios pendientes</span>
          </span>
        </div>
      </div>
    </div>

    <div class="admin-card pim-toolbar-card">
      <div class="pim-toolbar">
        <div class="pim-search-wrap">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="search" id="filtro-buscar" class="admin-search-input" placeholder="Buscar por nombre, marca o formato…" autocomplete="off" />
        </div>
        <select id="filtro-mascota" class="admin-select" aria-label="Filtrar por mascota">
          <option value="todos">Todas las mascotas</option>
          <option value="Perros">Perros</option>
          <option value="Gatos">Gatos</option>
          <option value="Perros Gatos">Perros y Gatos</option>
        </select>
        <select id="filtro-categoria" class="admin-select" aria-label="Filtrar por categoría">
          <option value="todos">Todas las categorías</option>
          <option value="Alimentos">Alimentos</option>
          <option value="Farmacia">Farmacia</option>
          <option value="Accesorios">Accesorios</option>
          <option value="Higiene">Higiene</option>
          <option value="Snacks">Snacks</option>
        </select>
        <select id="filtro-imagen" class="admin-select" aria-label="Filtrar por estado de imagen">
          <option value="todos">Todas las imágenes</option>
          <option value="sin-imagen">Sin foto real</option>
          <option value="con-imagen">Con foto asignada</option>
        </select>
        <button type="button" class="admin-btn secondary" id="btn-limpiar-filtros" hidden>Limpiar filtros</button>
        <span class="pim-toolbar-count" id="conteo-visibles">— productos</span>
      </div>
    </div>

    <div id="estado-carga" class="pim-grid" aria-hidden="true">
      {Array.from({ length: 12 }).map(() => (
        <div class="pim-skeleton">
          <div class="pim-skeleton-img"></div>
          <div class="pim-skeleton-body">
            <div class="pim-skeleton-line w60"></div>
            <div class="pim-skeleton-line w90"></div>
            <div class="pim-skeleton-line w40"></div>
          </div>
        </div>
      ))}
    </div>

    <div id="estado-error" class="admin-card pim-state" hidden>
      <span class="pim-state-icon is-error">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
      </span>
      <h3>No se pudo cargar el catálogo</h3>
      <p>Hubo un problema al conectar con el servidor. <span id="error-detalle"></span></p>
      <button type="button" class="admin-btn primary" id="btn-reintentar">Reintentar</button>
    </div>

    <div id="estado-vacio" class="admin-card pim-state" hidden>
      <span class="pim-state-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          <line x1="8" y1="11" x2="14" y2="11"></line>
        </svg>
      </span>
      <h3>Sin resultados</h3>
      <p>No hay productos que coincidan con los filtros seleccionados.</p>
      <button type="button" class="admin-btn secondary" id="btn-limpiar-filtros-vacio">Limpiar filtros</button>
    </div>

    <div id="grid-productos" class="pim-grid" hidden></div>

    <div id="barra-cambios" class="pim-savebar" hidden>
      <span class="pim-savebar-info">
        <strong class="pim-savebar-count" id="savebar-count">0</strong>
        <span id="savebar-text">cambios pendientes</span>
      </span>
      <span class="pim-savebar-actions">
        <button type="button" class="admin-btn secondary" id="btn-descartar">Descartar</button>
        <button type="button" class="admin-btn primary" id="btn-guardar-savebar"><span id="save-label-bar">Guardar cambios</span></button>
      </span>
    </div>

    <div id="modal-imagen" class="admin-modal-backdrop" hidden>
      <div class="admin-modal pim-modal" role="dialog" aria-modal="true" aria-labelledby="modal-titulo-prod">
        <div class="admin-modal-head">
          <div>
            <h3 id="modal-titulo-prod">Seleccionar imagen</h3>
            <span class="admin-card-subtitle" id="modal-sub-prod"></span>
          </div>
          <button type="button" class="pim-icon-btn" id="btn-cerrar-modal" aria-label="Cerrar">&times;</button>
        </div>

        <div class="pim-modal-toolbar">
          <input type="search" id="modal-buscar" class="admin-search-input" placeholder="Buscar packshot por nombre de archivo…" autocomplete="off" />
          <label class="admin-btn primary pim-upload-label">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17 8 12 3 7 8"></polyline>
              <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
            <span id="upload-label-text">Subir imagen</span>
            <input type="file" id="input-upload-nueva" accept="image/png,image/jpeg,image/webp" hidden />
          </label>
        </div>

        <p class="pim-modal-count" id="modal-conteo"></p>

        <div id="modal-grid-imagenes" class="pim-modal-grid"></div>

        <div class="admin-modal-foot">
          <button type="button" class="admin-btn danger" id="btn-quitar-imagen">Usar imagen genérica</button>
          <button type="button" class="admin-btn secondary" id="btn-cancelar-modal">Cancelar</button>
        </div>
      </div>
    </div>

    <div id="pim-toast" class="pim-toast" role="status" aria-live="polite" hidden></div>
  </div>

  <style is:global>
    #pim-imagenes-page {
      padding-bottom: 90px;
    }

    #pim-imagenes-page .pim-header-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }

    #pim-imagenes-page .pim-stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
      margin-top: 22px;
      max-width: 780px;
    }

    #pim-imagenes-page .pim-stat {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      background: #ffffff;
      border: 1px solid var(--admin-border);
      border-radius: 14px;
      text-align: left;
      font-family: inherit;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    #pim-imagenes-page .pim-stat.is-clickable {
      cursor: pointer;
    }

    #pim-imagenes-page .pim-stat.is-clickable:hover {
      border-color: #f0b27a;
      box-shadow: 0 4px 14px rgba(230, 126, 34, 0.1);
    }

    #pim-imagenes-page .pim-stat.is-warning.is-active {
      border-color: #f0b27a;
      box-shadow: 0 0 0 3px rgba(230, 126, 34, 0.14);
    }

    #pim-imagenes-page .pim-stat-icon {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--admin-bg);
      color: var(--admin-primary);
      flex-shrink: 0;
    }

    #pim-imagenes-page .pim-stat.is-warning .pim-stat-icon {
      background: var(--admin-accent-orange-soft);
      color: var(--admin-accent-orange);
    }

    #pim-imagenes-page .pim-stat.is-changes .pim-stat-icon {
      background: var(--admin-primary-soft);
      color: var(--admin-primary);
    }

    #pim-imagenes-page .pim-stat-text {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    #pim-imagenes-page .pim-stat-value {
      font-size: 20px;
      font-weight: 850;
      line-height: 1.1;
      letter-spacing: -0.5px;
      color: var(--admin-text-main);
    }

    #pim-imagenes-page .pim-stat-label {
      font-size: 11.5px;
      font-weight: 600;
      color: var(--admin-text-muted);
      margin-top: 2px;
    }

    #pim-imagenes-page .pim-toolbar-card {
      margin-bottom: 20px;
      padding: 14px 18px;
    }

    #pim-imagenes-page .pim-toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
    }

    #pim-imagenes-page .pim-search-wrap {
      position: relative;
      flex: 1 1 240px;
      min-width: 190px;
    }

    #pim-imagenes-page .pim-search-wrap svg {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: #adb5bd;
      pointer-events: none;
    }

    #pim-imagenes-page .pim-search-wrap .admin-search-input {
      padding-left: 38px;
    }

    #pim-imagenes-page .pim-toolbar .admin-select {
      min-width: 148px;
    }

    #pim-imagenes-page .pim-toolbar-count {
      margin-left: auto;
      font-size: 12.5px;
      font-weight: 650;
      color: var(--admin-text-muted);
      white-space: nowrap;
    }

    #pim-imagenes-page .admin-btn {
      cursor: pointer;
    }

    #pim-imagenes-page .admin-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    #pim-imagenes-page .pim-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 18px;
    }

    #pim-imagenes-page .pim-card {
      background: #ffffff;
      border: 1.5px solid var(--admin-border);
      border-radius: 16px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: box-shadow 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
    }

    #pim-imagenes-page .pim-card:hover {
      transform: translateY(-2px);
      border-color: #dcc6ef;
      box-shadow: 0 10px 26px rgba(17, 24, 39, 0.08);
    }

    #pim-imagenes-page .pim-card.is-changed {
      border-color: #f0b429;
      box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.14);
    }

    #pim-imagenes-page .pim-card-img {
      position: relative;
      aspect-ratio: 1 / 1;
      background: radial-gradient(circle at 50% 38%, #ffffff 0%, #f5f7fa 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      overflow: hidden;
      outline: none;
    }

    #pim-imagenes-page .pim-card-img:focus-visible {
      box-shadow: inset 0 0 0 3px rgba(112, 37, 168, 0.35);
    }

    #pim-imagenes-page .pim-card-img img {
      max-width: 84%;
      max-height: 84%;
      width: auto;
      height: auto;
      object-fit: contain;
      transition: transform 0.25s ease;
      filter: drop-shadow(0 6px 14px rgba(17, 24, 39, 0.1));
    }

    #pim-imagenes-page .pim-card:hover .pim-card-img img {
      transform: scale(1.045);
    }

    #pim-imagenes-page .pim-card-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: rgba(112, 37, 168, 0.78);
      color: #ffffff;
      font-size: 12.5px;
      font-weight: 750;
      letter-spacing: 0.2px;
      opacity: 0;
      transition: opacity 0.18s ease;
    }

    #pim-imagenes-page .pim-card-img:hover .pim-card-overlay {
      opacity: 1;
    }

    #pim-imagenes-page .pim-badge {
      position: absolute;
      top: 10px;
      left: 10px;
      font-size: 10px;
      font-weight: 800;
      padding: 4px 9px;
      border-radius: 999px;
      letter-spacing: 0.2px;
      backdrop-filter: blur(4px);
      z-index: 2;
    }

    #pim-imagenes-page .pim-badge-alert {
      background: rgba(254, 226, 226, 0.95);
      color: #dc2626;
      border: 1px solid #fecaca;
    }

    #pim-imagenes-page .pim-badge-change {
      left: auto;
      right: 10px;
      background: rgba(254, 243, 199, 0.95);
      color: #b45309;
      border: 1px solid #fde68a;
    }

    #pim-imagenes-page .pim-card-body {
      padding: 14px 16px 16px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      flex: 1;
    }

    #pim-imagenes-page .pim-card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    #pim-imagenes-page .pim-card-brand {
      font-size: 10.5px;
      font-weight: 800;
      color: var(--admin-primary);
      text-transform: uppercase;
      letter-spacing: 0.6px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    #pim-imagenes-page .pim-card-id {
      font-size: 10px;
      color: #adb5bd;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      flex-shrink: 0;
    }

    #pim-imagenes-page .pim-card-name {
      margin: 0;
      font-size: 13.5px;
      font-weight: 750;
      color: var(--admin-text-main);
      line-height: 1.35;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      min-height: 2.7em;
    }

    #pim-imagenes-page .pim-card-meta {
      margin: 0;
      font-size: 11.5px;
      color: var(--admin-text-muted);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    #pim-imagenes-page .pim-card-meta span {
      color: #ced4da;
      margin-inline: 2px;
    }

    #pim-imagenes-page .pim-pet-toggle {
      margin-top: auto;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 4px;
      padding: 4px;
      background: var(--admin-bg);
      border: 1px solid var(--admin-border-subtle);
      border-radius: 10px;
    }

    #pim-imagenes-page .pim-pet-btn {
      border: 0;
      background: transparent;
      border-radius: 7px;
      padding: 6px 2px;
      font-size: 10.5px;
      font-weight: 700;
      font-family: inherit;
      color: var(--admin-text-muted);
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.15s ease;
    }

    #pim-imagenes-page .pim-pet-btn:hover {
      background: #ffffff;
      color: var(--admin-text-main);
    }

    #pim-imagenes-page .pim-pet-btn.is-active {
      background: #ffffff;
      color: var(--admin-primary);
      box-shadow: 0 1px 4px rgba(17, 24, 39, 0.12);
    }

    #pim-imagenes-page .pim-skeleton {
      background: #ffffff;
      border: 1px solid var(--admin-border);
      border-radius: 16px;
      overflow: hidden;
    }

    #pim-imagenes-page .pim-skeleton-img {
      aspect-ratio: 1 / 1;
      background: linear-gradient(90deg, #f1f3f5 25%, #e9ecef 37%, #f1f3f5 63%);
      background-size: 400% 100%;
      animation: pim-shimmer 1.4s ease infinite;
    }

    #pim-imagenes-page .pim-skeleton-body {
      padding: 14px 16px 16px;
      display: flex;
      flex-direction: column;
      gap: 9px;
    }

    #pim-imagenes-page .pim-skeleton-line {
      height: 11px;
      border-radius: 6px;
      background: linear-gradient(90deg, #f1f3f5 25%, #e9ecef 37%, #f1f3f5 63%);
      background-size: 400% 100%;
      animation: pim-shimmer 1.4s ease infinite;
    }

    #pim-imagenes-page .w90 { width: 90%; }
    #pim-imagenes-page .w60 { width: 60%; }
    #pim-imagenes-page .w40 { width: 40%; }

    @keyframes pim-shimmer {
      0% { background-position: 100% 0; }
      100% { background-position: 0 0; }
    }

    #pim-imagenes-page .pim-state {
      padding: 56px 24px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      text-align: center;
    }

    #pim-imagenes-page .pim-state-icon {
      width: 56px;
      height: 56px;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--admin-bg);
      color: var(--admin-text-muted);
      margin-bottom: 6px;
    }

    #pim-imagenes-page .pim-state-icon.is-error {
      background: var(--admin-accent-red-soft);
      color: var(--admin-accent-red);
    }

    #pim-imagenes-page .pim-state h3 {
      margin: 0;
      font-size: 16px;
      font-weight: 800;
    }

    #pim-imagenes-page .pim-state p {
      margin: 0 0 10px;
      max-width: 440px;
      font-size: 13.5px;
      color: var(--admin-text-muted);
    }

    #pim-imagenes-page .pim-savebar {
      position: fixed;
      left: 50%;
      bottom: 24px;
      transform: translate(-50%, 12px);
      z-index: 1500;
      display: flex;
      align-items: center;
      gap: 22px;
      padding: 12px 16px 12px 20px;
      background: #1a1a2e;
      color: #ffffff;
      border-radius: 14px;
      box-shadow: 0 18px 40px rgba(17, 24, 39, 0.28);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    #pim-imagenes-page .pim-savebar.is-visible {
      opacity: 1;
      transform: translate(-50%, 0);
      pointer-events: auto;
    }

    #pim-imagenes-page .pim-savebar-info {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
      font-weight: 600;
      white-space: nowrap;
    }

    #pim-imagenes-page .pim-savebar-count {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 26px;
      height: 26px;
      padding-inline: 6px;
      border-radius: 999px;
      background: var(--admin-primary);
      font-size: 13px;
      font-weight: 850;
    }

    #pim-imagenes-page .pim-savebar-actions {
