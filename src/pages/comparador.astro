---
// src/pages/comparador.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { products } from '../data/pim/catalog';
import { defaultFoodNutrition } from '../data/pim/nutrition';

// Filter products that belong to food categories
const foodProducts = products.filter((p) => p.category === 'Alimentos' || defaultFoodNutrition[p.id]);

// Initial 2 items to compare (e.g. Fit Formula vs Purina Pro Plan or Farmina)
const initialLeft = foodProducts.find((p) => p.brand.includes('Fit')) || foodProducts[0] || products[0];
const initialRight = foodProducts.find((p) => p.brand.includes('Purina') || p.brand.includes('N&D')) || foodProducts[1] || products[1];
---

<BaseLayout
  title="Comparador Nutricional de Alimentos — FIVE Mascotas"
  description="Compara lado a lado el porcentaje de proteína, calidad de ingredientes, fuentes cárnicas reales y precio por kilo de los mejores alimentos para perros y gatos en Chile."
>
  <div class="five-wrap five-comparator-page" style="padding-block: 24px 70px;">
    <!-- Breadcrumbs -->
    <nav class="five-breadcrumbs" aria-label="Navegación">
      <ol>
        <li><a href="/">Inicio</a> <span class="five-crumb-separator">/</span></li>
        <li><span aria-current="page">Comparador de Alimentos</span></li>
      </ol>
    </nav>

    <!-- Header Section with Vet Badge -->
    <header class="comp-header">
      <div class="comp-badge-pill">
        <span class="comp-badge-dot"></span>
        <span>Herramienta Nutricional Clínica</span>
      </div>
      <h1 class="comp-title">Comparador Inteligente de Alimentos</h1>
      <p class="comp-subtitle">
        Analiza lado a lado el % de proteína bruta, las fuentes cárnicas reales, si la fórmula es libre de granos (<em>Grain-Free</em>) y el costo exacto por kilo antes de comprar.
      </p>

      <!-- Quick Animal Filter Tabs -->
      <div class="comp-filter-tabs" role="tablist" aria-label="Filtrar por especie">
        <button type="button" class="comp-tab-btn active" data-filter="all">
          Todos los Alimentos ({foodProducts.length})
        </button>
        <button type="button" class="comp-tab-btn" data-filter="perro">
          🐶 Solo Perros
        </button>
        <button type="button" class="comp-tab-btn" data-filter="gato">
          🐱 Solo Gatos
        </button>
      </div>
    </header>

    <!-- Interactive Selectors Bento Card -->
    <section class="comp-selectors-bento" aria-label="Selección de alimentos para comparar">
      <!-- Slot 1 -->
      <div class="comp-slot-card" id="slot-card-1">
        <div class="comp-slot-header">
          <span class="comp-slot-tag tag-a">Alimento 1</span>
          <span class="comp-slot-brand" id="slot-1-brand-badge">Fit Fórmula</span>
        </div>
        <div class="comp-slot-picker-wrap">
          <label for="picker-slot-1" class="comp-slot-label">Selecciona el primer producto:</label>
          <select id="picker-slot-1" class="comp-select" aria-label="Alimento 1">
            {foodProducts.map((p) => (
              <option 
                value={p.id} 
                selected={p.id === initialLeft.id}
                data-pet={p.name.toLowerCase().includes('gato') || p.name.toLowerCase().includes('kitten') || p.name.toLowerCase().includes('cat') ? 'gato' : 'perro'}
              >
                {p.brand} — {p.name} ({p.format})
              </option>
            ))}
          </select>
        </div>
      </div>

      <!-- VS Indicator -->
      <div class="comp-vs-badge" aria-hidden="true">
        <span>VS</span>
      </div>

      <!-- Slot 2 -->
      <div class="comp-slot-card" id="slot-card-2">
        <div class="comp-slot-header">
          <span class="comp-slot-tag tag-b">Alimento 2</span>
          <span class="comp-slot-brand" id="slot-2-brand-badge">Purina Pro Plan</span>
        </div>
        <div class="comp-slot-picker-wrap">
          <label for="picker-slot-2" class="comp-slot-label">Selecciona el segundo producto:</label>
          <select id="picker-slot-2" class="comp-select" aria-label="Alimento 2">
            {foodProducts.map((p) => (
              <option 
                value={p.id} 
                selected={p.id === initialRight.id}
                data-pet={p.name.toLowerCase().includes('gato') || p.name.toLowerCase().includes('kitten') || p.name.toLowerCase().includes('cat') ? 'gato' : 'perro'}
              >
                {p.brand} — {p.name} ({p.format})
              </option>
            ))}
          </select>
        </div>
      </div>

      <!-- Slot 3 (Optional) -->
      <div class="comp-slot-card comp-slot-card-optional" id="slot-card-3">
        <div class="comp-slot-header">
          <span class="comp-slot-tag tag-c">Alimento 3</span>
          <span class="comp-slot-subtext">Opcional</span>
        </div>
        <div class="comp-slot-picker-wrap">
          <label for="picker-slot-3" class="comp-slot-label">Agregar 3er alimento (opcional):</label>
          <select id="picker-slot-3" class="comp-select" aria-label="Alimento 3">
            <option value="">-- Ninguno (Comparar 2) --</option>
            {foodProducts.map((p) => (
              <option 
                value={p.id}
                data-pet={p.name.toLowerCase().includes('gato') || p.name.toLowerCase().includes('kitten') || p.name.toLowerCase().includes('cat') ? 'gato' : 'perro'}
              >
                {p.brand} — {p.name} ({p.format})
              </option>
            ))}
          </select>
        </div>
      </div>
    </section>

    <!-- Comparison Matrix Dynamic Container -->
    <main class="comp-matrix-container" id="comparison-table-container">
      <!-- Injected reactively by client script with complete styling -->
    </main>

    <!-- Educational Guide Card -->
    <section class="comp-guide-card five-education-card" aria-label="Guía de nutrición veterinaria">
      <div class="comp-guide-header">
        <span class="comp-guide-icon">🩺</span>
        <div>
          <h2 class="comp-guide-title">¿Cómo interpretar las etiquetas según el equipo veterinario de FIVE?</h2>
          <p class="comp-guide-desc">Criterios fundamentales para evaluar un alimento comercial sin caer en trucos de marketing.</p>
        </div>
      </div>

      <div class="comp-guide-grid">
        <div class="comp-guide-item">
          <div class="comp-guide-item-num">01</div>
          <h3>La Ley del Primer Ingrediente</h3>
          <p>
            Los ingredientes deben declararse en orden estricto de peso. El primer ítem debe ser <strong>carne fresca deshuesada</strong> o <strong>harina de carne deshidratada pura</strong>, nunca maíz, subproductos no identificados o trigo.
          </p>
        </div>

        <div class="comp-guide-item">
          <div class="comp-guide-item-num">02</div>
          <h3>Grain-Free vs Granos Nobles</h3>
          <p>
            Las fórmulas <strong>Grain-Free</strong> reemplazan el trigo y la soya por legumbres nobles (arvejas, garbanzos) o tubérculos (camote, calabaza), ofreciendo mayor biodisponibilidad y reduciendo problemas dérmicos.
          </p>
        </div>

        <div class="comp-guide-item">
          <div class="comp-guide-item-num">03</div>
          <h3>Densidad Proteica y Grasa</h3>
          <p>
            En perros adultos recomendamos entre un <strong>24% y 30%</strong> de proteína bruta. En gatos (carnívoros estrictos), busca siempre superar el <strong>32% al 44%</strong> con taurina garantizada para su salud cardíaca y ocular.
          </p>
        </div>
      </div>
    </section>
  </div>

  <script>
    import { products, formatMoney } from '../data/pim/catalog';
    import { getProductNutrition, type FoodNutritionProfile } from '../data/pim/nutrition';

    const slot1 = document.querySelector<HTMLSelectElement>('#picker-slot-1')!;
    const slot2 = document.querySelector<HTMLSelectElement>('#picker-slot-2')!;
    const slot3 = document.querySelector<HTMLSelectElement>('#picker-slot-3')!;
    const container = document.querySelector<HTMLElement>('#comparison-table-container')!;
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.comp-tab-btn');
    const brandBadge1 = document.querySelector<HTMLElement>('#slot-1-brand-badge');
    const brandBadge2 = document.querySelector<HTMLElement>('#slot-2-brand-badge');

    // Animal Filter Tabs handler
    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        tabButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        const filter = btn.dataset.filter || 'all';

        [slot1, slot2, slot3].forEach((select) => {
          Array.from(select.options).forEach((opt) => {
            if (!opt.value) return; // keep empty option in slot 3
            const pet = opt.dataset.pet || 'perro';
            if (filter === 'all' || filter === pet) {
              opt.hidden = false;
            } else {
              opt.hidden = true;
            }
          });
        });
      });
    });

    const renderComparison = () => {
      const ids = [slot1.value, slot2.value, slot3.value].filter(Boolean);
      const items = ids.map((id) => {
        const prod = products.find((p) => p.id === id) || products[0];
        const nut: FoodNutritionProfile = getProductNutrition(id, prod);
        const debitPrice = Math.round(prod.price * 1.05);
        const pricePerKg = Math.round(prod.price / (nut.formatWeightKg || 1));
        return { prod, nut, debitPrice, pricePerKg };
      });

      if (!items.length) return;

      // Update slot brand badges
      if (brandBadge1 && items[0]) brandBadge1.textContent = items[0].prod.brand;
      if (brandBadge2 && items[1]) brandBadge2.textContent = items[1].prod.brand;

      // Calculate winners
      const minPricePerKg = Math.min(...items.map((it) => it.pricePerKg));
      const maxProtein = Math.max(...items.map((it) => it.nut.proteinPct));

      const colsCount = items.length;

      let html = `
        <div class="comp-matrix-wrapper cols-${colsCount}">
          <!-- 1. PRODUCT CARDS HERO ROW -->
          <div class="comp-row comp-hero-row">
            <div class="comp-col-label">
              <span class="comp-label-title">Fórmula y Presentación</span>
              <span class="comp-label-desc">Packshot real, marca oficial y formato</span>
            </div>
            ${items.map((item, idx) => `
              <div class="comp-col-data comp-product-hero-card ${idx === 0 ? 'slot-a-col' : idx === 1 ? 'slot-b-col' : 'slot-c-col'}">
                <div class="comp-packshot-wrap">
                  <img 
                    src="${item.prod.image}" 
                    alt="${item.prod.name}" 
                    class="comp-packshot-img" 
                    loading="lazy"
                  />
                  <span class="comp-brand-badge">${item.prod.brand}</span>
                </div>
                
                <h3 class="comp-product-name">${item.prod.name}</h3>
                
                <div class="comp-format-pill">
                  <span>📦 Formato: <strong>${item.prod.format}</strong></span>
                  <span>•</span>
                  <span>${item.nut.pet}</span>
                </div>

                <div class="comp-price-box">
                  <div class="comp-cash-price">
                    <span class="comp-cash-val">${formatMoney(item.prod.price)}</span>
                    <span class="comp-cash-label">Transferencia / Efectivo</span>
                  </div>
                  <div class="comp-debit-price">
                    <span>Tarjeta / Débito (+5%):</span>
                    <strong>${formatMoney(item.debitPrice)}</strong>
                  </div>
                </div>

                <button 
                  type="button" 
                  class="comp-add-cart-btn"
                  data-add="${item.prod.id}"
                  data-name="${item.prod.name}"
                  data-price="${item.prod.price}"
                  data-image="${item.prod.image}"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                  </svg>
                  <span>Agregar al Carro</span>
                </button>
              </div>
            `).join('')}
          </div>

          <!-- 2. COST PER KG ROW -->
          <div class="comp-row">
            <div class="comp-col-label">
              <span class="comp-label-title">Costo por Kilo ($/kg)</span>
              <span class="comp-label-desc">Rendimiento real de tu compra</span>
            </div>
            ${items.map((item) => {
              const isBest = item.pricePerKg === minPricePerKg && items.length > 1;
              return `
                <div class="comp-col-data ${isBest ? 'winner-cell' : ''}">
                  <div class="comp-metric-highlight">
                    <span class="comp-metric-val">${formatMoney(item.pricePerKg)} <small>/ kg</small></span>
                    ${isBest ? `
                      <span class="comp-winner-badge badge-green">
                        ⭐ Mejor Precio x Kilo
                      </span>
                    ` : ''}
                  </div>
                </div>
              `;
            }).join('')}
          </div>

          <!-- 3. CRUDE PROTEIN ROW -->
          <div class="comp-row">
            <div class="comp-col-label">
              <span class="comp-label-title">Proteína Bruta (%)</span>
              <span class="comp-label-desc">Desarrollo muscular y vitalidad</span>
            </div>
            ${items.map((item) => {
              const isMax = item.nut.proteinPct === maxProtein && items.length > 1;
              return `
                <div class="comp-col-data ${isMax ? 'winner-cell' : ''}">
                  <div class="comp-metric-bar-wrap">
                    <div class="comp-metric-num-row">
                      <strong class="comp-val-large color-purple">${item.nut.proteinPct}%</strong>
                      ${isMax ? `<span class="comp-winner-badge badge-purple">👑 Mayor Proteína</span>` : ''}
                    </div>
                    <div class="comp-bar-track">
                      <div class="comp-bar-fill bar-purple" style="width: ${Math.min(item.nut.proteinPct * 2.2, 100)}%;"></div>
                    </div>
                  </div>
                </div>
              `;
            }).join('')}
          </div>

          <!-- 4. CRUDE FAT ROW -->
          <div class="comp-row">
            <div class="comp-col-label">
              <span class="comp-label-title">Grasa Bruta (%)</span>
              <span class="comp-label-desc">Aporte calórico y palatabilidad</span>
            </div>
            ${items.map((item) => `
              <div class="comp-col-data">
                <div class="comp-metric-bar-wrap">
                  <div class="comp-metric-num-row">
                    <strong class="comp-val-large">${item.nut.fatPct}%</strong>
                  </div>
                  <div class="comp-bar-track">
                    <div class="comp-bar-fill bar-amber" style="width: ${Math.min(item.nut.fatPct * 4, 100)}%;"></div>
                  </div>
                </div>
              </div>
            `).join('')}
          </div>

          <!-- 5. GRAIN-FREE ROW -->
          <div class="comp-row">
            <div class="comp-col-label">
              <span class="comp-label-title">Libre de Granos</span>
              <span class="comp-label-desc">Sin trigo, soya ni maíz común</span>
            </div>
            ${items.map((item) => `
              <div class="comp-col-data">
                ${item.nut.grainFree ? `
                  <div class="comp-grain-badge grain-free">
                    <span class="comp-icon-check">✓</span>
                    <div>
                      <strong>100% Grain-Free</strong>
                      <small>Cero granos • Fácil digestión</small>
                    </div>
                  </div>
                ` : `
                  <div class="comp-grain-badge with-grains">
                    <span class="comp-icon-neutral">🌾</span>
                    <div>
                      <strong>Cereales Nobles</strong>
                      <small>Contiene arroz / maíz seleccionado</small>
                    </div>
                  </div>
                `}
              </div>
            `).join('')}
          </div>

          <!-- 6. PRIMARY PROTEIN SOURCE ROW -->
          <div class="comp-row">
            <div class="comp-col-label">
              <span class="comp-label-title">Fuente Proteica Principal</span>
              <span class="comp-label-desc">Primer origen animal en la fórmula</span>
            </div>
            ${items.map((item) => `
              <div class="comp-col-data">
                <div class="comp-protein-source-box">
                  <span class="comp-meat-icon">🥩</span>
                  <span class="comp-protein-source-text">${item.nut.primaryProteinSource}</span>
                </div>
              </div>
            `).join('')}
          </div>

          <!-- 7. FIRST 5 INGREDIENTS ROW -->
          <div class="comp-row comp-ingredients-row">
            <div class="comp-col-label">
              <span class="comp-label-title">Primeros 5 Ingredientes</span>
              <span class="comp-label-desc">Ordenados por mayor porcentaje de peso</span>
            </div>
            ${items.map((item) => `
              <div class="comp-col-data comp-ingredients-data">
                <ol class="comp-ingredients-list">
                  ${item.nut.firstFiveIngredients.map((ing, i) => `
                    <li class="${i === 0 ? 'first-ingredient-item' : ''}">
                      <span class="comp-ing-badge">${i + 1}</span>
                      <span class="comp-ing-text">${ing}</span>
                    </li>
                  `).join('')}
                </ol>
              </div>
            `).join('')}
          </div>

          <!-- 8. KEY ADDITIVES ROW -->
          <div class="comp-row">
            <div class="comp-col-label">
              <span class="comp-label-title">Aditivos Funcionales</span>
              <span class="comp-label-desc">Soporte intestinal y dérmico</span>
            </div>
            ${items.map((item) => `
              <div class="comp-col-data">
                <div class="comp-additives-grid">
                  <div class="comp-additive-chip ${item.nut.hasProbiotics ? 'active' : 'inactive'}">
                    <span>${item.nut.hasProbiotics ? '✓' : '—'}</span>
                    <span>${item.nut.hasProbiotics ? 'Probióticos / MOS activos' : 'Sin probióticos declarados'}</span>
                  </div>
                  <div class="comp-additive-chip ${item.nut.omega3_6 ? 'active' : 'inactive'}">
                    <span>${item.nut.omega3_6 ? '✓' : '—'}</span>
                    <span>${item.nut.omega3_6 ? 'Omega 3 y 6 garantizados' : 'Nivel lipídico base'}</span>
                  </div>
                </div>
              </div>
            `).join('')}
          </div>

          <!-- 9. VET VERDICT & STARS ROW -->
          <div class="comp-row comp-verdict-row">
            <div class="comp-col-label">
              <span class="comp-label-title">Veredicto Nutricional FIVE</span>
              <span class="comp-label-desc">Evaluación veterinaria experta</span>
            </div>
            ${items.map((item) => `
              <div class="comp-col-data comp-verdict-data">
                <div class="comp-verdict-card">
                  <div class="comp-stars-row">
                    <span class="comp-stars">${'★'.repeat(item.nut.qualityRating)}${'☆'.repeat(5 - item.nut.qualityRating)}</span>
                    <span class="comp-rating-label">
                      ${item.nut.qualityRating === 5 ? 'Ultra Premium' : item.nut.qualityRating === 4 ? 'Super Premium' : 'Premium Estándar'}
                    </span>
                  </div>
                  <p class="comp-verdict-text">
                    "${item.nut.recommendationNote}"
                  </p>
                  <div class="comp-caloric-badge">
                    <span>🔥 Densidad calórica:</span>
                    <strong>~${item.nut.caloricDensityKcalKg} kcal/kg</strong>
                  </div>
                </div>
              </div>
            `).join('')}
          </div>
        </div>
      `;

      container.innerHTML = html;

      // Rebind Add to Cart buttons
      container.querySelectorAll<HTMLButtonElement>('.comp-add-cart-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const target = e.currentTarget as HTMLButtonElement;
          const id = target.dataset.add;
          const name = target.dataset.name;
          const price = parseFloat(target.dataset.price || '0');
          const image = target.dataset.image;

          window.dispatchEvent(
            new CustomEvent('five:add-to-cart', {
              detail: { id, name, price, image, qty: 1 },
            })
          );

          const origText = target.innerHTML;
          target.style.background = '#276717';
          target.innerHTML = '✓ ¡Agregado al Carro!';
          setTimeout(() => {
            target.style.background = '';
            target.innerHTML = origText;
          }, 1800);
        });
      });
    };

    // Re-render upon select changes
    slot1.addEventListener('change', renderComparison);
    slot2.addEventListener('change', renderComparison);
    slot3.addEventListener('change', renderComparison);

    // Initial render
    renderComparison();
  </script>
</BaseLayout>

<style is:global>
  /* ==========================================================
     FIVE MASCOTAS — COMPARADOR DE ALIMENTOS REDISEÑADO (GLOBAL)
     ========================================================== */

  .five-comparator-page {
    font-family: inherit;
    color: #1f2937;
  }

  /* Header styles */
  .comp-header {
    margin-bottom: 28px;
  }

  .comp-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #f3e8ff;
    color: #7025a8;
    padding: 5px 14px;
    border-radius: 9999px;
    font-size: 12.5px;
    font-weight: 750;
    margin-bottom: 12px;
  }

  .comp-badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #9333ea;
    box-shadow: 0 0 6px rgba(147, 51, 234, 0.6);
  }

  .comp-title {
    font-size: clamp(26px, 3.8vw, 38px);
    font-weight: 850;
    letter-spacing: -0.9px;
    color: #111827;
    margin: 0 0 8px;
    line-height: 1.2;
  }

  .comp-subtitle {
    font-size: 15px;
    color: #4b5563;
    max-width: 780px;
    line-height: 1.6;
    margin: 0 0 20px;
  }

  /* Filter Tabs */
  .comp-filter-tabs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 14px;
  }

  .comp-tab-btn {
    padding: 8px 16px;
    border-radius: 9999px;
    font-size: 13.5px;
    font-weight: 650;
    border: 1px solid #e5e7eb;
    background: #ffffff;
    color: #4b5563;
    cursor: pointer;
    transition: all 0.15s ease-in-out;
  }

  .comp-tab-btn:hover {
    background: #f9fafb;
    border-color: #d1d5db;
    color: #111827;
  }

  .comp-tab-btn.active {
    background: #7025a8;
    color: #ffffff;
    border-color: #7025a8;
    box-shadow: 0 2px 8px rgba(112, 37, 168, 0.25);
  }

  /* Bento Selector Cards */
  .comp-selectors-bento {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto;
    align-items: center;
    gap: 16px;
    background: #ffffff;
    border: 1px solid #e5dde9;
    border-radius: 20px;
    padding: 22px 24px;
    margin-bottom: 32px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.04);
  }

  @media (max-width: 900px) {
    .comp-selectors-bento {
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 16px;
    }
  }

  .comp-slot-card {
    background: #faf8fb;
    border: 1px solid #ede4f2;
    border-radius: 14px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .comp-slot-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .comp-slot-tag {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 3px 8px;
    border-radius: 6px;
  }

  .comp-slot-tag.tag-a {
    background: #ede9fe;
    color: #6d28d9;
  }

