---
// src/pages/comparador.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { products } from '../data/pim/catalog';
import { defaultFoodNutrition } from '../data/pim/nutrition';

// Filter products that belong to food categories
const foodProducts = products.filter((p) => p.category === 'Alimentos' || defaultFoodNutrition[p.id]);

// Initial 2 items to compare (both Dog Adult by default)
const initialLeft = foodProducts.find((p) => p.brand.includes('Fit') && !p.name.includes('Gato') && !p.name.includes('Cachorro')) || foodProducts[0] || products[0];
const initialRight = foodProducts.find((p) => p.brand.includes('Purina') && !p.name.includes('Gato') && !p.name.includes('Puppy') && p.id !== initialLeft.id) || foodProducts[1] || products[1];

// Helper to determine pet, stage, and breed tags for data attributes
const getPetType = (p: any) => (p.pet === 'Gatos' || p.name.toLowerCase().includes('gato') || p.name.toLowerCase().includes('kitten') || p.name.toLowerCase().includes('cat') ? 'gato' : 'perro');
const getStageType = (p: any) => {
  const n = (p.name || '').toLowerCase();
  if (n.includes('cachorro') || n.includes('puppy') || n.includes('gatito') || n.includes('kitten')) return 'cachorro';
  if (n.includes('senior') || n.includes('mature') || n.includes('edad avanzada')) return 'senior';
  return 'adulto';
};
const getBreedType = (p: any) => {
  const n = (p.name || '').toLowerCase();
  if (n.includes('pequeñ') || n.includes('small') || n.includes('mini') || n.includes('toy')) return 'pequena';
  if (n.includes('grande') || n.includes('maxi') || n.includes('large')) return 'grande';
  return 'todas';
};
---

<BaseLayout
  title="Comparador Nutricional de Alimentos — FIVE Mascotas"
  description="Compara lado a lado el porcentaje de proteína, ingredientes, granos y costo por kilo entre alimentos de la misma categoría para perros y gatos."
>
  <div class="five-wrap five-comparator-page" style="padding-block: 24px 70px;">
    <!-- Breadcrumbs -->
    <nav class="five-breadcrumbs" aria-label="Navegación">
      <ol>
        <li><a href="/">Inicio</a> <span class="five-crumb-separator">/</span></li>
        <li><span aria-current="page">Comparador de Alimentos</span></li>
      </ol>
    </nav>

    <!-- Header Section -->
    <header class="comp-header">
      <div class="comp-badge-pill">
        <span class="comp-badge-dot"></span>
        <span>Análisis Nutricional Objetivo</span>
      </div>
      <h1 class="comp-title">Comparador de Alimentos e Ingredientes</h1>
      <p class="comp-subtitle">
        Compara fórmulas de la <strong>misma categoría y etapa de vida</strong> (adulto con adulto, cachorro con cachorro, gato con gato) para evaluar objetivamente proteína bruta, ingredientes reales y costo por kilo sin sesgos.
      </p>

      <!-- Category & Stage Filter Toolbar -->
      <div class="comp-filter-toolbar">
        <!-- Especie -->
        <div class="comp-filter-group">
          <span class="comp-filter-group-label">Especie:</span>
          <div class="comp-filter-pills" id="pet-filters">
            <button type="button" class="comp-pill-btn active" data-pet="perro">🐶 Perros</button>
            <button type="button" class="comp-pill-btn" data-pet="gato">🐱 Gatos</button>
          </div>
        </div>

        <!-- Etapa de Vida -->
        <div class="comp-filter-group">
          <span class="comp-filter-group-label">Etapa de Vida:</span>
          <div class="comp-filter-pills" id="stage-filters">
            <button type="button" class="comp-pill-btn active" data-stage="adulto">Adultos</button>
            <button type="button" class="comp-pill-btn" data-stage="cachorro">Cachorros / Gatitos</button>
            <button type="button" class="comp-pill-btn" data-stage="senior">Senior (+7 años)</button>
            <button type="button" class="comp-pill-btn" data-stage="all">Todas las etapas</button>
          </div>
        </div>

        <!-- Tamaño de Raza (Solo para perros) -->
        <div class="comp-filter-group" id="breed-group">
          <span class="comp-filter-group-label">Raza:</span>
          <div class="comp-filter-pills" id="breed-filters">
            <button type="button" class="comp-pill-btn active" data-breed="all">Todas las razas</button>
            <button type="button" class="comp-pill-btn" data-breed="pequena">Raza Pequeña (Mini)</button>
            <button type="button" class="comp-pill-btn" data-breed="grande">Raza Grande / Maxi</button>
          </div>
        </div>
      </div>
    </header>

    <!-- Interactive Selectors Bento Card -->
    <section class="comp-selectors-bento" aria-label="Selección de alimentos para comparar">
      <!-- Slot 1 -->
      <div class="comp-slot-card" id="slot-card-1">
        <div class="comp-slot-header">
          <span class="comp-slot-tag tag-a">Alimento 1</span>
          <span class="comp-slot-brand" id="slot-1-brand-badge">{initialLeft.brand}</span>
        </div>
        <div class="comp-slot-picker-wrap">
          <label for="picker-slot-1" class="comp-slot-label">Selecciona el primer producto:</label>
          <select id="picker-slot-1" class="comp-select" aria-label="Alimento 1">
            {foodProducts.map((p) => (
              <option 
                value={p.id} 
                selected={p.id === initialLeft.id}
                data-pet={getPetType(p)}
                data-stage={getStageType(p)}
                data-breed={getBreedType(p)}
              >
                {p.brand} — {p.name} ({p.format})
              </option>
            ))}
          </select>
        </div>
      </div>

      <!-- VS Indicator -->
      <div class="comp-vs-badge" aria-hidden="true">
        <span>VS</span>
      </div>

      <!-- Slot 2 -->
      <div class="comp-slot-card" id="slot-card-2">
        <div class="comp-slot-header">
          <span class="comp-slot-tag tag-b">Alimento 2</span>
          <span class="comp-slot-brand" id="slot-2-brand-badge">{initialRight.brand}</span>
        </div>
        <div class="comp-slot-picker-wrap">
          <label for="picker-slot-2" class="comp-slot-label">Selecciona el segundo producto (Misma categoría):</label>
          <select id="picker-slot-2" class="comp-select" aria-label="Alimento 2">
            {foodProducts.map((p) => (
              <option 
                value={p.id} 
                selected={p.id === initialRight.id}
                data-pet={getPetType(p)}
                data-stage={getStageType(p)}
                data-breed={getBreedType(p)}
              >
                {p.brand} — {p.name} ({p.format})
              </option>
            ))}
          </select>
        </div>
      </div>

      <!-- Slot 3 (Optional) -->
      <div class="comp-slot-card comp-slot-card-optional" id="slot-card-3">
        <div class="comp-slot-header">
          <span class="comp-slot-tag tag-c">Alimento 3</span>
          <span class="comp-slot-subtext">Opcional</span>
        </div>
        <div class="comp-slot-picker-wrap">
          <label for="picker-slot-3" class="comp-slot-label">Agregar 3er alimento (opcional):</label>
          <select id="picker-slot-3" class="comp-select" aria-label="Alimento 3">
            <option value="">-- Ninguno (Comparar 2) --</option>
            {foodProducts.map((p) => (
              <option 
                value={p.id}
                data-pet={getPetType(p)}
                data-stage={getStageType(p)}
                data-breed={getBreedType(p)}
              >
                {p.brand} — {p.name} ({p.format})
              </option>
            ))}
          </select>
        </div>
      </div>
    </section>

    <!-- Comparison Matrix Dynamic Container -->
    <main class="comp-matrix-container" id="comparison-table-container">
      <!-- Injected reactively by client script with complete styling -->
    </main>

    <!-- Educational Guide Card -->
    <section class="comp-guide-card five-education-card" aria-label="Guía de nutrición veterinaria">
      <div class="comp-guide-header">
        <span class="comp-guide-icon">💡</span>
        <div>
          <h2 class="comp-guide-title">¿Cómo evaluar objetivamente la etiqueta de un alimento?</h2>
          <p class="comp-guide-desc">Criterios técnicos para analizar las opciones y decidir la mejor nutrición para tu mascota.</p>
        </div>
      </div>

      <div class="comp-guide-grid">
        <div class="comp-guide-item">
          <div class="comp-guide-item-num">01</div>
          <h3>La Regla del Primer Ingrediente</h3>
          <p>
            Los ingredientes se ordenan por su peso antes de la cocción. Un buen alimento debe tener como primer ingrediente <strong>carne fresca</strong> o <strong>harina de carne deshidratada pura</strong>, evitando que el primer componente sea maíz o trigo.
          </p>
        </div>

        <div class="comp-guide-item">
          <div class="comp-guide-item-num">02</div>
          <h3>Fórmulas Grain-Free vs Cereales</h3>
          <p>
            Las fórmulas <strong>Grain-Free</strong> sustituyen los cereales por legumbres nobles (arvejas, lentejas) o tubérculos (calabaza, camote), ofreciendo un índice glucémico controlado y minimizando alergias alimentarias.
          </p>
        </div>

        <div class="comp-guide-item">
          <div class="comp-guide-item-num">03</div>
          <h3>Proteína y Grasa según Etapa</h3>
          <p>
            Los cachorros en crecimiento y los gatos (carnívoros estrictos) requieren mayores porcentajes de proteína y taurina. En adultos con actividad regular, prioriza una buena digestibilidad y balance de ácidos grasos Omega 3 y 6.
          </p>
        </div>
      </div>
    </section>
  </div>

  <script>
    import { products as defaultProducts, formatMoney } from '../data/pim/catalog';
    import { getProductNutrition, type FoodNutritionProfile } from '../data/pim/nutrition';
    import { AdminStoreService } from '../scripts/admin-store';
    import type { Product } from '../data/pim/types';

    const slot1 = document.querySelector<HTMLSelectElement>('#picker-slot-1')!;
    const slot2 = document.querySelector<HTMLSelectElement>('#picker-slot-2')!;
    const slot3 = document.querySelector<HTMLSelectElement>('#picker-slot-3')!;
    const container = document.querySelector<HTMLElement>('#comparison-table-container')!;
    const brandBadge1 = document.querySelector<HTMLElement>('#slot-1-brand-badge');
    const brandBadge2 = document.querySelector<HTMLElement>('#slot-2-brand-badge');
    const breedGroup = document.querySelector<HTMLElement>('#breed-group');

    // Get live products list from PIM or fallback
    const getLiveProducts = (): Product[] => {
      try {
        const live = AdminStoreService.getProducts();
        if (live && live.length) return live;
      } catch {
        // Fallback
      }
      return defaultProducts;
    };

    // Filter state
    let activePet = 'perro';
    let activeStage = 'adulto';
    let activeBreed = 'all';

    const filterOptions = () => {
      if (breedGroup) {
        breedGroup.style.display = activePet === 'gato' ? 'none' : 'flex';
      }

      [slot1, slot2, slot3].forEach((select) => {
        const validOptions = Array.from(select.options).filter((opt) => opt.value);
        let firstMatch: HTMLOptionElement | undefined = undefined;
        let currentSelectedStillValid = false;

        for (const opt of validOptions) {
          const pet = opt.dataset.pet;
          const stage = opt.dataset.stage;
          const breed = opt.dataset.breed;

          const matchPet = pet === activePet;
          const matchStage = activeStage === 'all' || stage === activeStage;
          const matchBreed = activeBreed === 'all' || breed === activeBreed || breed === 'todas';

          if (matchPet && matchStage && matchBreed) {
            opt.hidden = false;
            if (!firstMatch) firstMatch = opt;
            if (opt.selected) currentSelectedStillValid = true;
          } else {
            opt.hidden = true;
          }
        }

        // If currently selected product no longer matches filter, pick the first valid matching product
        if (!currentSelectedStillValid && firstMatch) {
          firstMatch.selected = true;
        }
      });

      renderComparison();
    };

    // Wire up filter pills
    document.querySelectorAll('#pet-filters .comp-pill-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#pet-filters .comp-pill-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activePet = (btn as HTMLElement).dataset.pet || 'perro';
        filterOptions();
      });
    });

    document.querySelectorAll('#stage-filters .comp-pill-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#stage-filters .comp-pill-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeStage = (btn as HTMLElement).dataset.stage || 'all';
        filterOptions();
      });
    });

    document.querySelectorAll('#breed-filters .comp-pill-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#breed-filters .comp-pill-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeBreed = (btn as HTMLElement).dataset.breed || 'all';
        filterOptions();
      });
    });

    // When Slot 1 is changed, adapt Slot 2 if needed
    slot1.addEventListener('change', () => {
      const selectedOpt = slot1.selectedOptions[0];
      if (selectedOpt && slot2.selectedOptions[0]?.value === slot1.value) {
        // Avoid selecting the exact same product in slot 1 and slot 2
        const nextOpt = Array.from(slot2.options).find((opt) => !opt.hidden && opt.value && opt.value !== slot1.value);
        if (nextOpt) nextOpt.selected = true;
      }
      renderComparison();
    });

    slot2.addEventListener('change', renderComparison);
    slot3.addEventListener('change', renderComparison);

    function renderComparison() {
      const allProds = getLiveProducts();
      const ids = [slot1.value, slot2.value, slot3.value].filter(Boolean);

      const items = ids.map((id) => {
        const prod = allProds.find((p) => p.id === id) || defaultProducts.find((p) => p.id === id) || defaultProducts[0];
        const nut: FoodNutritionProfile = getProductNutrition(id, prod);
        const debitPrice = Math.round(prod.price * 1.05);
        const pricePerKg = Math.round(prod.price / (nut.formatWeightKg || 1));
        return { prod, nut, debitPrice, pricePerKg };
      });

      if (!items.length) return;

      // Update slot brand badges
      if (brandBadge1 && items[0]) brandBadge1.textContent = items[0].prod.brand;
      if (brandBadge2 && items[1]) brandBadge2.textContent = items[1].prod.brand;

      // Calculate winners
      const minPricePerKg = Math.min(...items.map((it) => it.pricePerKg));
      const maxProtein = Math.max(...items.map((it) => it.nut.proteinPct));

      const colsCount = items.length;

      let html = `
        <div class="comp-matrix-wrapper cols-${colsCount}">
          <!-- 1. PRODUCT CARDS HERO ROW -->
          <div class="comp-row comp-hero-row">
            <div class="comp-col-label">
              <span class="comp-label-title">Fórmula y Presentación</span>
              <span class="comp-label-desc">Packshot real, marca oficial y formato</span>
            </div>
            ${items.map((item, idx) => `
              <div class="comp-col-data comp-product-hero-card ${idx === 0 ? 'slot-a-col' : idx === 1 ? 'slot-b-col' : 'slot-c-col'}">
                <div class="comp-packshot-wrap">
                  <img 
                    src="${item.prod.image}" 
                    alt="${item.prod.name}" 
                    class="comp-packshot-img" 
                    loading="lazy"
                  />
                  <span class="comp-brand-badge">${item.prod.brand}</span>
                </div>
                
                <h3 class="comp-product-name">${item.prod.name}</h3>
                
                <div class="comp-format-pill">
                  <span>📦 Formato: <strong>${item.prod.format}</strong></span>
                  <span>•</span>
                  <span>${item.nut.pet}</span>
                </div>

                <div class="comp-price-box">
                  <div class="comp-cash-price">
                    <span class="comp-cash-val">${formatMoney(item.prod.price)}</span>
                    <span class="comp-cash-label">Transferencia / Efectivo</span>
                  </div>
                  <div class="comp-debit-price">
                    <span>Tarjeta / Débito (+5%):</span>
                    <strong>${formatMoney(item.debitPrice)}</strong>
                  </div>
                </div>

                <button 
                  type="button" 
                  class="comp-add-cart-btn"
                  data-add="${item.prod.id}"
                  data-name="${item.prod.name}"
                  data-price="${item.prod.price}"
                  data-image="${item.prod.image}"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                  </svg>
                  <span>Agregar al Carro</span>
                </button>
                ${item.prod.originUrl ? `
                  <a 
                    href="${item.prod.originUrl}" 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="comp-origin-link" 
                    style="display:block; text-align:center; font-size:11.5px; color:#7025a8; text-decoration:none; margin-top:8px; font-weight:700;"
                  >
                    🌐 Ficha Oficial del Fabricante ↗
                  </a>
                ` : ''}
              </div>
            `).join('')}
          </div>

          <!-- 2. COST PER KG ROW -->
          <div class="comp-row">
            <div class="comp-col-label">
              <span class="comp-label-title">Costo por Kilo ($/kg)</span>
              <span class="comp-label-desc">Rendimiento real de tu compra</span>
            </div>
            ${items.map((item) => {
              const isBest = item.pricePerKg === minPricePerKg && items.length > 1;
              return `
                <div class="comp-col-data ${isBest ? 'winner-cell' : ''}">
                  <div class="comp-metric-highlight">
                    <span class="comp-metric-val">${formatMoney(item.pricePerKg)} <small>/ kg</small></span>
                    ${isBest ? `
                      <span class="comp-winner-badge badge-green">
                        ⭐ Mejor Precio x Kilo
                      </span>
                    ` : ''}
                  </div>
                </div>
              `;
            }).join('')}
          </div>

          <!-- 3. CRUDE PROTEIN ROW -->
          <div class="comp-row">
            <div class="comp-col-label">
              <span class="comp-label-title">Proteína Bruta (%)</span>
              <span class="comp-label-desc">Desarrollo muscular y vitalidad</span>
            </div>
            ${items.map((item) => {
              const isMax = item.nut.proteinPct === maxProtein && items.length > 1;
              return `
                <div class="comp-col-data ${isMax ? 'winner-cell' : ''}">
                  <div class="comp-metric-bar-wrap">
                    <div class="comp-metric-num-row">
                      <strong class="comp-val-large color-purple">${item.nut.proteinPct}%</strong>
                      ${isMax ? `<span class="comp-winner-badge badge-purple">👑 Mayor Proteína</span>` : ''}
                    </div>
                    <div class="comp-bar-track">
                      <div class="comp-bar-fill bar-purple" style="width: ${Math.min(item.nut.proteinPct * 2.2, 100)}%;"></div>
                    </div>
                  </div>
                </div>
              `;
            }).join('')}
          </div>

          <!-- 4. CRUDE FAT ROW -->
          <div class="comp-row">
            <div class="comp-col-label">
              <span class="comp-label-title">Grasa Bruta (%)</span>
              <span class="comp-label-desc">Aporte calórico y palatabilidad</span>
            </div>
            ${items.map((item) => `
              <div class="comp-col-data">
                <div class="comp-metric-bar-wrap">
                  <div class="comp-metric-num-row">
                    <strong class="comp-val-large">${item.nut.fatPct}%</strong>
                  </div>
                  <div class="comp-bar-track">
                    <div class="comp-bar-fill bar-amber" style="width: ${Math.min(item.nut.fatPct * 4, 100)}%;"></div>
                  </div>
                </div>
              </div>
            `).join('')}
          </div>

          <!-- 5. GRAIN-FREE ROW -->
          <div class="comp-row">
            <div class="comp-col-label">
              <span class="comp-label-title">Libre de Granos</span>
              <span class="comp-label-desc">Sin trigo, soya ni maíz común</span>
            </div>
            ${items.map((item) => `
              <div class="comp-col-data">
                ${item.nut.grainFree ? `
                  <div class="comp-grain-badge grain-free">
                    <span class="comp-icon-check">✓</span>
                    <div>
                      <strong>100% Grain-Free</strong>
                      <small>Cero granos • Fácil digestión</small>
                    </div>
                  </div>
                ` : `
                  <div class="comp-grain-badge with-grains">
                    <span class="comp-icon-neutral">🌾</span>
                    <div>
                      <strong>Cereales Nobles</strong>
                      <small>Contiene arroz / maíz seleccionado</small>
                    </div>
                  </div>
                `}
              </div>
            `).join('')}
          </div>

          <!-- 6. PRIMARY PROTEIN SOURCE ROW -->
          <div class="comp-row">
            <div class="comp-col-label">
              <span class="comp-label-title">Fuente Proteica Principal</span>
              <span class="comp-label-desc">Primer origen animal en la fórmula</span>
            </div>
            ${items.map((item) => `
              <div class="comp-col-data">
                <div class="comp-protein-source-box">
                  <span class="comp-meat-icon">🥩</span>
                  <span class="comp-protein-source-text">${item.nut.primaryProteinSource}</span>
                </div>
              </div>
            `).join('')}
          </div>

          <!-- 7. FIRST 5 INGREDIENTS ROW -->
          <div class="comp-row comp-ingredients-row">
            <div class="comp-col-label">
              <span class="comp-label-title">Primeros 5 Ingredientes</span>
              <span class="comp-label-desc">Ordenados por mayor porcentaje de peso</span>
            </div>
            ${items.map((item) => `
              <div class="comp-col-data comp-ingredients-data">
                <ol class="comp-ingredients-list">
                  ${item.nut.firstFiveIngredients.map((ing, i) => `
                    <li class="${i === 0 ? 'first-ingredient-item' : ''}">
                      <span class="comp-ing-badge">${i + 1}</span>
                      <span class="comp-ing-text">${ing}</span>
                    </li>
                  `).join('')}
                </ol>
              </div>
            `).join('')}
          </div>

          <!-- 8. KEY ADDITIVES ROW -->
          <div class="comp-row">
            <div class="comp-col-label">
              <span class="comp-label-title">Aditivos Funcionales</span>
              <span class="comp-label-desc">Soporte intestinal y dérmico</span>
            </div>
            ${items.map((item) => `
              <div class="comp-col-data">
                <div class="comp-additives-grid">
                  <div class="comp-additive-chip ${item.nut.hasProbiotics ? 'active' : 'inactive'}">
                    <span>${item.nut.hasProbiotics ? '✓' : '—'}</span>
                    <span>${item.nut.hasProbiotics ? 'Probióticos / MOS activos' : 'Sin probióticos declarados'}</span>
                  </div>
                  <div class="comp-additive-chip ${item.nut.omega3_6 ? 'active' : 'inactive'}">
                    <span>${item.nut.omega3_6 ? '✓' : '—'}</span>
                    <span>${item.nut.omega3_6 ? 'Omega 3 y 6 garantizados' : 'Nivel lipídico base'}</span>
                  </div>
                </div>
              </div>
            `).join('')}
          </div>

          <!-- 9. ENERGY & FIBER METRICS ROW (OBJECTIVE DATA ONLY, NO SUBJECTIVE VERDICT) -->
          <div class="comp-row">
            <div class="comp-col-label">
              <span class="comp-label-title">Energía y Fibra</span>
              <span class="comp-label-desc">Aporte calórico estimado y digestibilidad</span>
            </div>
            ${items.map((item) => `
              <div class="comp-col-data">
                <div style="display:flex; flex-direction:column; gap:8px;">
                  <div style="background:#faf8fb; border:1px solid #ede4f2; border-radius:10px; padding:10px 14px;">
                    <span style="font-size:11.5px; color:#6b7280; display:block;">🔥 Densidad Calórica:</span>
                    <strong style="font-size:15px; color:#7025a8;">~${item.nut.caloricDensityKcalKg} kcal/kg</strong>
                  </div>
                  <div style="display:flex; gap:10px; font-size:12px; color:#4b5563;">
                    <span>🌾 Fibra Máx: <strong>${item.nut.fiberPct}%</strong></span>
                    <span>•</span>
                    <span>💧 Humedad Máx: <strong>${item.nut.moisturePct}%</strong></span>
                  </div>
                </div>
              </div>
            `).join('')}
          </div>
        </div>
      `;

      container.innerHTML = html;

      // Rebind Add to Cart buttons
      container.querySelectorAll<HTMLButtonElement>('.comp-add-cart-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const target = e.currentTarget as HTMLButtonElement;
          const id = target.dataset.add;
          const name = target.dataset.name;
          const price = parseFloat(target.dataset.price || '0');
          const image = target.dataset.image;

          window.dispatchEvent(
            new CustomEvent('five:add-to-cart', {
              detail: { id, name, price, image, qty: 1 },
            })
          );

          const origText = target.innerHTML;
          target.style.background = '#276717';
          target.innerHTML = '✓ ¡Agregado al Carro!';
          setTimeout(() => {
            target.style.background = '';
            target.innerHTML = origText;
          }, 1800);
        });
      });
    }

    // Filter and run
    filterOptions();
  </script>
</BaseLayout>

