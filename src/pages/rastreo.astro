---
// src/pages/rastreo.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Seguimiento de Pedido — FIVE Mascotas"
  description="Ingresa tu código de seguimiento oficial (ej: FIVE-TRK-XXXX) o tu número de teléfono para revisar el estado en vivo de tu compra y despacho."
>
  <div class="five-wrap" style="padding-block: 30px 70px;">
    <!-- Breadcrumbs -->
    <nav class="five-breadcrumbs" aria-label="Navegación">
      <ol>
        <li><a href="/">Inicio</a> <span class="five-crumb-separator">/</span></li>
        <li><span aria-current="page">Rastreo de Pedido</span></li>
      </ol>
    </nav>

    <div style="max-width:720px; margin:0 auto;">
      <!-- Title & Search Hero -->
      <div style="text-align:center; margin-bottom:28px;">
        <div style="display:flex; justify-content:center; margin-bottom:10px;"><div style="width:54px; height:54px; border-radius:50%; background:#f3e8ff; display:flex; align-items:center; justify-content:center;"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#7025A8" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg></div></div>
        <h1 style="font-size:clamp(24px, 4vw, 32px); font-weight:850; letter-spacing:-0.8px; margin:0 0 8px;">
          Rastrea tu Pedido en Vivo
        </h1>
        <p style="color:#6b7280; font-size:14.5px; margin:0;">
          Revisa el estado de confirmación de tu transferencia y el progreso de preparación o reparto a tu domicilio.
        </p>
      </div>

      <!-- Search Box Card -->
      <div class="five-track-search-card">
        <form id="track-search-form" style="display:flex; gap:10px;">
          <input
            type="text"
            id="track-input"
            class="five-input"
            placeholder="Ingresa tu código de rastreo (ej: FIVE-TRK-8492) o teléfono"
            required
            style="font-size:14px; padding:12px 16px; border-radius:12px;"
          />
          <button type="submit" class="five-button" style="padding:12px 24px; border-radius:12px; font-weight:800; white-space:nowrap;">
            Buscar
          </button>
        </form>
      </div>

      <!-- Order Result Box (Hidden by default) -->
      <div id="track-result-box" class="five-track-result-box" hidden>
        <!-- Injected via script -->
      </div>

      <!-- Empty / Not Found Message -->
      <div id="track-empty-box" class="five-empty-state" hidden style="margin-top:24px; padding:32px; background:#faf8fb; border:1px solid #e5dde9; border-radius:16px;">
        <div style="display:flex; justify-content:center; margin-bottom:12px;"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.8"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></div>
        <h3 style="font-size:16px; font-weight:800; color:#111827;">No encontramos pedidos con ese código</h3>
        <p style="font-size:13px; color:#6b7280; max-width:440px; margin:4px auto 14px;">
          Verifica que el código esté bien escrito (incluyendo <code>FIVE-TRK-</code>) o contáctanos por WhatsApp para asistirte de inmediato.
        </p>
        <a href="https://wa.me/56964183605" target="_blank" rel="noopener noreferrer" class="five-button" style="background:#25d366; color:#ffffff; font-size:13px; padding:8px 18px;">
          Consultar por WhatsApp ↗
        </a>
      </div>
    </div>
  </div>

  <script>
    import { AdminStoreService } from '../scripts/admin-store';
    import { formatMoney } from '../data/pim/catalog';

    const form = document.querySelector<HTMLFormElement>('#track-search-form')!;
    const input = document.querySelector<HTMLInputElement>('#track-input')!;
    const resultBox = document.querySelector<HTMLElement>('#track-result-box')!;
    const emptyBox = document.querySelector<HTMLElement>('#track-empty-box')!;

    // Status definitions
    const statuses = [
      { key: 'Recibido', label: '1. Pedido Recibido', desc: 'Esperando validación de transferencia' },
      { key: 'Pago Confirmado', label: '2. Pago Confirmado', desc: 'Transferencia verificada con éxito' },
      { key: 'En Reparto', label: '3. En Reparto / Despacho', desc: 'En ruta a tu domicilio' },
      { key: 'Entregado', label: '4. Entregado', desc: 'Entregado a entera satisfacción' },
    ];

    const getStatusIndex = (current: string) => {
      if (current === 'Pago Confirmado') return 1;
      if (current === 'En Reparto') return 2;
      if (current === 'Entregado') return 3;
      return 0; // Recibido
    };

    const doSearch = async (query: string) => {
      const q = query.trim();
      if (!q) return;

      emptyBox.hidden = true;
      resultBox.hidden = false;
      resultBox.innerHTML = `
        <div style="text-align:center; padding:32px; color:#7025a8; font-weight:700;">
          <div class="rayo-verdict-spinner" style="width:28px; height:28px; border:3px solid #f3e8ff; border-top-color:#7025a8; border-radius:50%; margin:0 auto; animation:spin 0.8s linear infinite;"></div>
          <p style="margin:8px 0 0; font-size:14px;">Buscando estado en tiempo real...</p>
        </div>
      `;

      let order = AdminStoreService.getOrderByCode(q);

      // Async live lookup from server
      try {
        const res = await fetch(`/api/orders?code=${encodeURIComponent(q)}`);
        if (res.ok) {
          const json = await res.json();
          if (json?.ok && json.order) {
            order = json.order;
            // Cache to local store
            AdminStoreService.saveOrder(order);
          }
        }
      } catch {
        // Fallback to locally cached order
      }

      if (!order) {
        resultBox.hidden = true;
        emptyBox.hidden = false;
        return;
      }

      emptyBox.hidden = true;
      resultBox.hidden = false;

      const currentIndex = getStatusIndex(order.status || 'Recibido');
      const isPendingPayment = !order.status || order.status === 'Recibido';
      const transferTotal = order.totalTransfer || order.total || 0;

      let timelineHtml = `
        <div class="five-track-timeline">
          ${statuses.map((st, idx) => {
            const isDone = idx < currentIndex;
            const isCurrent = idx === currentIndex;
            return `
              <div class="five-timeline-step ${isDone ? 'is-done' : ''} ${isCurrent ? 'is-current' : ''}">
                <div class="five-timeline-node">
                  ${isDone ? '✓' : idx + 1}
                </div>
                <div class="five-timeline-content">
                  <strong>${st.label}</strong>
                  <small>${st.desc}</small>
                </div>
              </div>
            `;
          }).join('')}
        </div>
      `;

      let itemsHtml = (order.items || []).map((it: any) => `
        <div style="display:flex; justify-content:space-between; font-size:13px; padding-block:5px; border-bottom:1px solid #f3f4f6;">
          <span><strong>${it.quantity}x</strong> ${it.name}</span>
          <strong style="color:#111827;">${formatMoney(it.price * it.quantity)}</strong>
        </div>
      `).join('');

      const badgeColor = order.status === 'Entregado' ? 'green' : order.status === 'En Reparto' ? 'blue' : order.status === 'Pago Confirmado' ? 'violet' : 'amber';

      const waProofMsg = encodeURIComponent(
        `Hola FIVE Mascotas, adjunto el comprobante de transferencia para mi pedido ${order.code} por ${formatMoney(transferTotal)}. Destinatario: ${order.customerName}.`
      );

      resultBox.innerHTML = `
        <div class="five-order-card-view">
          <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:10px; margin-bottom:16px; border-bottom:1px solid #e5dde9; padding-bottom:14px;">
            <div>
              <span style="font-size:11px; text-transform:uppercase; color:#6b7280; font-weight:750; letter-spacing:0.3px;">Código de Seguimiento Oficial</span>
              <div style="display:flex; align-items:center; gap:8px; margin-top:2px;">
                <strong style="font-size:22px; color:#7025a8; font-family:ui-monospace, monospace;">${order.code}</strong>
                <button type="button" class="five-copy-track-btn" data-track="${order.code}">Copiar</button>
              </div>
              <small style="color:#6b7280; display:block; margin-top:4px;">
                Fecha: ${new Date(order.createdAt || Date.now()).toLocaleDateString('es-CL', { day:'numeric', month:'long', year:'numeric', hour:'2-digit', minute:'2-digit' })}
              </small>
            </div>
            <span class="five-badge-pill ${badgeColor}" style="font-size:12px; font-weight:750;">
              ● ${order.status || 'Recibido'}
            </span>
          </div>

          <!-- Pending Transfer Notice if needed -->
          ${isPendingPayment ? `
            <div style="background:#fffbeb; border:1px solid #fef3c7; border-radius:12px; padding:12px 16px; margin-bottom:18px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
              <div>
                <strong style="color:#92400e; font-size:13px; display:block;">Esperando comprobante de transferencia</strong>
                <span style="color:#b45309; font-size:12px;">Transfiere ${formatMoney(transferTotal)} a BancoEstado Cta Corriente 000-1234567-89</span>
              </div>
              <a href="https://wa.me/56964183605?text=${waProofMsg}" target="_blank" rel="noopener noreferrer" class="five-button" style="background:#25d366; font-size:12px; padding:6px 14px;">
                Enviar Comprobante WhatsApp
              </a>
            </div>
          ` : ''}

          <!-- Timeline -->
          <h4 style="font-size:14px; font-weight:800; margin-bottom:12px; color:#111827;">Progreso de tu Envío:</h4>
          ${timelineHtml}

          <!-- Delivery & Client Info -->
          <div style="margin-top:20px; display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:16px; background:#fdfcff; border:1px solid #ebdcf5; border-radius:12px; padding:14px; font-size:12.5px;">
            <div>
              <span style="color:#6b7280; display:block;">Destinatario:</span>
              <strong style="font-size:13.5px; color:#111827;">${order.customerName}</strong>
              <span style="color:#6b7280; display:block; margin-top:6px;">Teléfono de Contacto:</span>
              <strong style="color:#111827;">${order.phone}</strong>
            </div>
            <div>
              <span style="color:#6b7280; display:block;">Dirección de Entrega:</span>
              <strong style="font-size:13.5px; color:#111827;">${order.address}</strong>
              <small style="display:block; color:#7025a8; font-weight:750; margin-top:3px;">Comuna: ${order.city}</small>
            </div>
          </div>

          <!-- Items Breakdown -->
          <div style="margin-top:18px;">
            <h4 style="font-size:13.5px; font-weight:800; margin-bottom:8px; color:#111827;">Detalle de Productos:</h4>
            ${itemsHtml}
            <div style="display:flex; justify-content:space-between; font-size:13px; margin-top:8px; color:#4b5563;">
              <span>Costo Despacho (${order.city}):</span>
              <strong style="color:#7025a8;">${formatMoney(order.shippingFee || 1500)}</strong>
            </div>
            <div style="display:flex; justify-content:space-between; font-size:16px; margin-top:8px; border-top:1px dashed #e5dde9; padding-top:10px;">
              <strong style="color:#111827;">Total de la Compra:</strong>
              <strong style="color:#276717; font-size:18px;">${formatMoney(transferTotal)}</strong>
            </div>
          </div>

          <!-- WhatsApp contact for assistance -->
          <div style="margin-top:22px; text-align:center; padding-top:16px; border-top:1px solid #f3f4f6;">
            <a href="https://wa.me/56964183605?text=Hola%20tengo%20una%20consulta%20sobre%20mi%20pedido%20${order.code}" target="_blank" rel="noopener noreferrer" class="five-button" style="background:#25d366; color:#ffffff; font-size:13px; padding:10px 22px;">
              Hablar con Soporte de Despacho
            </a>
          </div>
        </div>
      `;
    };

    // Delegated copy button
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.five-copy-track-btn');
      if (btn) {
        const code = btn.getAttribute('data-track') || '';
        if (code) {
          navigator.clipboard.writeText(code).then(() => {
            const orig = btn.textContent;
            btn.textContent = '✓ Copiado';
            btn.style.color = '#276717';
            setTimeout(() => {
              btn.textContent = orig;
              btn.style.color = '';
            }, 2000);
          }).catch(() => {});
        }
      }
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      doSearch(input.value);
    });

    // Auto-search if query param present in URL
    const urlParams = new URLSearchParams(window.location.search);
    const codeParam = urlParams.get('codigo') || urlParams.get('code');
    if (codeParam) {
      input.value = codeParam;
      doSearch(codeParam);
    }
  </script>
</BaseLayout>

<style>
  .five-track-search-card {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: 18px;
    padding: 20px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .five-order-card-view {
    margin-top: 24px;
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: 20px;
    padding: 24px;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.05);
  }

  .five-track-timeline {
    display: flex;
    flex-direction: column;
    gap: 16px;
    position: relative;
    padding-left: 12px;
  }

  .five-track-timeline::before {
    content: '';
    position: absolute;
    left: 23px;
    top: 14px;
    bottom: 24px;
    width: 2px;
    background: #e5e7eb;
    z-index: 1;
  }

  .five-timeline-step {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    position: relative;
    z-index: 2;
  }

  .five-timeline-node {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #e5e7eb;
    color: #6b7280;
    font-size: 11px;
    font-weight: 850;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #ffffff;
  }

  .five-timeline-step.is-done .five-timeline-node {
    background: #276717;
    color: #ffffff;
  }

  .five-timeline-step.is-current .five-timeline-node {
    background: #7025a8;
    color: #ffffff;
    box-shadow: 0 0 0 4px rgba(112, 37, 168, 0.2);
  }

  .five-timeline-content strong {
    font-size: 13.5px;
    display: block;
    color: #111827;
  }

  .five-timeline-content small {
    font-size: 11.5px;
    color: #6b7280;
  }

  .five-timeline-step.is-current .five-timeline-content strong {
    color: #7025a8;
  }

  .five-copy-track-btn {
    background: #faf5ff;
    border: 1px solid #e9d5ff;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11.5px;
    font-weight: 700;
    color: #7025a8;
    cursor: pointer;
    transition: all 0.12s;
  }

  .five-copy-track-btn:hover {
    background: #f3e8ff;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>
