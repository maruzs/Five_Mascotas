---
// src/pages/mi-cuenta.astro
// Portal Unificado de Usuario: Inicio de Sesión, Registro, Historial de Pedidos y Acceso de Administradores
import BaseLayout from '../layouts/BaseLayout.astro';
import { defaultShippingRates } from '../data/pim/shipping';
import { formatMoney } from '../data/pim/catalog';
---

<BaseLayout
  title="Mi Cuenta — FIVE Mascotas"
  description="Inicia sesión o regístrate en FIVE Mascotas para revisar tus compras anteriores, estado de pedidos activos y datos de entrega guardados."
>
  <div class="five-wrap" style="padding-block: 30px 70px;">
    <!-- Breadcrumbs -->
    <nav class="five-breadcrumbs" aria-label="Navegación">
      <ol>
        <li><a href="/">Inicio</a> <span class="five-crumb-separator">/</span></li>
        <li><span aria-current="page">Mi Cuenta</span></li>
      </ol>
    </nav>

    <!-- 1. AUTHENTICATED STATE VIEW (Client or Admin Portal) -->
    <div id="auth-portal-view" hidden style="max-width:860px; margin:0 auto;">
      <div class="five-account-header-card">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
          <div style="display:flex; align-items:center; gap:16px;">
            <div class="five-avatar-circle" style="display:flex; align-items:center; justify-content:center;"><svg width="24" height="24" viewBox="0 0 24 24" fill="#7025A8" stroke="#7025A8"><circle cx="7" cy="8" r="2"></circle><circle cx="17" cy="8" r="2"></circle><circle cx="12" cy="5" r="2"></circle><path d="M12 10c-3 0-5 2-5 5.5 0 2 2 3.5 5 3.5s5-1.5 5-3.5C17 12 15 10 12 10Z"></path></svg></div>
            <div>
              <span id="portal-role-tag" class="five-pdp-brand-tag" style="font-size:11px; color:#7025a8;">Cliente FIVE</span>
              <h1 id="portal-user-name" style="font-size:24px; font-weight:850; margin:4px 0 2px; color:#111827;">Hola, Usuario</h1>
              <span id="portal-user-email" style="font-size:13px; color:#6b7280;">usuario@correo.cl</span>
            </div>
          </div>

          <div style="display:flex; gap:10px;">
            <a href="/admin" id="portal-admin-link" class="five-button" style="background:#7025a8; font-size:13px; padding:10px 18px;" hidden>
              Ir al Panel Admin
            </a>
            <button type="button" id="portal-logout-btn" class="five-card-add-btn" style="background:#f3f4f6; color:#374151; font-size:13px; padding:10px 16px;">
              Cerrar Sesión ⎋
            </button>
          </div>
        </div>
      </div>

      <!-- Navigation Tabs: Mis Pedidos vs Mi Dirección -->
      <div class="five-portal-tabs-nav" role="tablist">
        <button type="button" id="tab-portal-orders" class="five-portal-nav-btn is-active">
          <span style="display:inline-flex; vertical-align:-2px; margin-right:4px;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg></span> Mis Pedidos y Seguimiento
        </button>
        <button type="button" id="tab-portal-profile" class="five-portal-nav-btn">
          <span style="display:inline-flex; vertical-align:-2px; margin-right:4px;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg></span> Mi Dirección de Despacho y Contacto
        </button>
      </div>

      <!-- Tab Content 1: Orders and Tracking -->
      <div id="portal-tab-pane-orders">
        <!-- Customer KPIs / Summary Row -->
        <div class="five-portal-kpis-grid" style="margin-top:20px;">
          <div class="five-portal-kpi-card">
            <span class="five-kpi-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#7025A8" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg></span>
            <div class="five-kpi-info">
              <span class="five-kpi-label">Pedidos Realizados</span>
              <strong id="kpi-orders-count" class="five-kpi-value">0</strong>
            </div>
          </div>

          <div class="five-portal-kpi-card">
            <span class="five-kpi-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#7025A8" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg></span>
            <div class="five-kpi-info">
              <span class="five-kpi-label">En Curso / Reparto</span>
              <strong id="kpi-orders-active" class="five-kpi-value" style="color:#7025a8;">0</strong>
            </div>
          </div>

          <div class="five-portal-kpi-card">
            <span class="five-kpi-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#276717" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg></span>
            <div class="five-kpi-info">
              <span class="five-kpi-label">Ahorro Transferencia</span>
              <strong id="kpi-orders-savings" class="five-kpi-value" style="color:#276717;">$0</strong>
            </div>
          </div>
        </div>

        <!-- Link Guest Order Box -->
        <div class="five-link-order-card" style="margin-top:20px;">
          <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#7025A8" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
            <h3 style="font-size:14px; font-weight:800; margin:0; color:#111827;">¿Realizaste una compra como invitado?</h3>
          </div>
          <p style="font-size:12.5px; color:#6b7280; margin:0 0 10px;">
            Ingresa tu código de seguimiento oficial (ej: <code>FIVE-TRK-8492</code>) para vincularlo a tu historial permanente.
          </p>
          <form id="form-link-order" style="display:flex; gap:8px; flex-wrap:wrap;">
            <input
              type="text"
              id="link-order-input"
              class="five-input"
              placeholder="FIVE-TRK-XXXX"
              style="flex:1; min-width:200px; text-transform:uppercase; font-family:monospace; padding:8px 12px; font-size:13px;"
              required
            />
            <button type="submit" class="five-button" style="padding:8px 18px; font-size:13px;">
              Vincular Pedido
            </button>
          </form>
          <div id="link-order-alert" style="font-size:12px; margin-top:8px; display:none;"></div>
        </div>

        <!-- Customer Orders Section with Status Filter -->
        <div style="margin-top:28px;">
          <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-bottom:14px;">
            <h2 style="font-size:18px; font-weight:850; margin:0; color:#111827; display:flex; align-items:center; gap:8px;">
              <span style="display:inline-flex; vertical-align:-2px; margin-right:4px;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#7025A8" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg></span> Mis Pedidos y Compras Recientes
            </h2>

            <!-- Filter Pills -->
            <div class="five-orders-filter-bar" role="tablist">
              <button type="button" class="five-order-filter-pill is-active" data-order-filter="all">Todos</button>
              <button type="button" class="five-order-filter-pill" data-order-filter="active">En Curso</button>
              <button type="button" class="five-order-filter-pill" data-order-filter="delivered">Entregados</button>
            </div>
          </div>

          <div id="portal-orders-list" class="five-portal-orders-list">
            <!-- Dynamically populated or empty message -->
          </div>
        </div>
      </div>

      <!-- Tab Content 2: Profile & Shipping Address -->
      <div id="portal-tab-pane-profile" hidden style="margin-top:20px;">
        <div class="five-portal-profile-card">
          <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px; border-bottom:1px solid #f3f4f6; padding-bottom:14px;">
            <div style="width:44px; height:44px; border-radius:12px; background:#faf5ff; display:flex; align-items:center; justify-content:center;"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#7025A8" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg></div>
            <div>
              <h2 style="font-size:17px; font-weight:850; margin:0; color:#111827;">Dirección de Despacho y Contacto Habitual</h2>
              <p style="font-size:12.5px; color:#6b7280; margin:2px 0 0;">
                Tus compras en FIVE Mascotas se auto-completarán con estos datos en el Checkout para una entrega más rápida.
              </p>
            </div>
          </div>

          <form id="form-update-profile" style="display:flex; flex-direction:column; gap:14px;">
            <div class="five-form-grid-2">
              <div class="five-form-group">
                <label for="prof-name" class="five-label">Nombre y Apellido *</label>
                <input type="text" id="prof-name" class="five-input" required placeholder="ej: Valentina Rojas" />
              </div>
              <div class="five-form-group">
                <label for="prof-phone" class="five-label">Teléfono WhatsApp de Contacto *</label>
                <input type="tel" id="prof-phone" class="five-input" required placeholder="+56 9 1234 5678" />
              </div>
            </div>

            <div class="five-form-grid-2">
              <div class="five-form-group">
                <label for="prof-email" class="five-label">Correo Electrónico (Cuenta)</label>
                <input type="email" id="prof-email" class="five-input" disabled style="background:#f9fafb; color:#6b7280; cursor:not-allowed;" />
              </div>
              <div class="five-form-group">
                <label for="prof-city" class="five-label">Comuna / Sector de Despacho *</label>
                <select id="prof-city" class="five-select" style="width:100%; border:1.5px solid #d1d5db; border-radius:12px; padding:12px 14px; font-size:14px; outline:none; background:#ffffff;" required>
                  {defaultShippingRates.map((r) => (
                    <option value={r.city}>
                      {r.city} — {formatMoney(r.price)}
                    </option>
                  ))}
                </select>
              </div>
            </div>

            <div class="five-form-group">
              <label for="prof-address" class="five-label">Dirección Exacta (Calle, Número, Depto/Casa) *</label>
              <input type="text" id="prof-address" class="five-input" required placeholder="ej: Av. San Miguel 3420, Dpto 402" />
            </div>

            <div class="five-form-group">
              <label for="prof-notes" class="five-label">Instrucciones o Referencias de Entrega para el Repartidor</label>
              <textarea id="prof-notes" class="five-textarea" rows="2" style="border:1.5px solid #d1d5db; border-radius:12px; padding:10px 14px; font-size:13.5px; width:100%; box-sizing:border-box; outline:none;" placeholder="ej: Portón negro, tocar timbre o dejar en conserjería si no responde"></textarea>
            </div>

            <div id="prof-save-alert" style="display:none; padding:12px 16px; border-radius:10px; font-size:13px; font-weight:700;"></div>

            <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:6px;">
              <button type="submit" id="prof-save-btn" class="five-button" style="padding:11px 24px; font-size:13.5px;">
                Guardar Datos de Despacho
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- 2. GUEST LOGIN / REGISTER TABS (When not logged in) -->
    <div id="auth-guest-view" style="max-width:480px; margin:0 auto;">
      <div class="five-auth-card">
        <!-- Brand Header -->
        <div style="text-align:center; margin-bottom:20px;">
          <div style="display:flex; justify-content:center; margin-bottom:8px;"><div style="width:48px; height:48px; border-radius:50%; background:#f3e8ff; display:flex; align-items:center; justify-content:center;"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#7025A8" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg></div></div>
          <h1 style="font-size:24px; font-weight:850; margin:8px 0 4px; color:#111827;">Acceso a tu Cuenta</h1>
          <p style="color:#6b7280; font-size:13px; margin:0;">
            Ingresa a tu cuenta de cliente o al panel de administración de FIVE Mascotas.
          </p>
        </div>

        <!-- Tab Switcher (Iniciar Sesión vs Crear Cuenta) -->
        <div class="five-auth-tabs">
          <button type="button" id="tab-btn-login" class="five-auth-tab is-active">Iniciar Sesión</button>
          <button type="button" id="tab-btn-register" class="five-auth-tab">Crear Cuenta</button>
        </div>

        <!-- Alert messages -->
        <div id="auth-alert" class="five-cart-notice" hidden style="margin-bottom:14px;"></div>

        <!-- Form 1: Iniciar Sesión -->
        <form id="form-login" class="five-auth-form">
          <div class="five-form-group">
            <label for="login-email" class="five-label">Correo Electrónico *</label>
            <input type="email" id="login-email" class="five-input" required placeholder="tu@correo.cl" autocomplete="username" />
          </div>

          <div class="five-form-group">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <label for="login-pass" class="five-label">Contraseña *</label>
            </div>
            <input type="password" id="login-pass" class="five-input" required placeholder="Tu contraseña segura" autocomplete="current-password" />
          </div>

          <button type="submit" id="login-submit-btn" class="five-button five-auth-submit-btn">
            Ingresar a mi Cuenta ➔
          </button>
        </form>

        <!-- Form 2: Registro de Cliente -->
        <form id="form-register" hidden class="five-auth-form">
          <div class="five-form-group">
            <label for="reg-name" class="five-label">Nombre Completo *</label>
            <input type="text" id="reg-name" class="five-input" required placeholder="ej: Valentina Rojas" />
          </div>

          <div class="five-form-group">
            <label for="reg-email" class="five-label">Correo Electrónico *</label>
            <input type="email" id="reg-email" class="five-input" required placeholder="tu@correo.cl" autocomplete="email" />
          </div>

          <div class="five-form-group">
            <label for="reg-phone" class="five-label">Teléfono WhatsApp *</label>
            <input type="tel" id="reg-phone" class="five-input" required placeholder="+56 9 1234 5678" />
          </div>

          <div class="five-form-group">
            <label for="reg-pass" class="five-label">Contraseña (Mínimo 6 caracteres) *</label>
            <input type="password" id="reg-pass" class="five-input" required minlength="6" placeholder="Crea tu contraseña segura" autocomplete="new-password" />
          </div>

          <button type="submit" id="reg-submit-btn" class="five-button five-auth-submit-btn register-btn">
            Registrarme y Comenzar ➔
          </button>
        </form>
      </div>
    </div>
  </div>

  <script>
    import { AdminStoreService } from '../scripts/admin-store';
    import { formatMoney } from '../data/pim/catalog';

    const guestView = document.querySelector<HTMLElement>('#auth-guest-view')!;
    const portalView = document.querySelector<HTMLElement>('#auth-portal-view')!;

    const tabLogin = document.querySelector<HTMLButtonElement>('#tab-btn-login')!;
    const tabRegister = document.querySelector<HTMLButtonElement>('#tab-btn-register')!;
    const formLogin = document.querySelector<HTMLFormElement>('#form-login')!;
    const formRegister = document.querySelector<HTMLFormElement>('#form-register')!;
    const alertBox = document.querySelector<HTMLElement>('#auth-alert')!;

    // Portal elements
    const portalName = document.querySelector<HTMLElement>('#portal-user-name')!;
    const portalEmail = document.querySelector<HTMLElement>('#portal-user-email')!;
    const portalRole = document.querySelector<HTMLElement>('#portal-role-tag')!;
    const adminLink = document.querySelector<HTMLElement>('#portal-admin-link')!;
    const logoutBtn = document.querySelector<HTMLButtonElement>('#portal-logout-btn')!;
    const ordersList = document.querySelector<HTMLElement>('#portal-orders-list')!;

    // Portal Navigation Tabs & Panes
    const tabPortalOrders = document.querySelector<HTMLButtonElement>('#tab-portal-orders');
    const tabPortalProfile = document.querySelector<HTMLButtonElement>('#tab-portal-profile');
    const panePortalOrders = document.querySelector<HTMLElement>('#portal-tab-pane-orders');
    const panePortalProfile = document.querySelector<HTMLElement>('#portal-tab-pane-profile');

    // Profile form elements
    const formProfile = document.querySelector<HTMLFormElement>('#form-update-profile');
    const profNameInput = document.querySelector<HTMLInputElement>('#prof-name');
    const profPhoneInput = document.querySelector<HTMLInputElement>('#prof-phone');
    const profEmailInput = document.querySelector<HTMLInputElement>('#prof-email');
    const profCitySelect = document.querySelector<HTMLSelectElement>('#prof-city');
    const profAddressInput = document.querySelector<HTMLInputElement>('#prof-address');
    const profNotesInput = document.querySelector<HTMLTextAreaElement>('#prof-notes');
    const profSaveBtn = document.querySelector<HTMLButtonElement>('#prof-save-btn');
    const profSaveAlert = document.querySelector<HTMLElement>('#prof-save-alert');

    // KPI & Filter elements
    const kpiCountEl = document.querySelector<HTMLElement>('#kpi-orders-count')!;
    const kpiActiveEl = document.querySelector<HTMLElement>('#kpi-orders-active')!;
    const kpiSavingsEl = document.querySelector<HTMLElement>('#kpi-orders-savings')!;
    const filterPills = document.querySelectorAll<HTMLButtonElement>('.five-order-filter-pill');
    const formLinkOrder = document.querySelector<HTMLFormElement>('#form-link-order');
    const linkOrderInput = document.querySelector<HTMLInputElement>('#link-order-input');
    const linkOrderAlert = document.querySelector<HTMLElement>('#link-order-alert');

    let currentUser: any = null;
    let currentFilter: 'all' | 'active' | 'delivered' = 'all';

    const showAlert = (msg: string, isError = true) => {
      alertBox.textContent = msg;
      alertBox.style.background = isError ? '#fdeeed' : '#edf8e8';
      alertBox.style.color = isError ? '#c0392b' : '#276717';
      alertBox.style.borderColor = isError ? '#f5c6cb' : '#cce9c2';
      alertBox.hidden = false;
    };

    // Tab switching (Login vs Register)
    tabLogin.addEventListener('click', () => {
      tabLogin.classList.add('is-active');
      tabRegister.classList.remove('is-active');
      formLogin.hidden = false;
      formRegister.hidden = true;
      alertBox.hidden = true;
    });

    tabRegister.addEventListener('click', () => {
      tabRegister.classList.add('is-active');
      tabLogin.classList.remove('is-active');
      formLogin.hidden = true;
      formRegister.hidden = false;
      alertBox.hidden = true;
    });

    // Helper: Step index
    const getStepIndex = (status: string) => {
      if (status === 'Pago Confirmado') return 1;
      if (status === 'En Reparto') return 2;
      if (status === 'Entregado') return 3;
      return 0; // Recibido
    };

    const getStatusBadge = (status: string) => {
      if (status === 'Pago Confirmado') {
        return `<span class="five-badge-pill violet">● Pago Confirmado</span>`;
      }
      if (status === 'En Reparto') {
        return `<span class="five-badge-pill blue">● En Reparto</span>`;
      }
      if (status === 'Entregado') {
        return `<span class="five-badge-pill green">✓ Entregado</span>`;
      }
      return `<span class="five-badge-pill amber">⏳ Recibido (Validando)</span>`;
    };

    // Render Orders List according to active filter
    const renderOrdersList = (orders: any[]) => {
      let filtered = orders;
      if (currentFilter === 'active') {
        filtered = orders.filter((o) => o.status !== 'Entregado');
      } else if (currentFilter === 'delivered') {
        filtered = orders.filter((o) => o.status === 'Entregado');
      }

      if (!filtered.length) {
        const msg = currentFilter === 'all'
          ? 'Aún no tienes pedidos registrados con esta cuenta.'
          : currentFilter === 'active'
            ? 'No tienes pedidos en curso actualmente.'
            : 'No tienes pedidos entregados aún.';

        ordersList.innerHTML = `
          <div class="five-empty-state" style="padding:32px 20px; background:#ffffff; border:1px solid var(--border-color); border-radius:16px; text-align:center;">
            <div style="display:flex; justify-content:center; margin-bottom:8px;"><div style="width:50px; height:50px; border-radius:50%; background:#f3e8ff; display:flex; align-items:center; justify-content:center;"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#7025A8" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg></div></div>
            <p style="color:#6b7280; font-size:13.5px; margin:0 0 14px;">${msg}</p>
            <a href="/alimentos" class="five-button" style="font-size:13px; padding:8px 18px; text-decoration:none;">Explorar Catálogo ➔</a>
          </div>
        `;
        return;
      }

      const stepsDef = [
        { label: 'Recibido', sub: 'Pendiente pago' },
        { label: 'Confirmado', sub: 'Pago validado' },
        { label: 'En Reparto', sub: 'En camino' },
        { label: 'Entregado', sub: 'Finalizado' },
      ];

      ordersList.innerHTML = filtered.map((o) => {
        const stepIdx = getStepIndex(o.status || 'Recibido');
        const transferTotal = o.totalTransfer || o.total || 0;
        const savings = Math.max(0, (o.totalNormal || Math.round(transferTotal / 0.95)) - transferTotal);
        const orderDate = new Date(o.createdAt || Date.now()).toLocaleDateString('es-CL', {
          day: 'numeric',
          month: 'short',
          year: 'numeric',
          hour: '2-digit',
          minute: '2-digit',
        });

        const itemsHtml = (o.items || []).map((it: any) => `
          <div class="five-portal-item-line">
            <span class="five-portal-item-name"><strong>${it.quantity}x</strong> ${it.name}</span>
            <span class="five-portal-item-price">${formatMoney(it.price * it.quantity)}</span>
          </div>
        `).join('');

        const isPendingPayment = !o.status || o.status === 'Recibido';
        const waProofMsg = encodeURIComponent(
          `Hola FIVE Mascotas, envío mi comprobante de transferencia para el pedido ${o.code} por valor de ${formatMoney(transferTotal)}. Mi nombre es ${currentUser?.name || o.customerName || 'Cliente'}.`
        );

        return `
          <div class="five-portal-order-card">
            <!-- Card Header -->
            <div class="five-order-card-header">
              <div class="five-order-code-group">
                <span class="five-order-code">${o.code}</span>
                <button
                  type="button"
                  class="five-portal-copy-btn"
                  data-copy-code="${o.code}"
                  title="Copiar código de seguimiento"
                >
                  Copiar
                </button>
                <span class="five-order-date">Fecha: ${orderDate}</span>
              </div>
              <div class="five-order-status-badge">
                ${getStatusBadge(o.status || 'Recibido')}
              </div>
            </div>

            <!-- Stepper Progress Bar -->
            <div class="five-portal-stepper" aria-label="Progreso del pedido">
              ${stepsDef.map((st, idx) => {
                const isDone = idx < stepIdx;
                const isCurrent = idx === stepIdx;
                const stateClass = isDone ? 'is-done' : isCurrent ? 'is-current' : 'is-pending';
                return `
                  <div class="five-stepper-step ${stateClass}">
                    <div class="five-stepper-dot">
                      ${isDone ? '✓' : idx + 1}
                    </div>
                    <span class="five-stepper-label">${st.label}</span>
                  </div>
                `;
              }).join('')}
            </div>

            <!-- Items Breakdown -->
            <div class="five-portal-items-list">
              ${itemsHtml}
            </div>

            <!-- Destination & Shipping -->
            <div class="five-portal-destination-row">
              <span class="five-portal-dest-info">
                <strong>Despacho a:</strong> ${o.address || 'Dirección registrada'}, ${o.city || 'Comuna'}
              </span>
              <span class="five-portal-shipping-cost">
                Envío: ${formatMoney(o.shippingFee || 1500)}
              </span>
            </div>

            <!-- Financials & Actions Footer -->
            <div class="five-portal-order-footer">
              <div class="five-portal-totals-block">
                <div class="five-portal-final-price">
                  <span class="five-price-label">Total Transferencia:</span>
                  <strong class="five-price-amount">${formatMoney(transferTotal)}</strong>
                </div>
                ${savings > 0 ? `
                  <span class="five-portal-savings-tag">
                    Ahorro 5% transferencia: ${formatMoney(savings)}
                  </span>
                ` : ''}
              </div>

              <div class="five-portal-actions-block">
                ${isPendingPayment ? `
                  <a
                    href="https://wa.me/56964183605?text=${waProofMsg}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="five-portal-wa-btn"
                  >
                    Enviar Comprobante
                  </a>
                ` : ''}
                <a
                  href="/rastreo?codigo=${encodeURIComponent(o.code)}"
                  class="five-button five-portal-track-btn"
                >
                  Ver Seguimiento en Vivo ➔
                </a>
              </div>
            </div>
          </div>
        `;
      }).join('');
    };

    // Render Portal with orders and KPIs
    const renderPortal = async (user: any) => {
      currentUser = user;
      guestView.hidden = true;
      portalView.hidden = false;

      portalName.textContent = `Hola, ${user.name}`;
      portalEmail.textContent = user.email;
      portalRole.textContent = user.role === 'admin' ? 'Administrador del Sistema' : 'Cliente FIVE';

      if (user.role === 'admin') {
        adminLink.hidden = false;
      } else {
        adminLink.hidden = true;
      }

      // Fetch latest orders from server to synchronize
      const allOrders = await AdminStoreService.fetchOrdersFromServer();
      const userOrders = allOrders.filter(
        (o) => (o.email && o.email.toLowerCase() === user.email.toLowerCase()) || user.role === 'admin'
      );

      // Calculate KPIs
      const totalCount = userOrders.length;
      const activeCount = userOrders.filter((o) => o.status !== 'Entregado').length;
      const totalSavings = userOrders.reduce((sum, o) => {
        const transferTotal = o.totalTransfer || o.total || 0;
        const normal = o.totalNormal || Math.round(transferTotal / 0.95);
        return sum + Math.max(0, normal - transferTotal);
      }, 0);

      kpiCountEl.textContent = String(totalCount);
      kpiActiveEl.textContent = String(activeCount);
      kpiSavingsEl.textContent = formatMoney(totalSavings);

      // Populate profile form fields
      if (profNameInput) profNameInput.value = user.name || '';
      if (profPhoneInput) profPhoneInput.value = user.phone || '';
      if (profEmailInput) profEmailInput.value = user.email || '';
      if (profAddressInput) profAddressInput.value = user.address || '';
      if (profNotesInput) profNotesInput.value = user.notes || '';
      if (profCitySelect && user.city) {
        profCitySelect.value = user.city;
      }

      renderOrdersList(userOrders);
    };

    // Portal sub-tabs (Orders vs Profile)
    tabPortalOrders?.addEventListener('click', () => {
      tabPortalOrders.classList.add('is-active');
      tabPortalProfile?.classList.remove('is-active');
      if (panePortalOrders) panePortalOrders.hidden = false;
      if (panePortalProfile) panePortalProfile.hidden = true;
    });

    tabPortalProfile?.addEventListener('click', () => {
      tabPortalProfile?.classList.add('is-active');
      tabPortalOrders?.classList.remove('is-active');
      if (panePortalOrders) panePortalOrders.hidden = true;
      if (panePortalProfile) panePortalProfile.hidden = false;
    });

    // Form: Update Profile & Shipping Address
    formProfile?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!profSaveBtn || !profSaveAlert) return;

      profSaveBtn.disabled = true;
      profSaveBtn.textContent = 'Guardando...';
      profSaveAlert.style.display = 'none';

      try {
        const res = await fetch('/api/auth/profile', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: profNameInput?.value || '',
            phone: profPhoneInput?.value || '',
            address: profAddressInput?.value || '',
            city: profCitySelect?.value || 'Talca',
            notes: profNotesInput?.value || '',
          }),
        });

        const data = await res.json();
        if (!res.ok) {
          throw new Error(data.error || 'Error al guardar los datos');
        }

        currentUser = { ...currentUser, ...data.user };
        portalName.textContent = `Hola, ${data.user.name}`;

        profSaveAlert.style.display = 'block';
        profSaveAlert.style.background = '#edf8e8';
        profSaveAlert.style.color = '#276717';
        profSaveAlert.style.border = '1px solid #cce9c2';
        profSaveAlert.textContent = '✓ ¡Dirección y datos de contacto actualizados exitosamente! Se usarán automáticamente en el checkout.';

        setTimeout(() => {
          if (profSaveAlert) profSaveAlert.style.display = 'none';
        }, 5000);
      } catch (err: any) {
        profSaveAlert.style.display = 'block';
        profSaveAlert.style.background = '#fdeeed';
        profSaveAlert.style.color = '#c0392b';
        profSaveAlert.style.border = '1px solid #f5c6cb';
        profSaveAlert.textContent = `Error: ${err.message || 'No se pudieron guardar los datos'}`;
      } finally {
        profSaveBtn.disabled = false;
        profSaveBtn.innerHTML = '💾 Guardar Datos de Despacho';
      }
    });

    // Filter tabs listener
    filterPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        filterPills.forEach((p) => p.classList.remove('is-active'));
        pill.classList.add('is-active');
        currentFilter = (pill.getAttribute('data-order-filter') as any) || 'all';

        const allOrders = AdminStoreService.getOrders();
        const userOrders = allOrders.filter(
          (o) => (o.email && o.email.toLowerCase() === currentUser?.email.toLowerCase()) || currentUser?.role === 'admin'
        );
        renderOrdersList(userOrders);
      });
    });

    // Form: Link Guest Order
    formLinkOrder?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!linkOrderInput || !currentUser) return;
      const code = linkOrderInput.value.trim().toUpperCase();
      if (!code) return;

      if (linkOrderAlert) {
        linkOrderAlert.style.display = 'block';
        linkOrderAlert.style.color = '#7025a8';
        linkOrderAlert.textContent = 'Vinculando pedido...';
      }

      const success = await AdminStoreService.linkOrderToUser(code, currentUser.email);
      if (linkOrderAlert) {
        if (success) {
          linkOrderAlert.style.color = '#276717';
          linkOrderAlert.style.fontWeight = '700';
          linkOrderAlert.textContent = `¡Pedido ${code} vinculado exitosamente a tu cuenta!`;
          linkOrderInput.value = '';
          // Refresh orders and KPIs
          await renderPortal(currentUser);
        } else {
          linkOrderAlert.style.color = '#c0392b';
          linkOrderAlert.style.fontWeight = '700';
          linkOrderAlert.textContent = 'No se encontró un pedido con ese código o ocurrió un error.';
        }
      }
    });

    // Delegated copy button for order code
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.five-portal-copy-btn');
      if (btn) {
        const code = btn.getAttribute('data-copy-code') || '';
        if (code) {
          navigator.clipboard.writeText(code).then(() => {
            const originalText = btn.innerHTML;
            btn.innerHTML = '✓ ¡Copiado!';
            btn.style.color = '#276717';
            setTimeout(() => {
              btn.innerHTML = originalText;
              btn.style.color = '';
            }, 2000);
          }).catch(() => {});
        }
      }
    });

    // Listen to real-time order updates
    window.addEventListener('five:orders-updated', () => {
      if (currentUser) {
        const allOrders = AdminStoreService.getOrders();
        const userOrders = allOrders.filter(
          (o) => (o.email && o.email.toLowerCase() === currentUser.email.toLowerCase()) || currentUser.role === 'admin'
        );
        renderOrdersList(userOrders);
      }
    });

    // Check existing session on load
    const initSession = async () => {
      try {
        const res = await fetch('/api/auth/me');
        if (res.ok) {
          const data = await res.json();
          if (data?.user) {
            await renderPortal(data.user);
            return;
          }
        }
      } catch {}
      guestView.hidden = false;
      portalView.hidden = true;
    };

    // Submit Login
    formLogin.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.querySelector('#login-email') as HTMLInputElement).value;
      const password = (document.querySelector('#login-pass') as HTMLInputElement).value;

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password }),
        });
        const data = await res.json();
        if (!res.ok) {
          showAlert(data.error || 'Credenciales incorrectas');
          return;
        }

        // Check if there was a redirect query param
        const urlParams = new URLSearchParams(window.location.search);
        const redirect = urlParams.get('redirect');
        if (redirect && (data.user.role === 'admin' || !redirect.startsWith('/admin'))) {
          window.location.href = redirect;
          return;
        }

        await renderPortal(data.user);
      } catch (err) {
        showAlert('Error de conexión con el servidor de autenticación');
      }
    });

    // Submit Register
    formRegister.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = (document.querySelector('#reg-name') as HTMLInputElement).value;
      const email = (document.querySelector('#reg-email') as HTMLInputElement).value;
      const phone = (document.querySelector('#reg-phone') as HTMLInputElement).value;
      const password = (document.querySelector('#reg-pass') as HTMLInputElement).value;

      try {
        const res = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, phone, password }),
        });
        const data = await res.json();
        if (!res.ok) {
          showAlert(data.error || 'Error al crear la cuenta');
          return;
        }
        await renderPortal(data.user);
      } catch (err) {
        showAlert('Error al procesar el registro');
      }
    });

    // Logout
    logoutBtn?.addEventListener('click', async () => {
      try {
        await fetch('/api/auth/logout', { method: 'POST' });
      } catch {}
      window.location.reload();
    });

    initSession();
  </script>
</BaseLayout>

