---
import BaseLayout from '../layouts/BaseLayout.astro';
import PromoBannerStrip from '../components/PromoBannerStrip.astro';
import HeroCarousel from '../components/HeroCarousel.astro';

const products = [
  { name: 'Amici Adulto Mix', pet: 'Perros', detail: 'Carne y cereales · 22 kg', price: 32990, color: 'violet', type: 'Alimentos', image: '/five-mascotas/alimento-0.svg', oldPrice: 36990, badge: 'Liquidación', brand: 'Amici' },
  { name: '9 Lives Adulto Pescado', pet: 'Gatos', detail: 'Pescado y arroz · 8 kg', price: 24990, color: 'green', type: 'Alimentos', image: '/five-mascotas/alimento-1.svg', oldPrice: 0, badge: 'SuperPrecios', brand: '9 Lives' },
  { name: 'Ganacan Cachorro', pet: 'Perros', detail: 'Receta crecimiento · 10 kg', price: 28990, color: 'peach', type: 'Alimentos', image: '/five-mascotas/alimento-2.svg', oldPrice: 0, badge: '15% Dcto', brand: 'Ganacan' },
  { name: 'Josicat Esterilizado Classic', pet: 'Gatos', detail: 'Esterilizado control peso · 1,9 kg', price: 26990, color: 'lavender', type: 'Alimentos', image: '/five-mascotas/alimento-3.svg', oldPrice: 29990, badge: '30% en 2da', brand: 'Josi' },
  { name: 'Frontline Spray Perros y Gatos', pet: 'Perros Gatos', detail: 'Antiparasitario externo · 250 ml', price: 15990, color: 'green', type: 'Farmacia', image: '/five-mascotas/botiquin.svg', oldPrice: 0, badge: 'Salud', brand: 'Frontline' },
  { name: 'Frontline Plus Gatos 0,5 ml', pet: 'Gatos', detail: 'Pipeta antiparasitaria · 1 dosis', price: 3990, color: 'lavender', type: 'Farmacia', image: '/five-mascotas/gasas.svg', oldPrice: 0, badge: '', brand: 'Frontline' },
  { name: 'Plato de cerámica pesado antideslizante', pet: 'Perros Gatos', detail: '650 ml · Acabado mate', price: 9990, color: 'green', type: 'Accesorios', image: '/demos/miga/plato.svg', oldPrice: 11990, badge: 'Oferta', brand: 'Zee.Dog' },
  { name: 'Pelota con textura TPR resistente', pet: 'Perros', detail: 'Tamaño M · Caucho alta densidad', price: 4990, color: 'peach', type: 'Accesorios', image: '/demos/miga/pelota.svg', oldPrice: 0, badge: '', brand: 'Kong' },
  { name: 'Arena Stay Happy Café', pet: 'Gatos', detail: 'Aglomerante aroma café · 10 kg', price: 11990, color: 'lavender', type: 'Higiene', image: '/demos/miga/arena.svg', oldPrice: 0, badge: 'Top Ventas', brand: 'Stay Happy' },
  { name: 'Rahue Fémur Vacuno Gigante', pet: 'Perros', detail: 'Snack hueso natural · 1 un', price: 3990, color: 'peach', type: 'Snacks', image: '/demos/miga/snack.svg', oldPrice: 4990, badge: 'Oferta', brand: 'Rahue' },
];

const categoryIcons = [
  { name: 'Perros', href: '/perros', icon: '🐶', desc: 'Compañeros fieles' },
  { name: 'Gatos', href: '/gatos', icon: '🐱', desc: 'Reyes del hogar' },
  { name: 'Alimentos', href: '/alimentos', icon: '🍲', desc: 'Nutrición balanceada' },
  { name: 'Farmacia', href: '/farmacia', icon: '💊', desc: 'Cuidado y salud' },
  { name: 'Accesorios', href: '/accesorios', icon: '🎾', desc: 'Juegos y confort' },
  { name: 'Ofertas', href: '/ofertas', icon: '🏷️', desc: 'Hasta 40% OFF' },
];

const departments = [
  { name: 'Alimentos', icon: 'shopping-bag', text: 'Su plato de cada día' },
  { name: 'Farmacia', icon: 'heart', text: 'Cuidado y bienestar' },
  { name: 'Accesorios', icon: 'gift', text: 'Para jugar y acompañar' },
  { name: 'Higiene', icon: 'leaf', text: 'Limpios y cómodos' },
  { name: 'Snacks', icon: 'star', text: 'Un pequeño premio' },
  { name: 'Ofertas', icon: 'bookmark', text: 'Más por descubrir' }
];

const money = (n: number) =>
  new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(n);
---

<BaseLayout
  title="FIVE Mascotas — Su felicidad empieza en el plato"
  description="Tienda online FIVE Mascotas. Nutrición de primera línea, alimentos, cuidados y accesorios para perros y gatos."
>
  <!-- Secondary Campaign Promo Strip (Foto 4) -->
  <PromoBannerStrip
    bannerId="banner-hero-home"
    tag="¡SOLO X EL FINDE!"
    title="2x1 Todo camas, mantas y ropa perro y gato"
    subtitle="¡Combínalas como quieras! Descuento aplicado automáticamente en el carrito."
    ctaText="Ver Promoción ↗"
    ctaHref="/ofertas"
  />

  <!-- 1. Dynamic Hero Carousel (Foto 1) -->
  <HeroCarousel />

  <!-- 2. Category Navigation ("Shop by Category" - Foto 1) -->
  <section class="five-home-categories five-wrap">
    <div class="five-section-heading-row">
      <h2>Comprar por Categoría</h2>
      <a href="/alimentos" class="five-view-all-link">Ver todo &gt;</a>
    </div>
    <div class="five-category-circles-scroll">
      {categoryIcons.map((cat) => (
        <a href={cat.href} class="five-category-circle-item">
          <div class="five-circle-icon">{cat.icon}</div>
          <span class="five-circle-label">{cat.name}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- 3. Sale Urgency Countdown Banner (Foto 1) -->
  <section class="five-wrap">
    <div class="five-flash-sale-banner">
      <div class="five-sale-banner-left">
        <div class="five-sale-icon">⚡</div>
        <div class="five-sale-text">
          <small>¡Promoción Flash Activa!</small>
          <h3>Hasta 40% OFF en Alimentos Seleccionados</h3>
        </div>
      </div>

      <div class="five-sale-countdown" aria-label="Tiempo restante de oferta">
        <div class="five-countdown-box">
          <strong>02</strong>
          <span>HRS</span>
        </div>
        <span>:</span>
        <div class="five-countdown-box">
          <strong>15</strong>
          <span>MIN</span>
        </div>
        <span>:</span>
        <div class="five-countdown-box">
          <strong>47</strong>
          <span>SEG</span>
        </div>
      </div>

      <a href="/ofertas" class="five-sale-cta">
        Comprar Ofertas ↗
      </a>
    </div>
  </section>

  <!-- 4. Featured Products Catalog Section (Foto 1, Foto 3 & Test Suite Compatible) -->
  <section id="productos" class="five-wrap five-products-section">
    <div class="five-section-heading-row">
      <div>
        <span class="five-hero-badge">CATÁLOGO FIVE</span>
        <h2>Encuentra lo que necesita</h2>
      </div>
      <!-- Mascota Quick Filters (Test IDs compatible) -->
      <div class="five-filters" role="group" aria-label="Filtrar por mascota">
        {['Todos', 'Perros', 'Gatos'].map((pet, i) => (
          <button data-filter={pet} aria-pressed={i === 0 ? 'true' : 'false'}>
            {pet}
          </button>
        ))}
      </div>
    </div>

    <!-- Catalog Tools Bar (Test IDs compatible) -->
    <div class="five-catalog-tools">
      <label>
        Categoría
        <select id="five-department">
          <option value="Todos">Todas las categorías</option>
          {departments.filter((d) => d.name !== 'Ofertas').map((d) => (
            <option value={d.name}>{d.name}</option>
          ))}
        </select>
      </label>
      <label class="five-offers-filter">
        <input type="checkbox" id="five-offers" /> Solo ofertas
      </label>
      <button id="five-reset">Limpiar filtros</button>
      <span id="five-results" role="status">10 productos</span>
    </div>

    <p id="five-pharmacy-note" class="five-catalog-note" hidden>
      Farmacia: selección ilustrativa de artículos de cuidado. El catálogo definitivo se confirmará con la tienda.
    </p>

    <!-- Product Grid with standard cards (Test IDs compatible) -->
    <div class="five-product-grid" id="five-product-grid">
      {products.map((p, i) => (
        <article
          class="five-product-card"
          data-product
          data-pet={p.pet}
          data-type={p.type}
          data-category={p.type}
          data-offer={p.oldPrice > 0 ? "true" : "false"}
          data-search={`${p.name} ${p.brand || ''} ${p.detail} ${p.type} ${p.pet}`}
        >
          <div class={`five-product-image-box ${p.color}`}>
            <span class="five-product-pet-tag">
              {p.pet === 'Perros Gatos' ? 'Perros y gatos' : p.pet}
            </span>
            {p.oldPrice > 0 && <span class="five-product-badge">Oferta</span>}
            <img src={p.image} alt={`Envase ilustrativo: ${p.name}`} width="300" height="360" loading="lazy" />
            <button type="button" class="five-wishlist-btn" aria-label={`Guardar ${p.name} en favoritos`}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </button>
          </div>

          <div class="five-product-details">
            <span class="five-product-brand">{(p.brand || p.type).toUpperCase()}</span>
            <h3 class="five-product-title">{p.name}</h3>
            <span class="five-product-meta">{p.detail}</span>

            <div class="five-product-bottom-row">
              <div class="five-product-pricing">
                {p.oldPrice > 0 && (
                  <del class="five-old-price" aria-label="Precio anterior">{money(p.oldPrice)}</del>
                )}
                <strong class="five-current-price">{money(p.price)}</strong>
              </div>
              <button
                class="five-card-add-btn"
                data-add={String(i)}
                data-name={p.name}
                data-price={p.price}
                aria-label={`Agregar ${p.name} al carrito de muestra`}
              >
                +<span> Agregar</span>
              </button>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty State -->
    <div id="five-empty" class="five-empty-state" hidden>
      <div class="five-empty-icon">🐾</div>
      <h3>No encontramos productos con esos filtros</h3>
      <p>Prueba limpiando los filtros seleccionados.</p>
      <button id="five-clear" class="five-button">Ver todos</button>
    </div>

    <!-- Screen reader status -->
    <p class="sr-only" id="five-status" role="status"></p>
  </section>

  <!-- 5. Social Proof / Trust Badges (Foto 1) -->
  <section class="five-wrap five-social-proof-section">
    <div class="five-benefits-bar">
      <div>
        <img src="/icons/lucide/heart.svg" alt="" width="28" height="28" />
        <div>
          <strong>Para cada compañero</strong>
          <small>Perros y gatos, en cada etapa de su vida</small>
        </div>
      </div>
      <div>
        <img src="/icons/lucide/shopping-bag.svg" alt="" width="28" height="28" />
        <div>
          <strong>Su alimento siempre a mano</strong>
          <small>Despacho programado y retiro en tienda</small>
        </div>
      </div>
      <div>
        <img src="/icons/lucide/leaf.svg" alt="" width="28" height="28" />
        <div>
          <strong>Cuidar empieza en el plato</strong>
          <small>Nutrición testeada y aprobada por especialistas</small>
        </div>
      </div>
    </div>
  </section>

  <!-- Client Script for index filters and test compatibility -->
  <script>
    import '../scripts/five-mascotas';
  </script>
</BaseLayout>

<style>
  .five-products-section {
    padding-block: 40px 60px;
  }
  .five-filters {
    display: flex;
    gap: 8px;
  }
  .five-filters button {
    border: 1px solid var(--border-color);
    border-radius: 30px;
    background: #ffffff;
    color: var(--text-muted);
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 650;
    transition: all 0.2s;
  }
  .five-filters button[aria-pressed="true"] {
    background: var(--primary);
    color: #ffffff;
    border-color: var(--primary);
  }
  .five-catalog-tools {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    background: #f4ebfa;
    padding: 16px 20px;
    border-radius: 12px;
    margin-bottom: 24px;
    font-size: 13px;
  }
  .five-catalog-tools label {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .five-catalog-tools select {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 6px 12px;
  }
  .five-catalog-tools button, #five-clear {
    color: var(--primary);
    text-decoration: underline;
    font-weight: 650;
  }
  .five-catalog-tools > span {
    margin-left: auto;
    color: var(--text-muted);
  }
  .five-catalog-note {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: -12px;
    margin-bottom: 20px;
  }
  .five-social-proof-section {
    padding-bottom: 40px;
  }
  .five-benefits-bar {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding: 28px;
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: 18px;
  }
  .five-benefits-bar > div {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .five-benefits-bar strong {
    display: block;
    font-size: 14px;
    color: var(--text-main);
  }
  .five-benefits-bar small {
    display: block;
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 2px;
  }
  @media (max-width: 860px) {
    .five-benefits-bar {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  @media (max-width: 768px) {
    .five-products-section {
      padding-block: 24px 40px;
    }
    .five-section-heading-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .five-filters {
      width: 100%;
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 4px;
      -webkit-overflow-scrolling: touch;
    }
    .five-filters button {
      flex: 1;
      padding: 7px 14px;
      font-size: 12.5px;
      white-space: nowrap;
      text-align: center;
    }
    .five-catalog-tools {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      padding: 12px 14px;
    }
    .five-catalog-tools label {
      width: 100%;
      justify-content: space-between;
    }
    .five-catalog-tools select {
      flex: 1;
      max-width: 200px;
    }
    .five-catalog-tools > span {
      margin-left: 0;
      text-align: right;
    }
    .five-social-proof-section {
      padding-bottom: 24px;
    }
    .five-benefits-bar {
      padding: 18px 16px;
    }
  }
</style>
