---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products, formatMoney } from '../../data/pim/catalog';
import { defaultShippingRates } from '../../data/pim/shipping';
import type { Product, ProductVariant } from '../../data/pim/types';

export function getStaticPaths() {
  const paths = [];
  for (const product of products) {
    paths.push({
      params: { id: product.id },
      props: { product, initialVariantId: product.id },
    });
    // Variant sub-paths so direct variant links resolve seamlessly
    if (product.variants && product.variants.length > 1) {
      for (const v of product.variants) {
        if (v.id !== product.id) {
          paths.push({
            params: { id: v.id },
            props: { product, initialVariantId: v.id },
          });
        }
      }
    }
  }
  return paths;
}

interface Props {
  product: Product;
  initialVariantId?: string;
}

const { product, initialVariantId } = Astro.props;

const variants: ProductVariant[] = product.variants && product.variants.length > 0
  ? product.variants
  : [{
      id: product.id,
      format: product.format || '1 un',
      price: product.price,
      oldPrice: product.oldPrice,
      available: product.available ?? 25,
    }];

const activeVariant = variants.find(v => v.id === initialVariantId) || variants[0];
const debitPrice = Math.round(activeVariant.price * 1.05);
const oldPrice = activeVariant.oldPrice || product.oldPrice;

// Calculate discount
const discountPercent = oldPrice > activeVariant.price
  ? Math.round(((oldPrice - activeVariant.price) / oldPrice) * 100)
  : 0;

const cleanId = product.id.replace('prod-', '');

// Product gallery: only real images configured for this product (max 5)
const galleryImages = (Array.isArray(product.images) && product.images.length > 0)
  ? product.images.filter(Boolean).slice(0, 5)
  : [product.image].filter(Boolean);

const stockBadgeText = (activeVariant.available === 0)
  ? 'Agotado'
  : (activeVariant.available && activeVariant.available <= 5)
  ? `Últimas ${activeVariant.available} unidades`
  : '✓ En stock';

const stockBadgeClass = (activeVariant.available === 0)
  ? 'is-out'
  : (activeVariant.available && activeVariant.available <= 5)
  ? 'is-low'
  : 'is-in';
---

<BaseLayout
  title={`${product.name} — ${product.brand} | FIVE Mascotas`}
  description={`${product.name} ${product.detail}. Compra online con despacho el mismo día en Talca. Mejor precio con transferencia.`}
>
  <div class="five-pdp-page five-wrap">
    <!-- Breadcrumbs -->
    <nav class="five-breadcrumbs" aria-label="Ruta de navegación">
      <ol>
        <li><a href="/">Inicio</a> <span class="five-crumb-separator">/</span></li>
        <li><a href={product.pet === 'Gatos' ? '/gatos' : '/perros'}>{product.pet}</a> <span class="five-crumb-separator">/</span></li>
        <li><a href={`/${product.category.toLowerCase()}`}>{product.category}</a> <span class="five-crumb-separator">/</span></li>
        <li><span aria-current="page">{product.name}</span></li>
      </ol>
    </nav>

    <!-- Main PDP Grid: Gallery (Left) + Buy Box (Right) -->
    <div class="five-pdp-layout">
      <!-- 1. Interactive Image Gallery (Solo fotos reales del producto) -->
      <section class="five-pdp-gallery-col" aria-label="Galería de imágenes">
        <div class="five-pdp-main-image-box">
          {discountPercent > 0 && (
            <span class="five-pdp-discount-badge">-{discountPercent}% OFF</span>
          )}
          <img
            id="pdp-main-image"
            src={product.image}
            alt={`Fotografía principal de ${product.name}`}
            width="500"
            height="500"
            fetchpriority="high"
          />
        </div>

        <!-- Thumbnails Gallery Strip (Solo si el producto tiene más de 1 imagen) -->
        {galleryImages.length > 1 && (
          <div class="five-pdp-thumbs-row" role="tablist" aria-label="Vistas del producto">
            {galleryImages.map((imgUrl, idx) => (
              <button
                type="button"
                class={`five-pdp-thumb-btn ${idx === 0 ? 'is-active' : ''}`}
                data-thumb-src={imgUrl}
                aria-label={`Ver foto ${idx + 1}`}
              >
                <img src={imgUrl} alt="" width="70" height="70" />
              </button>
            ))}
          </div>
        )}
      </section>

      <!-- 2. Buy Box & Product Info (Dual Pricing exacto a la foto de referencia) -->
      <section class="five-pdp-info-col" aria-label="Información y compra de producto">
        <div class="five-pdp-brand-tag">{product.brand}®</div>
        <h1 class="five-pdp-title">{product.name}</h1>
        <p class="five-pdp-detail-line">{product.detail} · Para {product.pet}</p>

        <!-- SKU & Stock availability (Foto usuario) -->
        <div class="five-product-sku-row" style="margin-bottom:16px;">
          <span class="five-sku-text">ID {cleanId.padStart(5, '0')}</span>
          <span id="pdp-stock-badge" class={`five-stock-badge ${stockBadgeClass}`}>{stockBadgeText}</span>
        </div>

        <!-- Struck-through old price & discount pill -->
        <div class="five-product-discount-row" style="margin-bottom:12px;">
          {discountPercent > 0 && (
            <span class="five-discount-pill">-{discountPercent}%</span>
          )}
          {oldPrice > 0 && (
            <del class="five-old-price" style="font-size:16px;" aria-label="Precio normal anterior">
              {formatMoney(oldPrice)}
            </del>
          )}
        </div>

        <!-- Dual Pricing Block (Foto usuario: Transferencia/Efectivo vs Tarjeta Débito) -->
        <div class="five-pdp-pricing-card">
          <!-- Primary Price (Transferencia / Efectivo) -->
          <div class="five-pdp-price-row primary">
            <div>
              <strong class="five-pdp-main-price" id="pdp-price-display">{formatMoney(activeVariant.price)}</strong>
              <span class="five-price-type-label">Transferencia / Efectivo</span>
            </div>
            <span class="five-badge-best-price">Mejor Precio</span>
          </div>

          <!-- Secondary Price (Débito +5%) -->
          <div class="five-pdp-price-row secondary">
            <div>
              <strong class="five-pdp-debit-price" id="pdp-debit-display">{formatMoney(debitPrice)}</strong>
              <span class="five-price-type-sublabel">Tarjeta Débito (+5%)</span>
            </div>
            <small style="color:#6c757d;">Otros medios de pago</small>
          </div>
        </div>

        <!-- Format Options (Foto 2 del usuario) -->
        {variants.length > 1 ? (
          <div class="five-pdp-options-section">
            <label class="five-pdp-option-label">Seleccionar Peso</label>
            <div class="five-pdp-variant-list" role="radiogroup" aria-label="Opciones de formato y kilaje">
              {variants.map((v) => {
                const isSelected = v.id === activeVariant.id;
                const isOutOfStock = v.available === 0;
                return (
                  <label
                    class={`five-pdp-variant-row ${isSelected ? 'is-selected' : ''} ${isOutOfStock ? 'is-disabled' : ''}`}
                    data-variant-id={v.id}
                    data-price={v.price}
                    data-debit={Math.round(v.price * 1.05)}
                    data-stock={v.available ?? 25}
                    data-format={v.format}
                  >
                    <div class="five-pdp-variant-left">
                      <input
                        type="radio"
                        name="pdp-format-choice"
                        value={v.id}
                        checked={isSelected}
                        disabled={isOutOfStock}
                        class="five-pdp-radio-input"
                      />
                      <span class="five-pdp-radio-circle">
                        <span class="five-pdp-radio-dot"></span>
                      </span>
                      <div class="five-pdp-variant-text-group">
                        <strong class="five-pdp-format-label">{v.format.toUpperCase()}</strong>
                        {v.pricePerKg && (
                          <span class="five-pdp-kg-label">({formatMoney(v.pricePerKg)} x KG)</span>
                        )}
                      </div>
                    </div>

                    <div class="five-pdp-variant-right">
                      {isOutOfStock ? (
                        <span class="five-variant-badge-out">Agotado</span>
                      ) : (
                        <strong class="five-pdp-format-price">{formatMoney(v.price)}</strong>
                      )}
                    </div>
                  </label>
                );
              })}
            </div>
          </div>
        ) : (
          <div class="five-pdp-options-section">
            <label class="five-pdp-option-label">Formato:</label>
            <div class="five-pdp-single-format-tag">
              <span>{product.format || '1 un'}</span>
            </div>
          </div>
        )}

        <!-- Quantity & Add to Cart -->
        <div class="five-pdp-actions-row">
          <div class="five-pdp-qty-control" aria-label="Selector de cantidad">
            <button type="button" id="pdp-qty-minus" aria-label="Disminuir cantidad" disabled>-</button>
            <input type="number" id="pdp-qty-input" value="1" min="1" max={Math.min(activeVariant.available || 1, 10)} readonly />
            <button type="button" id="pdp-qty-plus" aria-label="Aumentar cantidad" disabled={(activeVariant.available ?? 25) <= 1}>+</button>
          </div>

          <button
            class="five-card-add-btn five-pdp-buy-btn"
            id="pdp-add-to-cart-btn"
            data-add={activeVariant.id}
            data-name={`${product.name} (${activeVariant.format})`}
            data-price={activeVariant.price}
            data-image={product.image}
            disabled={activeVariant.available === 0}
            aria-label={`Agregar ${product.name} al carro`}
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            <span id="pdp-buy-btn-text">{activeVariant.available === 0 ? 'Agotado' : 'Agregar al carro'}</span>
          </button>
        </div>

        <!-- City Shipping Selector (Tarifa plana configurable por ciudad) -->
        <div class="five-pdp-shipping-box">
          <div class="five-pdp-ship-head">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
            <div>
              <strong>Calcular Despacho a Domicilio</strong>
              <small>Tarifa plana según tu ciudad</small>
            </div>
          </div>

          <div class="five-pdp-ship-selector-row">
            <select id="pdp-city-select" class="five-select" style="width:100%;">
              {defaultShippingRates.map((r) => (
                <option value={r.id} selected={r.isDefault} data-price={r.price} data-note={r.deliveryNote}>
                  {r.city} — {formatMoney(r.price)}
                </option>
              ))}
            </select>
          </div>

          <div class="five-pdp-ship-feedback" id="pdp-ship-feedback">
            <span class="five-ship-check">✓</span>
            <span id="pdp-ship-note-text">
              {defaultShippingRates[0].deliveryNote}
            </span>
          </div>
        </div>
      </section>
    </div>

    <!-- Product Features & Nutrition Accordion -->
    <section class="five-pdp-details-tabs" aria-label="Ficha técnica e información adicional">
      <div class="five-accordion">
        <!-- Tab 1: Nutritional Information & Ingredients -->
        <details class="five-accordion-item" open>
          <summary class="five-accordion-header">
            <span>Información Nutricional e Ingredientes</span>
            <span class="five-accordion-chevron">&darr;</span>
          </summary>
          <div class="five-accordion-content">
            <div class="five-nutrition-grid">
              <div class="five-nutrition-kpi">
                <span class="label">Proteína Cruda (mín.)</span>
                <strong class="value">{product.proteinPct ? `${product.proteinPct}%` : '28%'}</strong>
              </div>
              <div class="five-nutrition-kpi">
                <span class="label">Grasa Total (mín.)</span>
                <strong class="value">{product.fatPct ? `${product.fatPct}%` : '12%'}</strong>
              </div>
              <div class="five-nutrition-kpi">
                <span class="label">Fibra Cruda (máx.)</span>
                <strong class="value">{product.fiberPct ? `${product.fiberPct}%` : '3.5%'}</strong>
              </div>
              <div class="five-nutrition-kpi">
                <span class="label">Humedad (máx.)</span>
                <strong class="value">{product.moisturePct ? `${product.moisturePct}%` : '10%'}</strong>
              </div>
            </div>

            <h4 style="margin-top:20px;margin-bottom:8px;font-size:14px;font-weight:750;">Ingredientes Principales</h4>
            <p class="five-ingredients-text">
              {product.ingredients || 'Harina de carne seleccionada, arroz integral, maíz grano molido, grasa animal estabilizada con antioxidantes naturales, pulpa de remolacha (fuente de FOS), extracto de Yucca Schidigera, levadura de cerveza, minerales quelados y vitaminas esenciales.'}
            </p>
          </div>
        </details>

        <!-- Tab 2: Feeding Guide -->
        <details class="five-accordion-item">
          <summary class="five-accordion-header">
            <span>Guía de Porciones Diarias Recomendadas</span>
            <span class="five-accordion-chevron">&darr;</span>
          </summary>
          <div class="five-accordion-content">
            <p style="margin-bottom:12px;font-size:13px;color:#4b5563;">
              Las cantidades son orientativas y pueden variar según el nivel de actividad física, edad y condición corporal de tu mascota:
            </p>
            <table class="five-table-guide" style="width:100%;border-collapse:collapse;font-size:13px;">
              <thead>
                <tr style="background:#f3f4f6;text-align:left;">
                  <th style="padding:8px 12px;border:1px solid #e5e7eb;">Peso Mascota</th>
                  <th style="padding:8px 12px;border:1px solid #e5e7eb;">Actividad Moderada</th>
                  <th style="padding:8px 12px;border:1px solid #e5e7eb;">Actividad Alta</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td style="padding:8px 12px;border:1px solid #e5e7eb;">1 – 5 kg</td>
                  <td style="padding:8px 12px;border:1px solid #e5e7eb;">35 – 90 g / día</td>
                  <td style="padding:8px 12px;border:1px solid #e5e7eb;">45 – 115 g / día</td>
                </tr>
                <tr>
                  <td style="padding:8px 12px;border:1px solid #e5e7eb;">5 – 10 kg</td>
                  <td style="padding:8px 12px;border:1px solid #e5e7eb;">90 – 150 g / día</td>
                  <td style="padding:8px 12px;border:1px solid #e5e7eb;">115 – 190 g / día</td>
                </tr>
                <tr>
                  <td style="padding:8px 12px;border:1px solid #e5e7eb;">10 – 25 kg</td>
                  <td style="padding:8px 12px;border:1px solid #e5e7eb;">150 – 290 g / día</td>
                  <td style="padding:8px 12px;border:1px solid #e5e7eb;">190 – 380 g / día</td>
                </tr>
                <tr>
                  <td style="padding:8px 12px;border:1px solid #e5e7eb;">+25 kg</td>
                  <td style="padding:8px 12px;border:1px solid #e5e7eb;">+300 g / día</td>
                  <td style="padding:8px 12px;border:1px solid #e5e7eb;">+400 g / día</td>
                </tr>
              </tbody>
            </table>
          </div>
        </details>

        <!-- Tab 3: Dispatch & Guarantee -->
        <details class="five-accordion-item">
          <summary class="five-accordion-header">
            <span>Envíos, Retiro en Tienda y Garantía FIVE</span>
            <span class="five-accordion-chevron">&darr;</span>
          </summary>
          <div class="five-accordion-content">
            <p style="font-size:13px;line-height:1.6;color:#374151;">
              <strong>Despacho Same-Day Talca:</strong> Pedidos recibidos antes de las 14:00 hrs son entregados el mismo día hábil en la puerta de tu hogar.<br />
              <strong>Retiro Express:</strong> Disponible sin costo en tienda física FIVE Mascotas (Talca) una hora tras confirmar tu compra.<br />
              <strong>Garantía de Satisfacción 100%:</strong> Si a tu mascota no le gusta su nuevo alimento o recibes un empaque dañado, te lo cambiamos sin trámites engorrosos en menos de 48 horas.
            </p>
          </div>
        </details>
      </div>
    </section>
  </div>

  <!-- PDP Client Behavior -->
  <script>
    import { AdminStoreService } from '../../scripts/admin-store';
    import { formatMoney } from '../../data/pim/catalog';

    // 1. Gallery thumbnail switching
    const mainImg = document.querySelector<HTMLImageElement>('#pdp-main-image');
    const thumbBtns = document.querySelectorAll<HTMLButtonElement>('.five-pdp-thumb-btn');

    thumbBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        thumbBtns.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        const src = btn.dataset.thumbSrc;
        if (mainImg && src) {
          mainImg.src = src;
        }
      });
    });

    // 2. Format & Variant selection
    const variantRows = document.querySelectorAll<HTMLElement>('.five-pdp-variant-row');
    const priceDisplay = document.querySelector<HTMLElement>('#pdp-price-display');
    const debitDisplay = document.querySelector<HTMLElement>('#pdp-debit-display');
    const stockBadge = document.querySelector<HTMLElement>('#pdp-stock-badge');
    const addToCartBtn = document.querySelector<HTMLButtonElement>('#pdp-add-to-cart-btn');
    const buyBtnText = document.querySelector<HTMLElement>('#pdp-buy-btn-text');
    const qtyInput = document.querySelector<HTMLInputElement>('#pdp-qty-input');
    const minusBtn = document.querySelector<HTMLButtonElement>('#pdp-qty-minus');
    const plusBtn = document.querySelector<HTMLButtonElement>('#pdp-qty-plus');

    let currentStock = parseInt(qtyInput?.getAttribute('max') || '10', 10);

    const updateQuantityLimits = (stock: number) => {
      currentStock = stock;
      if (!qtyInput) return;
      qtyInput.value = '1';
      qtyInput.max = String(Math.min(stock || 1, 10));
      if (minusBtn) minusBtn.disabled = true;
      if (plusBtn) plusBtn.disabled = stock <= 1;
    };

    variantRows.forEach((row) => {
      row.addEventListener('click', () => {
        if (row.classList.contains('is-disabled')) return;
        const radio = row.querySelector<HTMLInputElement>('input[type="radio"]');
        if (!radio) return;
        radio.checked = true;

        variantRows.forEach(r => r.classList.remove('is-selected'));
        row.classList.add('is-selected');

        const vId = row.dataset.variantId || '';
        const price = Number(row.dataset.price) || 0;
        const debit = Number(row.dataset.debit) || Math.round(price * 1.05);
        const stock = Number(row.dataset.stock) || 0;
        const format = row.dataset.format || '';

        if (priceDisplay) priceDisplay.textContent = formatMoney(price);
        if (debitDisplay) debitDisplay.textContent = formatMoney(debit);

        if (stockBadge) {
          stockBadge.className = 'five-stock-badge';
          if (stock === 0) {
            stockBadge.classList.add('is-out');
            stockBadge.textContent = 'Agotado';
          } else if (stock <= 5) {
            stockBadge.classList.add('is-low');
            stockBadge.textContent = `Últimas ${stock} unidades`;
          } else {
            stockBadge.classList.add('is-in');
            stockBadge.textContent = '✓ En stock';
          }
        }

        if (addToCartBtn) {
          addToCartBtn.dataset.add = vId;
          addToCartBtn.dataset.price = String(price);
          const baseName = (document.querySelector('.five-pdp-title')?.textContent || '').trim();
          addToCartBtn.dataset.name = `${baseName} (${format})`;
          addToCartBtn.disabled = stock === 0;
          if (buyBtnText) {
            buyBtnText.textContent = stock === 0 ? 'Agotado' : 'Agregar al carro';
          }
        }

        updateQuantityLimits(stock);
      });
    });

    // 3. Quantity selector
    minusBtn?.addEventListener('click', () => {
      if (!qtyInput) return;
      let val = Number(qtyInput.value) || 1;
      if (val > 1) {
        val -= 1;
        qtyInput.value = String(val);
      }
      minusBtn.disabled = val <= 1;
      if (plusBtn) plusBtn.disabled = val >= Math.min(currentStock || 1, 10);
    });

    plusBtn?.addEventListener('click', () => {
      if (!qtyInput) return;
      let val = Number(qtyInput.value) || 1;
      const maxLimit = Math.min(currentStock || 1, 10);
      if (val < maxLimit) {
        val += 1;
        qtyInput.value = String(val);
      }
      if (minusBtn) minusBtn.disabled = val <= 1;
      plusBtn.disabled = val >= maxLimit;
    });

    // 4. City Shipping Rate selection
    const citySelect = document.querySelector<HTMLSelectElement>('#pdp-city-select');
    const noteText = document.querySelector('#pdp-ship-note-text');

    const loadCities = () => {
      if (!citySelect) return;
      const rates = AdminStoreService.getShippingRates();
      citySelect.innerHTML = '';
      rates.forEach((r) => {
        const opt = document.createElement('option');
        opt.value = r.id;
        opt.selected = !!r.isDefault;
        opt.dataset.price = String(r.price);
        opt.dataset.note = r.deliveryNote || '';
        opt.textContent = `${r.city} — ${formatMoney(r.price)}`;
        citySelect.appendChild(opt);
      });
      updateNote();
    };

    const updateNote = () => {
      if (!citySelect || !noteText) return;
      const selected = citySelect.selectedOptions[0];
      if (selected && selected.dataset.note) {
        noteText.textContent = selected.dataset.note;
      }
    };

    citySelect?.addEventListener('change', updateNote);
    loadCities();
  </script>
</BaseLayout>
