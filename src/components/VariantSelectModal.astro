---
// VariantSelectModal.astro
// Modal emergente rápido (bottom-sheet en móvil, centrado en desktop) para seleccionar peso/kilaje,
// ver precio por kilo ($/KG), verificar stock en tiempo real y agregar al carrito sin salir de la página.
---

<dialog id="five-variant-modal" class="five-variant-dialog" aria-labelledby="vm-product-title">
  <div class="five-variant-card">
    <button type="button" class="five-variant-close" id="vm-close-btn" aria-label="Cerrar selector de formato">&times;</button>

    <div class="five-variant-content">
      <!-- Product Header Preview -->
      <div class="five-variant-header">
        <div class="five-variant-img-wrap">
          <img id="vm-product-img" src="/images/product-placeholder.svg" alt="" width="80" height="80" />
        </div>
        <div class="five-variant-header-info">
          <span id="vm-product-brand" class="five-variant-brand-tag">MARCA</span>
          <h3 id="vm-product-title" class="five-variant-title">Nombre del Producto</h3>
          <span id="vm-product-detail" class="five-variant-detail">Detalle</span>
        </div>
      </div>

      <!-- Format / Weight Selection Section (Foto 2 del usuario) -->
      <div class="five-variant-options-section">
        <label class="five-variant-section-label">Seleccionar Peso</label>
        <div id="vm-options-list" class="five-variant-options-list" role="radiogroup" aria-label="Opciones de kilaje">
          <!-- Dynamically populated via store.ts -->
        </div>
      </div>

      <!-- Price & Availability Block -->
      <div class="five-variant-summary-box">
        <div class="five-variant-price-wrap">
          <strong id="vm-active-price" class="five-variant-hero-price">$0</strong>
          <span id="vm-price-note" class="five-variant-price-note">Transferencia / Efectivo</span>
        </div>
        <div class="five-variant-stock-status">
          <span id="vm-stock-badge" class="five-variant-stock-indicator">Selecciona una opción para ver disponibilidad</span>
        </div>
      </div>

      <!-- Quantity Stepper & Buy Action (Foto 2 del usuario) -->
      <div class="five-variant-footer">
        <div class="five-variant-qty-wrap">
          <label for="vm-qty-input" class="five-variant-qty-label">Cantidad:</label>
          <div class="five-qty-stepper">
            <button type="button" id="vm-qty-minus" class="five-qty-btn" aria-label="Disminuir cantidad" disabled>-</button>
            <input type="number" id="vm-qty-input" class="five-qty-val" value="1" min="1" max="99" readonly />
            <button type="button" id="vm-qty-plus" class="five-qty-btn" aria-label="Aumentar cantidad">+</button>
          </div>
        </div>

        <button type="button" id="vm-add-cart-btn" class="five-button five-variant-submit-btn" disabled>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          <span id="vm-add-btn-text">Agregar al carro</span>
        </button>
      </div>

      <div class="five-variant-pdp-link-row">
        <a id="vm-pdp-link" href="#" class="five-variant-view-details">Ver ficha y tabla nutricional completa &rarr;</a>
      </div>
    </div>
  </div>
</dialog>

<style>
  .five-variant-dialog {
    border: none;
    border-radius: 20px;
    padding: 0;
    max-width: 520px;
    width: calc(100% - 32px);
    background: #ffffff;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    margin: auto;
  }
  .five-variant-dialog::backdrop {
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(4px);
  }
  .five-variant-card {
    position: relative;
    padding: 24px;
  }
  .five-variant-close {
    position: absolute;
    top: 14px;
    right: 14px;
    background: #f1f5f9;
    border: none;
    font-size: 24px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #475569;
    transition: background 0.2s, color 0.2s;
  }
  .five-variant-close:hover {
    background: #e2e8f0;
    color: #0f172a;
  }
  .five-variant-header {
    display: flex;
    gap: 16px;
    align-items: center;
    padding-bottom: 16px;
    border-bottom: 1px solid #f1f5f9;
  }
  .five-variant-img-wrap {
    width: 72px;
    height: 72px;
    background: #f8fafc;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
    flex-shrink: 0;
    border: 1px solid #e2e8f0;
  }
  .five-variant-img-wrap img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .five-variant-header-info {
    flex: 1;
    min-width: 0;
  }
  .five-variant-brand-tag {
    font-size: 11px;
    font-weight: 800;
    color: #7025a8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .five-variant-title {
    font-size: 16px;
    font-weight: 750;
    color: #0f172a;
    margin: 2px 0;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .five-variant-detail {
    font-size: 12px;
    color: #64748b;
  }
  .five-variant-options-section {
    margin-top: 18px;
  }
  .five-variant-section-label {
    display: block;
    font-size: 14px;
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 10px;
  }
  .five-variant-options-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  :global(.five-variant-row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.15s ease-in-out;
    background: #ffffff;
    user-select: none;
  }
  :global(.five-variant-row:hover:not(.is-disabled)) {
    border-color: #cbd5e1;
    background: #f8fafc;
  }
  :global(.five-variant-row.is-selected) {
    border-color: #7025a8;
    background: #faf5ff;
    box-shadow: 0 0 0 1px #7025a8;
  }
  :global(.five-variant-row.is-disabled) {
    opacity: 0.55;
    background: #f8fafc;
    cursor: not-allowed;
    border-style: dashed;
  }
  :global(.five-variant-row-left) {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  :global(.five-variant-radio-circle) {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid #94a3b8;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s;
    flex-shrink: 0;
  }
  :global(.five-variant-row.is-selected .five-variant-radio-circle) {
    border-color: #7025a8;
    background: #7025a8;
  }
  :global(.five-variant-radio-dot) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ffffff;
    display: none;
  }
  :global(.five-variant-row.is-selected .five-variant-radio-dot) {
    display: block;
  }
  :global(.five-variant-format-text) {
    font-size: 14px;
    font-weight: 750;
    color: #1e293b;
  }
  :global(.five-variant-unit-price) {
    font-size: 12px;
    color: #64748b;
    margin-left: 6px;
    font-weight: 500;
  }
  :global(.five-variant-row-right) {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  :global(.five-variant-price-val) {
    font-size: 15px;
    font-weight: 800;
    color: #0f172a;
  }
  :global(.five-variant-soldout-pill) {
    font-size: 11px;
    font-weight: 700;
    color: #ef4444;
    background: #fee2e2;
    padding: 2px 8px;
    border-radius: 6px;
    text-transform: uppercase;
  }
  :global(.five-variant-lowstock-pill) {
    font-size: 11px;
    font-weight: 700;
    color: #d97706;
    background: #fef3c7;
    padding: 2px 8px;
    border-radius: 6px;
  }
  .five-variant-summary-box {
    margin-top: 16px;
    padding: 12px 14px;
    background: #f8fafc;
    border-radius: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px solid #f1f5f9;
  }
  .five-variant-hero-price {
    font-size: 20px;
    font-weight: 850;
    color: #e11d48;
    display: block;
    line-height: 1.1;
  }
  .five-variant-price-note {
    font-size: 11px;
    color: #64748b;
  }
  .five-variant-stock-indicator {
    font-size: 12px;
    font-weight: 600;
    color: #475569;
  }
  .five-variant-footer {
    margin-top: 18px;
    display: flex;
    gap: 14px;
    align-items: center;
  }
  .five-variant-qty-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .five-variant-qty-label {
    font-size: 13px;
    font-weight: 600;
    color: #475569;
  }
  .five-qty-stepper {
    display: flex;
    align-items: center;
    border: 1.5px solid #cbd5e1;
    border-radius: 8px;
    overflow: hidden;
    height: 44px;
    background: #ffffff;
  }
  .five-qty-btn {
    width: 36px;
    height: 100%;
    background: transparent;
    border: none;
    font-size: 18px;
    font-weight: 700;
    color: #334155;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s;
  }
  .five-qty-btn:hover:not(:disabled) {
    background: #f1f5f9;
  }
  .five-qty-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .five-qty-val {
    width: 40px;
    border: none;
    text-align: center;
    font-size: 15px;
    font-weight: 750;
    color: #0f172a;
    background: transparent;
  }
  .five-variant-submit-btn {
    flex: 1;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 750;
    background: #e11d48;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    transition: background 0.15s, transform 0.1s;
  }
  .five-variant-submit-btn:hover:not(:disabled) {
    background: #be123c;
    transform: translateY(-1px);
  }
  .five-variant-submit-btn:disabled {
    background: #cbd5e1;
    cursor: not-allowed;
    transform: none;
  }
  .five-variant-pdp-link-row {
    margin-top: 12px;
    text-align: center;
  }
  .five-variant-view-details {
    font-size: 12px;
    font-weight: 600;
    color: #7025a8;
    text-decoration: none;
  }
  .five-variant-view-details:hover {
    text-decoration: underline;
  }

  /* Mobile Bottom Sheet */
  @media (max-width: 640px) {
    .five-variant-dialog {
      position: fixed;
      bottom: 0;
      top: auto;
      left: 0;
      right: 0;
      width: 100%;
      max-width: 100%;
      border-radius: 20px 20px 0 0;
      margin: 0;
      transform: translateY(0);
      animation: slideUp 0.25s ease-out;
    }
    @keyframes slideUp {
      from { transform: translateY(100%); }
      to { transform: translateY(0); }
    }
  }
</style>
