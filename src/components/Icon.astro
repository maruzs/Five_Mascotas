---
// src/components/Icon.astro
// Componente de ícono corporativo Five Mascotas con colores de la UI (#7025A8, #94F963, #276717, #4B5563)
interface Props {
  name:
    | 'dog'
    | 'cat'
    | 'food'
    | 'pharmacy'
    | 'toys'
    | 'tag'
    | 'flash'
    | 'paw'
    | 'cart'
    | 'search'
    | 'user'
    | 'home'
    | 'package'
    | 'truck'
    | 'money'
    | 'shield'
    | 'scale'
    | 'check'
    | 'clock'
    | 'mail'
    | 'pin'
    | 'sparkles'
    | 'leaf'
    | 'meat'
    | 'link';
  size?: number | string;
  class?: string;
  color?: string; // Por defecto hereda currentColor o un tono corporativo
  strokeWidth?: number | string;
}

const {
  name,
  size = 24,
  class: className = '',
  color = 'currentColor',
  strokeWidth = 2,
} = Astro.props;

const s = typeof size === 'number' ? `${size}px` : size;
---

{name === 'dog' && (
  <svg class={className} width={s} height={s} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M10 5.172a2 2 0 0 0-3.414-1.414l-3.172 3.172a2 2 0 0 0 0 2.828l1.414 1.414"></path>
    <path d="M14 5.172a2 2 0 0 1 3.414-1.414l3.172 3.172a2 2 0 0 1 0 2.828l-1.414 1.414"></path>
    <path d="M6 12a6 6 0 1 0 12 0 6 6 0 0 0-12 0Z"></path>
    <circle cx="9" cy="11" r="1" fill={color}></circle>
    <circle cx="15" cy="11" r="1" fill={color}></circle>
    <path d="M11 15h2"></path>
  </svg>
)}

{name === 'cat' && (
  <svg class={className} width={s} height={s} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 5c-3.87 0-7 3.13-7 7 0 2.87 1.74 5.34 4.24 6.42L12 21l2.76-2.58C17.26 17.34 19 14.87 19 12c0-3.87-3.13-7-7-7Z"></path>
    <path d="M5 8 3 3l5 2"></path>
    <path d="M19 8l2-5-5 2"></path>
    <circle cx="9" cy="12" r="1" fill={color}></circle>
    <circle cx="15" cy="12" r="1" fill={color}></circle>
    <path d="M12 15v1"></path>
  </svg>
)}

{name === 'food' && (
  <svg class={className} width={s} height={s} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M18 11V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0"></path>
    <path d="M14 10V4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v2"></path>
    <path d="M3 13a9 9 0 0 0 18 0H3z"></path>
    <path d="M7 21h10"></path>
    <path d="M12 17v4"></path>
  </svg>
)}

{name === 'pharmacy' && (
  <svg class={className} width={s} height={s} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"></path>
    <path d="m8.5 8.5 7 7"></path>
  </svg>
)}

{name === 'toys' && (
  <svg class={className} width={s} height={s} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="10"></circle>
    <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
    <path d="M2 12h20"></path>
  </svg>
)}

{name === 'tag' && (
  <svg class={className} width={s} height={s} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"></path>
    <path d="M7 7h.01"></path>
  </svg>
)}

{name === 'flash' && (
  <svg class={className} width={s} height={s} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
  </svg>
)}

{name === 'paw' && (
  <svg class={className} width={s} height={s} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="7" cy="8" r="2.2" fill={color}></circle>
    <circle cx="17" cy="8" r="2.2" fill={color}></circle>
    <circle cx="12" cy="5" r="2.2" fill={color}></circle>
    <path d="M12 10c-3 0-5 2-5 5.5 0 2 2 3.5 5 3.5s5-1.5 5-3.5C17 12 15 10 12 10Z" fill={color}></path>
  </svg>
)}

{name === 'cart' && (
  <svg class={className} width={s} height={s} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="9" cy="21" r="1"></circle>
    <circle cx="20" cy="21" r="1"></circle>
    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
  </svg>
)}

{name === 'search' && (
  <svg class={className} width={s} height={s} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="11" r="8"></circle>
    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
  </svg>
)}

{name === 'user' && (
  <svg class={className} width={s} height={s} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
    <circle cx="12" cy="7" r="4"></circle>
  </svg>
)}

{name === 'home' && (
  <svg class={className} width={s} height={s} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
    <polyline points="9 22 9 12 15 12 15 22"></polyline>
  </svg>
)}

{name === 'package' && (
  <svg class={className} width={s} height={s} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <line x1="16.5" y1="9.4" x2="7.5" y2="4.21"></line>
    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
    <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
    <line x1="12" y1="22.08" x2="12" y2="12"></line>
  </svg>
)}

{name === 'truck' && (
  <svg class={className} width={s} height={s} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="1" y="3" width="15" height="13"></rect>
    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
    <circle cx="5.5" cy="18.5" r="2.5"></circle>
    <circle cx="18.5" cy="18.5" r="2.5"></circle>
  </svg>
)}

{name === 'money' && (
  <svg class={className} width={s} height={s} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <line x1="12" y1="1" x2="12" y2="23"></line>
    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
  </svg>
)}

{name === 'shield' && (
  <svg class={className} width={s} height={s} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
  </svg>
)}

{name === 'scale' && (
  <svg class={className} width={s} height={s} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M16 16l3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1z"></path>
    <path d="M2 16l3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1z"></path>
    <path d="M7 21h10"></path>
    <path d="M12 3v18"></path>
    <path d="M3 7h18"></path>
  </svg>
)}

{name === 'check' && (
  <svg class={className} width={s} height={s} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <polyline points="20 6 9 17 4 12"></polyline>
  </svg>
)}

{name === 'clock' && (
  <svg class={className} width={s} height={s} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="10"></circle>
    <polyline points="12 6 12 12 16 14"></polyline>
  </svg>
)}

{name === 'mail' && (
  <svg class={className} width={s} height={s} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
    <polyline points="22,6 12,13 2,6"></polyline>
  </svg>
)}

{name === 'pin' && (
  <svg class={className} width={s} height={s} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
    <circle cx="12" cy="10" r="3"></circle>
  </svg>
)}

{name === 'sparkles' && (
  <svg class={className} width={s} height={s} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path>
  </svg>
)}

{name === 'leaf' && (
  <svg class={className} width={s} height={s} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
