  </svg>
)}

{name === 'meat' && (
  <svg class={className} width={s} height={s} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M19 8c-1.5-2.5-4.5-3-7-1.5L6.5 10C4 11.5 3.5 14.5 5 17s4.5 3 7 1.5l5.5-3.5c2.5-1.5 3-4.5 1.5-7Z"></path>
    <circle cx="9" cy="14" r="1.5"></circle>
  </svg>
)}

{name === 'link' && (
  <svg class={className} width={s} height={s} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
  </svg>
)}
