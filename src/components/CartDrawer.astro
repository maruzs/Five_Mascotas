---
// CartDrawer.astro
import { defaultShippingRates } from '../data/pim/shipping';
import { formatMoney } from '../data/pim/catalog';
---

<dialog class="five-cart-dialog" aria-labelledby="five-cart-title" id="five-cart-modal">
  <div class="five-dialog-heading">
    <div class="five-dialog-title-wrap">
      <h2 id="five-cart-title">Tu Carrito FIVE</h2>
      <span class="five-dialog-subtitle">Alimentos y cuidados seleccionados</span>
    </div>
    <button data-close class="five-dialog-close" aria-label="Cerrar carrito">&times;</button>
  </div>

  <div class="five-dialog-body">
    <!-- Notice Talca Flat Rate -->
    <div class="five-cart-notice" style="background:#edf8e8; color:#2d5d1c; border:1px solid #cce9c2;">
      <span>🚚 <strong>Tarifa plana Talca:</strong> $1.500 · Entregas el mismo día para pedidos antes de las 14:00 hrs</span>
    </div>

    <!-- Product list -->
    <ul id="five-cart-items" class="five-cart-list">
      <!-- Items dynamically injected by store/cart script -->
    </ul>

    <!-- City Delivery Selector -->
    <div class="five-cart-shipping-select-wrap" style="background:#faf8fb; border:1px solid #e5dde9; border-radius:10px; padding:12px; margin-top:14px;">
      <label for="cart-city-select" style="font-size:12px; font-weight:750; color:#374151; display:block;">
        📍 Selecciona tu ciudad de despacho:
      </label>
      <select id="cart-city-select" class="five-select" style="width:100%; font-size:12.5px; padding:7px 10px; margin-top:6px; border-radius:6px;">
        {defaultShippingRates.map((r) => (
          <option value={r.id} selected={r.isDefault} data-price={r.price} data-note={r.deliveryNote}>
            {r.city} — {formatMoney(r.price)}
          </option>
        ))}
      </select>
      <small id="cart-city-note" style="display:block; font-size:11px; color:#276717; margin-top:5px; font-weight:600;">
        {defaultShippingRates[0].deliveryNote}
      </small>
    </div>
  </div>

  <div class="five-dialog-foot">
    <div class="five-cart-subtotals">
      <div class="five-cart-row">
        <span>Subtotal Productos</span>
        <strong id="five-total">$0</strong>
      </div>
      <div class="five-cart-row shipping">
        <span>Costo de Despacho</span>
        <span id="five-cart-shipping-fee" style="font-weight:750; color:#7025a8;">$1.500</span>
      </div>

      <!-- Grand Total Transferencia / Efectivo -->
      <div class="five-cart-row" style="border-top:1px dashed #e5dde9; padding-top:10px; margin-top:6px;">
        <div>
          <span style="font-weight:850; font-size:13.5px; display:block; color:#111827;">Total Transferencia / Efectivo</span>
          <small style="color:#276717; font-size:10.5px; font-weight:700;">★ Precio más conveniente</small>
        </div>
        <strong id="five-cart-grand-total" style="font-size:20px; color:#111827; font-weight:900;">$0</strong>
      </div>

      <!-- Grand Total Tarjeta Débito (+5%) -->
      <div class="five-cart-row">
        <span style="font-size:11.5px; color:#6b7280;">Total con Tarjeta Débito (+5%)</span>
        <strong id="five-cart-debit-total" style="font-size:14.5px; color:#4b5563; font-weight:750;">$0</strong>
      </div>
    </div>

    <div class="five-dialog-actions">
      <a href="/conoce-five#contacto" class="five-button five-checkout-btn" id="five-checkout-btn" style="text-align:center; justify-content:center;">
        Confirmar Pedido vía WhatsApp / Pago <span>↗</span>
      </a>
      <button type="button" class="five-text-btn" data-close>
        Seguir explorando
      </button>
    </div>
    <p class="five-cart-disclaimer">Horario de corte para envíos hoy en Talca: 14:00 hrs. Repartos desde las 15:00 hrs.</p>
  </div>
</dialog>
