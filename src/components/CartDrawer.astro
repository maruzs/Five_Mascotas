---
// CartDrawer.astro
import { defaultShippingRates } from '../data/pim/shipping';
import { formatMoney } from '../data/pim/catalog';
---

<dialog class="five-cart-dialog" aria-labelledby="five-cart-title" id="five-cart-modal">
  <div class="five-dialog-heading">
    <div class="five-dialog-title-wrap">
      <h2 id="five-cart-title">Tu Carrito FIVE</h2>
      <span class="five-dialog-subtitle">Alimentos y cuidados seleccionados</span>
    </div>
    <button data-close class="five-dialog-close" aria-label="Cerrar carrito">&times;</button>
  </div>

  <div class="five-dialog-body">
    <!-- Notice Talca Flat Rate -->
    <div class="five-cart-notice" style="background:#edf8e8; color:#2d5d1c; border:1px solid #cce9c2;">
      <span style="display:flex; align-items:center; gap:8px;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2d5d1c" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg><strong>Tarifa plana Talca:</strong> $1.500 · Entregas el mismo día para pedidos antes de las 14:00 hrs</span>
    </div>

    <!-- Product list -->
    <ul id="five-cart-items" class="five-cart-list">
      <!-- Items dynamically injected by store/cart script -->
    </ul>

    <!-- City Delivery Selector -->
    <div class="five-cart-shipping-select-wrap">
      <div class="five-cart-ship-head">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#7025a8" stroke-width="2" aria-hidden="true">
          <rect x="1" y="3" width="15" height="13"></rect>
          <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
          <circle cx="5.5" cy="18.5" r="2.5"></circle>
          <circle cx="18.5" cy="18.5" r="2.5"></circle>
        </svg>
        <label for="cart-city-select">
          Ciudad de despacho:
        </label>
      </div>
      <select id="cart-city-select" class="five-select" aria-label="Seleccionar ciudad de despacho">
        {defaultShippingRates.map((r) => (
          <option value={r.id} selected={r.isDefault} data-price={r.price} data-note={r.deliveryNote}>
            {r.city} — {formatMoney(r.price)}
          </option>
        ))}
      </select>
      <div class="five-cart-ship-feedback">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span id="cart-city-note">
          {defaultShippingRates[0].deliveryNote}
        </span>
      </div>
    </div>
  </div>

  <div class="five-dialog-foot">
    <div class="five-cart-subtotals">
      <div class="five-cart-row">
        <span>Subtotal Productos</span>
        <strong id="five-total">$0</strong>
      </div>
      <div class="five-cart-row shipping">
        <span>Costo de Despacho</span>
        <span id="five-cart-shipping-fee" style="font-weight:750; color:#7025a8;">$1.500</span>
      </div>

      <!-- Grand Total Transferencia / Efectivo -->
      <div class="five-cart-row" style="border-top:1px dashed #e5dde9; padding-top:10px; margin-top:6px;">
        <div>
          <span style="font-weight:850; font-size:13.5px; display:block; color:#111827;">Total Transferencia / Efectivo</span>
          <small style="color:#276717; font-size:10.5px; font-weight:700;">★ Precio más conveniente</small>
        </div>
        <strong id="five-cart-grand-total" style="font-size:20px; color:#111827; font-weight:900;">$0</strong>
      </div>

      <!-- Grand Total Tarjeta Débito (+5%) -->
      <div class="five-cart-row">
        <span style="font-size:11.5px; color:#6b7280;">Total con Tarjeta Débito (+5%)</span>
        <strong id="five-cart-debit-total" style="font-size:14.5px; color:#4b5563; font-weight:750;">$0</strong>
      </div>
    </div>

    <div class="five-dialog-actions">
      <button type="button" class="five-button five-checkout-btn" id="five-checkout-btn" style="text-align:center; justify-content:center; width:100%; border:none; cursor:pointer;">
        Continuar con el Pago (Transferencia / QR) ➔
      </button>
      <button type="button" class="five-text-btn" data-close>
        Seguir explorando
      </button>
    </div>
    <p class="five-cart-disclaimer">Horario de corte para envíos hoy en Talca: 14:00 hrs. Repartos desde las 15:00 hrs.</p>
    <div style="margin-top: 10px; padding: 10px 12px; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; text-align: center;">
      <span style="font-size: 11.5px; color: #166534; font-weight: 600; display: block; margin-bottom: 4px;">¿Compras al por mayor o para tu negocio?</span>
      <a href="https://wa.me/56964183605?text=Hola%2C%20quisiera%20cotizar%20compras%20al%20por%20mayor%20en%20FIVE%20Mascotas" target="_blank" rel="noopener noreferrer" style="color: #25d366; font-size: 12px; font-weight: 750; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="#25d366" aria-hidden="true"><path d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.83.5 3.54 1.37 5.01L2 22l5.16-1.35c1.42.78 3.03 1.21 4.88 1.21 5.52 0 10-4.48 10-10s-4.48-10-10-10zm5.84 14.16c-.24.68-1.4 1.34-1.95 1.39-.52.05-1.19.07-1.93-.16-.44-.14-1.02-.33-1.78-.66-3.13-1.36-5.17-4.52-5.33-4.73-.16-.21-1.28-1.7-1.28-3.24 0-1.54.81-2.3 1.09-2.61.29-.31.63-.39.84-.39.21 0 .42 0 .6.01.2 0 .46-.07.72.54.26.63.89 2.17.97 2.33.08.16.13.35.03.56-.1.21-.16.34-.31.52-.16.18-.33.4-.47.54-.16.16-.32.34-.14.65.18.31.81 1.34 1.74 2.17 1.19 1.06 2.2 1.39 2.51 1.55.31.16.5.13.68-.08.19-.21.8-1.01 1.02-1.36.21-.34.42-.29.7-.18.29.11 1.81.85 2.12 1 .31.16.52.24.59.37.07.13.07.76-.17 1.44z"/></svg>
        Cotiza directo por WhatsApp ➔
      </a>
    </div>
  </div>
</dialog>
