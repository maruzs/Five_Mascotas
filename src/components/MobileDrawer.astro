---
import { navigationCategories } from '../data/pim/navigation';
import Icon from './Icon.astro';
---

<div id="five-drawer-overlay" class="five-drawer-overlay" hidden></div>

<aside id="five-drawer" class="five-mobile-drawer" aria-label="Menú principal móvil" hidden>
  <div class="five-drawer-head">
    <div class="five-drawer-brand">
      <img src="/five-mascotas/logo.png" alt="FIVE" width="100" height="50" />
      <span>MASCOTAS</span>
    </div>
    <button id="five-drawer-close" class="five-drawer-close" aria-label="Cerrar menú">
      &times;
    </button>
  </div>

  <div class="five-drawer-content">
    <div class="five-drawer-search">
      <form action="/perros" method="get">
        <input type="search" name="q" placeholder="¿Qué necesita tu mascota?" />
        <button type="submit" aria-label="Buscar"><img src="/icons/lucide/search.svg" alt="" width="18" height="18" /></button>
      </form>
    </div>

    <!-- Quick Pet Switcher -->
    <div class="five-drawer-pets">
      <a href="/perros" class="five-drawer-pet-pill dog">
        <Icon name="dog" size={18} color="#7025A8" strokeWidth={2} />
        <span>Para Perros</span>
      </a>
      <a href="/gatos" class="five-drawer-pet-pill cat">
        <Icon name="cat" size={18} color="#7025A8" strokeWidth={2} />
        <span>Para Gatos</span>
      </a>
    </div>

    <!-- Navigation List with Accordions -->
    <nav class="five-drawer-nav">
      {navigationCategories.map((cat) => (
        <div class="five-drawer-section">
          {cat.hasDropdown && cat.sections ? (
            <details class="five-drawer-details">
              <summary class="five-drawer-summary">
                <span>{cat.name}</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </summary>
              <div class="five-drawer-sublist">
                <a href={cat.href} class="five-drawer-all-link">Ver todo en {cat.name} ↗</a>
                {cat.sections.map((sec) => (
                  <div class="five-drawer-subsec">
                    <strong>{sec.title}</strong>
                    <ul>
                      {sec.items.map((sub) => (
                        <li>
                          <a href={sub.href}>{sub.label}</a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </details>
          ) : (
            <a
              href={cat.href}
              class={`five-drawer-link ${cat.name === 'Ofertas' ? 'is-sale' : ''}`}
            >
              <span>{cat.name}</span>
              <span class="five-drawer-arrow">→</span>
            </a>
          )}
        </div>
      ))}
    </nav>

    <!-- Wholesale WhatsApp Quick Banner -->
    <div style="margin: 20px 14px 28px; padding: 14px; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 14px;">
      <div style="font-size: 11px; font-weight: 800; color: #166534; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px;">
        Ventas Mayoristas
      </div>
      <p style="font-size: 13px; font-weight: 600; color: #14532d; margin: 0 0 10px 0; line-height: 1.3;">
        ¿Quieres cotizar al por mayor? ¡Háblanos directo a WhatsApp!
      </p>
      <a
        href="https://wa.me/56964183605?text=Hola%2C%20quisiera%20cotizar%20compras%20al%20por%20mayor%20en%20FIVE%20Mascotas"
        target="_blank"
        rel="noopener noreferrer"
        style="display: flex; align-items: center; justify-content: center; gap: 8px; background: #25d366; color: #ffffff; padding: 10px 14px; border-radius: 10px; font-weight: 750; font-size: 13px; text-decoration: none;"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.83.5 3.54 1.37 5.01L2 22l5.16-1.35c1.42.78 3.03 1.21 4.88 1.21 5.52 0 10-4.48 10-10s-4.48-10-10-10zm5.84 14.16c-.24.68-1.4 1.34-1.95 1.39-.52.05-1.19.07-1.93-.16-.44-.14-1.02-.33-1.78-.66-3.13-1.36-5.17-4.52-5.33-4.73-.16-.21-1.28-1.7-1.28-3.24 0-1.54.81-2.3 1.09-2.61.29-.31.63-.39.84-.39.21 0 .42 0 .6.01.2 0 .46-.07.72.54.26.63.89 2.17.97 2.33.08.16.13.35.03.56-.1.21-.16.34-.31.52-.16.18-.33.4-.47.54-.16.16-.32.34-.14.65.18.31.81 1.34 1.74 2.17 1.19 1.06 2.2 1.39 2.51 1.55.31.16.5.13.68-.08.19-.21.8-1.01 1.02-1.36.21-.34.42-.29.7-.18.29.11 1.81.85 2.12 1 .31.16.52.24.59.37.07.13.07.76-.17 1.44z"/></svg>
        <span>Cotizar por WhatsApp</span>
      </a>
    </div>
  </div>
</aside>
