---
// src/components/WholesaleWhatsAppButton.astro
// Botón flotante de contacto comercial WhatsApp para cotizaciones al por mayor
// Diseño ergonómico, mobile-first, sin emojis, compatible con Rayo y MobileBottomNav.

interface Props {
  phone?: string;
  defaultMessage?: string;
}

const {
  phone = '56964183605',
  defaultMessage = 'Hola, quisiera cotizar compras al por mayor en FIVE Mascotas',
} = Astro.props;

const waUrl = `https://wa.me/${phone}?text=${encodeURIComponent(defaultMessage)}`;
---

<aside class="five-wholesale-wa-wrap" aria-label="Cotizaciones al por mayor">
  <a
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="five-wholesale-wa-btn"
    aria-label="¿Quieres cotizar al por mayor? ¡Háblanos por WhatsApp!"
  >
    <!-- Icono SVG Oficial WhatsApp -->
    <span class="five-wholesale-wa-icon-wrap" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" class="five-wholesale-wa-svg">
        <path d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.83.5 3.54 1.37 5.01L2 22l5.16-1.35c1.42.78 3.03 1.21 4.88 1.21 5.52 0 10-4.48 10-10s-4.48-10-10-10zm5.84 14.16c-.24.68-1.4 1.34-1.95 1.39-.52.05-1.19.07-1.93-.16-.44-.14-1.02-.33-1.78-.66-3.13-1.36-5.17-4.52-5.33-4.73-.16-.21-1.28-1.7-1.28-3.24 0-1.54.81-2.3 1.09-2.61.29-.31.63-.39.84-.39.21 0 .42 0 .6.01.2 0 .46-.07.72.54.26.63.89 2.17.97 2.33.08.16.13.35.03.56-.1.21-.16.34-.31.52-.16.18-.33.4-.47.54-.16.16-.32.34-.14.65.18.31.81 1.34 1.74 2.17 1.19 1.06 2.2 1.39 2.51 1.55.31.16.5.13.68-.08.19-.21.8-1.01 1.02-1.36.21-.34.42-.29.7-.18.29.11 1.81.85 2.12 1 .31.16.52.24.59.37.07.13.07.76-.17 1.44z"/>
      </svg>
      <span class="five-wholesale-wa-beacon" aria-hidden="true"></span>
    </span>

    <!-- Textos responsivos -->
    <span class="five-wholesale-wa-content">
      <span class="five-wholesale-wa-tag">Mayoristas</span>
      <span class="five-wholesale-wa-label desktop-label">¿Quieres cotizar al por mayor? ¡Háblanos!</span>
      <span class="five-wholesale-wa-label mobile-label">¿Cotizar por mayor? ¡Háblanos!</span>
    </span>

    <!-- Flecha sutil de acción externa -->
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="five-wholesale-wa-arrow" aria-hidden="true">
      <line x1="7" y1="17" x2="17" y2="7"></line>
      <polyline points="7 7 17 7 17 17"></polyline>
    </svg>
  </a>
</aside>

<style>
  .five-wholesale-wa-wrap {
    position: fixed;
    bottom: 84px;
    left: 16px;
    z-index: 1040;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .five-wholesale-wa-wrap {
      bottom: 28px;
      left: 28px;
    }
  }

  .five-wholesale-wa-btn {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 46px;
    padding: 8px 16px 8px 10px;
    background: #25d366;
    color: #ffffff;
    text-decoration: none;
    border-radius: 9999px;
    box-shadow: 0 4px 16px rgba(37, 211, 102, 0.35), 0 2px 6px rgba(0, 0, 0, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease, background 0.2s ease;
    max-width: calc(100vw - 110px);
    box-sizing: border-box;
  }

  .five-wholesale-wa-btn:hover {
    background: #20ba56;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.45), 0 4px 10px rgba(0, 0, 0, 0.15);
  }

  .five-wholesale-wa-btn:active {
    transform: scale(0.98);
  }

  .five-wholesale-wa-btn:focus-visible {
    outline: 3px solid #7025a8;
    outline-offset: 3px;
  }

  .five-wholesale-wa-icon-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: #ffffff;
    color: #25d366;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .five-wholesale-wa-svg {
    width: 20px;
    height: 20px;
  }

  .five-wholesale-wa-beacon {
    position: absolute;
    top: -1px;
    right: -1px;
    width: 8px;
    height: 8px;
    background: #94f963;
    border: 1.5px solid #25d366;
    border-radius: 50%;
    animation: wa-beacon-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes wa-beacon-pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.6;
      transform: scale(1.25);
    }
  }

  .five-wholesale-wa-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.15;
  }

  .five-wholesale-wa-tag {
    font-size: 9.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.9);
  }

  .five-wholesale-wa-label {
    font-size: 13px;
    font-weight: 750;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .desktop-label {
    display: none;
  }

  .mobile-label {
    display: block;
  }

  @media (min-width: 640px) {
    .desktop-label {
      display: block;
    }
    .mobile-label {
      display: none;
    }
    .five-wholesale-wa-btn {
      max-width: none;
      padding: 9px 18px 9px 12px;
    }
  }

  .five-wholesale-wa-arrow {
    flex-shrink: 0;
    opacity: 0.85;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .five-wholesale-wa-btn:hover .five-wholesale-wa-arrow {
    transform: translate(2px, -2px);
    opacity: 1;
  }
</style>
