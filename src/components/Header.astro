---
// Header.astro
---

<header class="five-main-header">
  <div class="five-wrap five-header-row">
    <!-- Mobile hamburger button -->
    <button class="five-mobile-menu-btn" id="five-drawer-open" aria-label="Abrir menú de navegación">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <!-- Brand Logo -->
    <a class="five-logo" href="/" aria-label="FIVE, ir al inicio">
      <img src="/five-mascotas/logo.png" alt="FIVE" width="1774" height="887" />
    </a>

    <!-- Predictive Search Bar -->
    <div class="five-search-wrapper">
      <form class="five-search" role="search" id="five-search-form" action="/perros">
        <label class="sr-only" for="five-search">Buscar productos y marcas</label>
        <input
          id="five-search"
          type="search"
          name="q"
          maxlength="100"
          placeholder="Busca tus marcas y productos favoritos..."
          autocomplete="off"
        />
        <button type="submit" aria-label="Buscar productos">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
      </form>

      <!-- Live Search Suggestions Container -->
      <div id="five-search-dropdown" class="five-search-dropdown" hidden>
        <div class="five-search-dropdown-header">Sugerencias rápidas</div>
        <ul id="five-search-results-list" class="five-search-results-list"></ul>
      </div>
    </div>

    <!-- Header Actions (Desktop & Mobile) -->
    <div class="five-header-actions">
      <!-- Sucursales / Horarios -->
      <a href="/conoce-five" class="five-header-action-item five-hide-mobile" title="Horarios y atención">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        <span>
          <small>Tienda física</small>
          <strong>Horarios</strong>
        </span>
      </a>

      <!-- Mi Cuenta -->
      <a href="/mi-cuenta" class="five-header-action-item five-hide-mobile" title="Mi Cuenta FIVE">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
        <span>
          <small>Bienvenido</small>
          <strong>Mi Cuenta</strong>
        </span>
      </a>

      <!-- Cart Button -->
      <button class="five-basket" aria-haspopup="dialog" data-basket id="five-header-basket" aria-label="Abrir carrito de compras">
        <div class="five-basket-icon-wrap">
          <img src="/icons/lucide/shopping-bag.svg" alt="" width="22" height="22" />
          <b id="five-cart-count" class="five-cart-badge">0</b>
        </div>
        <div class="five-basket-text five-hide-mobile">
          <small>Tu compra</small>
          <strong id="five-header-cart-total">$0</strong>
        </div>
      </button>
    </div>
  </div>
</header>
