---
// src/components/RayoAssistantWidget.astro
// Asistente Nutricional "Rayo · Experto Nutricional" para FIVE Mascotas
// Diseño profesional Anti-Vibecoding: Cero degradados en imagen, cero emojis, iconografía SVG corporativa.
---

<div id="rayo-widget-root" class="rayo-widget-container" data-astro-rerun>
  <!-- Botón Lanzador Flotante Circular (Sin degradados, avatar limpio) -->
  <button
    id="rayo-launcher-btn"
    type="button"
    class="rayo-launcher"
    aria-label="Abrir Asistente Nutricional Rayo"
    aria-haspopup="dialog"
    aria-expanded="false"
  >
    <div class="rayo-launcher-avatar-wrap">
      <img
        src="/images/Rayo-Bot.png"
        alt="Rayo · Asistente Nutricional"
        class="rayo-launcher-avatar"
        width="56"
        height="56"
        loading="eager"
      />
      <span class="rayo-status-dot" aria-hidden="true"></span>
    </div>
    <span class="rayo-launcher-pill-badge">Rayo IA</span>
  </button>

  <!-- Ventana / Modal del Asistente -->
  <div
    id="rayo-modal"
    class="rayo-modal"
    role="dialog"
    aria-labelledby="rayo-modal-title"
    aria-modal="true"
    hidden
  >
    <!-- Header Profesional (Limpio, sobrio, tipografía editorial) -->
    <header class="rayo-header">
      <div class="rayo-header-info">
        <div class="rayo-header-avatar-wrap">
          <img
            src="/images/Rayo-Bot.png"
            alt="Rayo"
            class="rayo-header-avatar"
            width="42"
            height="42"
          />
        </div>
        <div class="rayo-header-text">
          <div class="rayo-header-status-row">
            <h2 id="rayo-modal-title" class="rayo-header-title">Rayo</h2>
            <span class="rayo-online-tag">
              <span class="rayo-online-dot"></span>
              En línea
            </span>
          </div>
          <p class="rayo-header-subtitle">
            Experto nutricional para <strong>perros y gatos</strong>
          </p>
        </div>
      </div>
      <button
        id="rayo-close-btn"
        type="button"
        class="rayo-close-btn"
        aria-label="Cerrar asistente nutricional"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </header>

    <!-- Pestañas de Modo con Icon Pack SVG Oficial -->
    <nav class="rayo-tabs" aria-label="Secciones del Asistente">
      <button type="button" class="rayo-tab-btn active" data-tab="chat">
        <svg class="rayo-tab-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        <span>Consultas</span>
      </button>
      <button type="button" class="rayo-tab-btn" data-tab="portion">
        <svg class="rayo-tab-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 16l3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1z"></path>
          <path d="M2 16l3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1z"></path>
          <path d="M7 21h10"></path>
          <path d="M12 3v18"></path>
          <path d="M3 7h18"></path>
        </svg>
        <span>Porción Diaria</span>
      </button>
      <button type="button" class="rayo-tab-btn" data-tab="farma">
        <svg class="rayo-tab-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"></path>
          <path d="m8.5 8.5 7 7"></path>
        </svg>
        <span>Antiparasitarios</span>
      </button>
    </nav>

    <!-- Contenido de Pestaña: CONSULTAS / CHAT -->
    <div id="rayo-tab-chat" class="rayo-tab-panel active">
      <!-- Feed de Conversación -->
      <div id="rayo-messages-feed" class="rayo-feed">
        <!-- Mensaje Inicial de Rayo -->
        <div class="rayo-msg rayo-msg-bot">
          <img src="/images/Rayo-Bot.png" alt="Rayo" class="rayo-msg-avatar" width="28" height="28" />
          <div class="rayo-msg-bubble">
            <p>
              Hola, soy <strong>Rayo</strong>, asesor nutricional de FIVE Mascotas.
            </p>
            <p>
              Puedo orientarte sobre calidad de ingredientes, requerimientos proteicos, porciones según peso y antiparasitarios oficiales para perros y gatos.
            </p>
          </div>
        </div>

        <!-- Sugerencias Rápidas con SVG Icons -->
        <div class="rayo-quick-suggestions" id="rayo-suggestions">
          <span class="rayo-suggestions-title">Temas frecuentes:</span>
          <div class="rayo-chips-wrap">
            <button type="button" class="rayo-chip" data-query="¿Qué diferencia hay entre un alimento con grano y uno Grain Free?">
              Cereales vs Grain Free
            </button>
            <button type="button" class="rayo-chip" data-query="¿Cómo evaluar la calidad del primer ingrediente en la etiqueta?">
              Calidad del primer ingrediente
            </button>
            <button type="button" class="rayo-chip" data-query="¿Por qué los gatos requieren mayor proteína animal que los perros?">
              Proteína en felinos vs caninos
            </button>
            <button type="button" class="rayo-chip" data-query="¿Cómo hacer una transición gradual de alimento sin malestar estomacal?">
              Transición gradual de alimento
            </button>
          </div>
        </div>
      </div>

      <!-- Barra de Entrada -->
      <form id="rayo-chat-form" class="rayo-input-form">
        <input
          type="text"
          id="rayo-chat-input"
          class="rayo-input"
          placeholder="Escribe tu consulta sobre alimentos, ingredientes o dosis..."
          maxlength="300"
          autocomplete="off"
          required
        />
        <button type="submit" id="rayo-send-btn" class="rayo-send-btn" aria-label="Enviar consulta">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
        </button>
      </form>
    </div>

    <!-- Contenido de Pestaña: CALCULADORA DE PORCIÓN -->
    <div id="rayo-tab-portion" class="rayo-tab-panel" hidden>
      <form id="rayo-portion-form" class="rayo-calc-form">
        <div class="rayo-form-group">
          <label class="rayo-label">Especie:</label>
          <div class="rayo-radio-pills">
            <label class="rayo-pill-label">
              <input type="radio" name="portion-species" value="perro" checked />
              <span class="rayo-pill-content">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10 5.172a2 2 0 0 0-3.414-1.414l-3.172 3.172a2 2 0 0 0 0 2.828l1.414 1.414"></path>
                  <path d="M14 5.172a2 2 0 0 1 3.414-1.414l3.172 3.172a2 2 0 0 1 0 2.828l-1.414 1.414"></path>
                  <path d="M6 12a6 6 0 1 0 12 0 6 6 0 0 0-12 0Z"></path>
                  <circle cx="9" cy="11" r="1" fill="currentColor"></circle>
                  <circle cx="15" cy="11" r="1" fill="currentColor"></circle>
                  <path d="M11 15h2"></path>
                </svg>
                Canino (Perro)
              </span>
            </label>
            <label class="rayo-pill-label">
              <input type="radio" name="portion-species" value="gato" />
              <span class="rayo-pill-content">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 5c-3.87 0-7 3.13-7 7 0 2.87 1.74 5.34 4.24 6.42L12 21l2.76-2.58C17.26 17.34 19 14.87 19 12c0-3.87-3.13-7-7-7Z"></path>
                  <path d="M5 8 3 3l5 2"></path>
                  <path d="M19 8l2-5-5 2"></path>
                  <circle cx="9" cy="12" r="1" fill="currentColor"></circle>
                  <circle cx="15" cy="12" r="1" fill="currentColor"></circle>
                </svg>
                Felino (Gato)
              </span>
            </label>
          </div>
        </div>

        <div class="rayo-form-row">
          <div class="rayo-form-group">
            <label class="rayo-label" for="portion-weight">Peso actual (kg):</label>
            <input
              type="number"
              id="portion-weight"
              class="rayo-input-number"
              min="0.5"
              max="90"
              step="0.5"
              value="12"
              required
            />
          </div>

          <div class="rayo-form-group">
            <label class="rayo-label" for="portion-stage">Etapa de vida:</label>
            <select id="portion-stage" class="rayo-select">
              <option value="adulto">Adulto</option>
              <option value="cachorro">Cachorro / Gatito</option>
              <option value="senior">Senior (+7 años)</option>
              <option value="esterilizado">Esterilizado / Castrado</option>
            </select>
          </div>
        </div>

        <div class="rayo-form-group">
          <label class="rayo-label" for="portion-activity">Nivel de actividad:</label>
          <select id="portion-activity" class="rayo-select">
            <option value="normal">Normal (actividad moderada)</option>
            <option value="baja">Baja (sedentario / sobrepeso)</option>
            <option value="alta">Alta (muy activo / trabajo)</option>
          </select>
        </div>

        <button type="submit" class="rayo-action-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
          Calcular Ración Diaria
        </button>
      </form>

      <div id="rayo-portion-result" class="rayo-result-card" hidden></div>
    </div>

    <!-- Contenido de Pestaña: ANTIPARASITARIOS -->
    <div id="rayo-tab-farma" class="rayo-tab-panel" hidden>
      <form id="rayo-farma-form" class="rayo-calc-form">
        <p class="rayo-tab-desc">
          Opciones oficiales homologadas en el catálogo de FIVE según rango de peso corporal.
        </p>

        <div class="rayo-form-group">
          <label class="rayo-label">Especie:</label>
          <div class="rayo-radio-pills">
            <label class="rayo-pill-label">
              <input type="radio" name="farma-species" value="perro" checked />
              <span class="rayo-pill-content">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10 5.172a2 2 0 0 0-3.414-1.414l-3.172 3.172a2 2 0 0 0 0 2.828l1.414 1.414"></path>
                  <path d="M14 5.172a2 2 0 0 1 3.414-1.414l3.172 3.172a2 2 0 0 1 0 2.828l-1.414 1.414"></path>
                  <path d="M6 12a6 6 0 1 0 12 0 6 6 0 0 0-12 0Z"></path>
                  <circle cx="9" cy="11" r="1" fill="currentColor"></circle>
                  <circle cx="15" cy="11" r="1" fill="currentColor"></circle>
                  <path d="M11 15h2"></path>
                </svg>
                Perro
              </span>
            </label>
            <label class="rayo-pill-label">
              <input type="radio" name="farma-species" value="gato" />
              <span class="rayo-pill-content">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 5c-3.87 0-7 3.13-7 7 0 2.87 1.74 5.34 4.24 6.42L12 21l2.76-2.58C17.26 17.34 19 14.87 19 12c0-3.87-3.13-7-7-7Z"></path>
                  <path d="M5 8 3 3l5 2"></path>
                  <path d="M19 8l2-5-5 2"></path>
                  <circle cx="9" cy="12" r="1" fill="currentColor"></circle>
                  <circle cx="15" cy="12" r="1" fill="currentColor"></circle>
                </svg>
                Gato
              </span>
            </label>
          </div>
        </div>

        <div class="rayo-form-group">
          <label class="rayo-label" for="farma-weight">Peso exacto de la mascota (kg):</label>
          <div class="rayo-input-with-addon">
            <input
              type="number"
              id="farma-weight"
              class="rayo-input-number"
              min="0.5"
              max="90"
              step="0.5"
              value="8"
              required
            />
            <span class="rayo-addon">kg</span>
          </div>
        </div>

        <button type="submit" class="rayo-action-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          Buscar Presentación Indicada
        </button>
      </form>

      <div id="rayo-farma-result" class="rayo-result-card" hidden></div>
    </div>

    <!-- Footer con Icono SVG Institucional (Cero Emojis) -->
    <footer class="rayo-footer">
      <svg class="rayo-footer-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
      </svg>
      <span>Información técnica basada en fichas PIM. En condiciones clínicas, consulta a tu médico veterinario.</span>
    </footer>
  </div>
</div>

<script>
  // Script del Asistente Rayo
  const root = document.querySelector<HTMLElement>('#rayo-widget-root');
  if (root) {
    const launcherBtn = root.querySelector<HTMLButtonElement>('#rayo-launcher-btn');
    const modal = root.querySelector<HTMLElement>('#rayo-modal');
    const closeBtn = root.querySelector<HTMLButtonElement>('#rayo-close-btn');

    const tabs = root.querySelectorAll<HTMLButtonElement>('.rayo-tab-btn');
    const panels: Record<string, HTMLElement | null> = {
      chat: root.querySelector<HTMLElement>('#rayo-tab-chat'),
      portion: root.querySelector<HTMLElement>('#rayo-tab-portion'),
      farma: root.querySelector<HTMLElement>('#rayo-tab-farma'),
    };

    // Chat elements
    const chatForm = root.querySelector<HTMLFormElement>('#rayo-chat-form');
    const chatInput = root.querySelector<HTMLInputElement>('#rayo-chat-input');
    const messagesFeed = root.querySelector<HTMLElement>('#rayo-messages-feed');
    const suggestionsWrap = root.querySelector<HTMLElement>('#rayo-suggestions');

    // Portion elements
    const portionForm = root.querySelector<HTMLFormElement>('#rayo-portion-form');
    const portionResult = root.querySelector<HTMLElement>('#rayo-portion-result');

    // Farma elements
    const farmaForm = root.querySelector<HTMLFormElement>('#rayo-farma-form');
    const farmaResult = root.querySelector<HTMLElement>('#rayo-farma-result');

    // Toggle Modal
    const openModal = (defaultTab?: string) => {
      if (!modal) return;
      modal.hidden = false;
      modal.classList.add('is-open');
      launcherBtn?.setAttribute('aria-expanded', 'true');
      if (defaultTab) switchTab(defaultTab);
      if (defaultTab === 'chat' || !defaultTab) {
        setTimeout(() => chatInput?.focus(), 150);
      }
    };

    const closeModal = () => {
      if (!modal) return;
      modal.classList.remove('is-open');
      modal.hidden = true;
      launcherBtn?.setAttribute('aria-expanded', 'false');
    };

    launcherBtn?.addEventListener('click', () => {
      if (modal?.hidden) openModal();
      else closeModal();
    });

    closeBtn?.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal?.hidden) closeModal();
    });

    // Escuchar evento global para abrir Rayo desde cualquier parte de la tienda
    window.addEventListener('five:open-rayo', ((e: CustomEvent) => {
      const mode = e.detail?.mode || 'chat';
      openModal(mode);
      if (mode === 'chat' && e.detail?.query) {
        if (chatInput) chatInput.value = e.detail.query;
        chatForm?.dispatchEvent(new Event('submit'));
      }
    }) as EventListener);

    // Switch Tabs
    const switchTab = (targetKey: string) => {
      tabs.forEach((tab) => {
        const isMatch = tab.dataset.tab === targetKey;
        tab.classList.toggle('active', isMatch);
        tab.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });

      Object.entries(panels).forEach(([key, panel]) => {
        if (!panel) return;
        if (key === targetKey) {
          panel.hidden = false;
          panel.classList.add('active');
        } else {
          panel.hidden = true;
          panel.classList.remove('active');
        }
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.tab;
        if (target) switchTab(target);
      });
    });

    // Helper para formatear Markdown simple a HTML seguro sin emojis
    const formatMarkdown = (text: string): string => {
      let escaped = text
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');

      // Limpieza de cualquier emoji residual en la respuesta
      escaped = escaped.replace(/[\u{1F600}-\u{1F64F}\u{1F300}-\u{1F5FF}\u{1F680}-\u{1F6FF}\u{1F700}-\u{1F77F}\u{1F780}-\u{1F7FF}\u{1F800}-\u{1F8FF}\u{1F900}-\u{1F9FF}\u{1FA00}-\u{1FA6F}\u{1FA70}-\u{1FAFF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}]/gu, '');

      // Headers
      escaped = escaped.replace(/^### (.*$)/gim, '<h4 class="rayo-md-h4">$1</h4>');
      escaped = escaped.replace(/^#### (.*$)/gim, '<h5 class="rayo-md-h5">$1</h5>');

      // Bold & Italic
      escaped = escaped.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
      escaped = escaped.replace(/\*(.*?)\*/g, '<em>$1</em>');

      // Blockquotes
      escaped = escaped.replace(/^> (.*$)/gim, '<blockquote class="rayo-md-quote">$1</blockquote>');

      // Lists
      escaped = escaped.replace(/^\s*-\s+(.*$)/gim, '<li class="rayo-md-li">$1</li>');
      escaped = escaped.replace(/(<li.*<\/li>)/s, '<ul class="rayo-md-ul">$1</ul>');

      // Line breaks
      escaped = escaped.replace(/\n\n+/g, '<p class="rayo-md-p"></p>');
      escaped = escaped.replace(/\n/g, '<br/>');

      return escaped;
    };

    // Agregar mensaje al feed de chat
    const appendMessage = (sender: 'bot' | 'user', text: string) => {
      if (!messagesFeed) return;
      const isBot = sender === 'bot';
      const msgDiv = document.createElement('div');
      msgDiv.className = `rayo-msg rayo-msg-${sender}`;

      const avatarHtml = isBot
        ? `<img src="/images/Rayo-Bot.png" alt="Rayo" class="rayo-msg-avatar" width="28" height="28" />`
        : `<div class="rayo-user-avatar">Tú</div>`;

      const bodyHtml = isBot ? formatMarkdown(text) : `<p>${text.replace(/</g, '&lt;')}</p>`;

      msgDiv.innerHTML = `
        ${avatarHtml}
        <div class="rayo-msg-bubble">
          ${bodyHtml}
        </div>
      `;

      messagesFeed.appendChild(msgDiv);
      messagesFeed.scrollTop = messagesFeed.scrollHeight;
    };

    // Indicador de escritura
    const appendTyping = (): HTMLElement => {
      const typingDiv = document.createElement('div');
      typingDiv.className = 'rayo-msg rayo-msg-bot rayo-typing-msg';
      typingDiv.id = 'rayo-typing-indicator';
      typingDiv.innerHTML = `
        <img src="/images/Rayo-Bot.png" alt="Rayo" class="rayo-msg-avatar" width="28" height="28" />
        <div class="rayo-msg-bubble rayo-typing-bubble">
          <span></span><span></span><span></span>
        </div>
      `;
      messagesFeed?.appendChild(typingDiv);
      if (messagesFeed) messagesFeed.scrollTop = messagesFeed.scrollHeight;
      return typingDiv;
    };

    const removeTyping = () => {
      const ind = root.querySelector('#rayo-typing-indicator');
      ind?.remove();
    };

    // Chat submit handler
    chatForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const val = (chatInput?.value || '').trim();
      if (!val) return;

      appendMessage('user', val);
      if (chatInput) chatInput.value = '';
      if (suggestionsWrap) suggestionsWrap.style.display = 'none';

      appendTyping();

      try {
        const resp = await fetch('/api/chat-nutricional', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            query: val,
            mode: 'chat',
          }),
        });

        const data = await resp.json();
        removeTyping();

        if (data.ok && data.answer) {
          appendMessage('bot', data.answer);
        } else {
          appendMessage('bot', data.error || 'No fue posible procesar la consulta en este momento.');
        }
      } catch (err) {
        removeTyping();
        appendMessage('bot', 'Error de conexión con el servidor.');
      }
    });

    // Manejar clics en sugerencias
    root.querySelectorAll<HTMLButtonElement>('.rayo-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const q = chip.dataset.query;
        if (q && chatInput) {
          chatInput.value = q;
          chatForm?.dispatchEvent(new Event('submit'));
        }
      });
    });

    // Manejar submit de Calculadora de Porción
    portionForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const species = (portionForm.querySelector<HTMLInputElement>('input[name="portion-species"]:checked')?.value || 'perro') as string;
      const weight = parseFloat((portionForm.querySelector<HTMLInputElement>('#portion-weight')?.value || '10'));
      const stage = (portionForm.querySelector<HTMLSelectElement>('#portion-stage')?.value || 'adulto') as string;
      const activity = (portionForm.querySelector<HTMLSelectElement>('#portion-activity')?.value || 'normal') as string;

      if (!portionResult) return;
      portionResult.hidden = false;
      portionResult.innerHTML = `
        <div class="rayo-loading-box">
          <div class="rayo-spinner"></div>
          <span>Calculando requerimiento calórico...</span>
        </div>
      `;

      try {
        const resp = await fetch('/api/chat-nutricional', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            mode: 'portion',
            petProfile: {
              species,
              weightKg: weight,
              lifeStage: stage,
              activityLevel: activity,
            },
          }),
        });

        const data = await resp.json();
        if (data.ok && data.answer) {
          portionResult.innerHTML = `
            <div class="rayo-result-body">
              ${formatMarkdown(data.answer)}
            </div>
          `;
        } else {
          portionResult.innerHTML = `<div class="rayo-error-msg">${data.error || 'No se pudo calcular la porción.'}</div>`;
        }
      } catch {
        portionResult.innerHTML = `<div class="rayo-error-msg">Error de conexión al calcular la porción.</div>`;
      }
    });

    // Manejar submit de Antiparasitarios
    farmaForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const species = (farmaForm.querySelector<HTMLInputElement>('input[name="farma-species"]:checked')?.value || 'perro') as string;
      const weight = parseFloat((farmaForm.querySelector<HTMLInputElement>('#farma-weight')?.value || '8'));

      if (!farmaResult) return;
      farmaResult.hidden = false;
      farmaResult.innerHTML = `
        <div class="rayo-loading-box">
          <div class="rayo-spinner"></div>
          <span>Buscando en catálogo oficial de farmacia...</span>
        </div>
      `;

      try {
        const resp = await fetch('/api/chat-nutricional', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            mode: 'antiparasitic',
            petProfile: {
              species,
              weightKg: weight,
            },
          }),
        });

        const data = await resp.json();
        if (data.ok && data.answer) {
          farmaResult.innerHTML = `
            <div class="rayo-result-body">
              ${formatMarkdown(data.answer)}
            </div>
          `;
        } else {
          farmaResult.innerHTML = `<div class="rayo-error-msg">${data.error || 'No se encontraron registros de antiparasitarios.'}</div>`;
        }
      } catch {
        farmaResult.innerHTML = `<div class="rayo-error-msg">Error de conexión al consultar antiparasitarios.</div>`;
      }
    });
  }
</script>

