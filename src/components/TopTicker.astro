---
import { announcementTickers } from '../data/pim/navigation';

const initialTickers = announcementTickers.filter((t) => t.active);
---

<aside class="five-top-ticker" id="five-top-ticker" aria-label="Aviso promocional superior">
  <div class="five-wrap" style="position: relative;">
    <div class="five-ticker-viewport" id="five-ticker-viewport">
      {initialTickers.map((t, idx) => (
        <div class={`five-ticker-slide-item ${idx === 0 ? 'is-active' : ''}`} data-ticker-slide={idx}>
          <span class="five-ticker-bold">{t.text}</span>
          {t.couponCode && (
            <span class="five-ticker-pill">
              {t.couponText || 'Usa el código'} <strong>{t.couponCode}</strong>
            </span>
          )}
          {t.extraInfo && (
            <span class="five-ticker-extra five-hide-mobile">· {t.extraInfo}</span>
          )}
        </div>
      ))}
    </div>

    <!-- Subtle carousel indicator dots (sin flechitas) -->
    <div class="five-ticker-dots-nav" id="five-ticker-dots" style={initialTickers.length > 1 ? "display: flex;" : "display: none;"}>
      {initialTickers.map((_, idx) => (
        <button
          type="button"
          class={`five-ticker-dot ${idx === 0 ? 'is-active' : ''}`}
          data-dot={idx}
          aria-label={`Ver aviso ${idx + 1}`}
        />
      ))}
    </div>
  </div>
</aside>

<script>
  import { AdminStoreService } from '../scripts/admin-store';
  import type { AnnouncementTicker } from '../data/pim/types';

  const container = document.querySelector<HTMLElement>('#five-top-ticker');
  const viewport = document.querySelector<HTMLElement>('#five-ticker-viewport');
  const dotsContainer = document.querySelector<HTMLElement>('#five-ticker-dots');

  let activeTickers: AnnouncementTicker[] = [];
  let currentIndex = 0;
  let timer: any = null;
  let isPaused = false;

  const renderSlides = () => {
    if (!viewport || !dotsContainer) return;
    if (activeTickers.length === 0) {
      if (container) container.style.display = 'none';
      return;
    }
    if (container) container.style.display = 'block';

    viewport.innerHTML = '';
    dotsContainer.innerHTML = '';

    activeTickers.forEach((t, idx) => {
      // Slide element
      const slide = document.createElement('div');
      slide.className = `five-ticker-slide-item ${idx === currentIndex ? 'is-active' : ''}`;
      slide.dataset.tickerSlide = String(idx);

      const pillHtml = t.couponCode
        ? `<span class="five-ticker-pill">${t.couponText || 'Usa el código'} <strong>${t.couponCode}</strong></span>`
        : '';
      const extraHtml = t.extraInfo
        ? `<span class="five-ticker-extra five-hide-mobile">· ${t.extraInfo}</span>`
        : '';

      slide.innerHTML = `
        <span class="five-ticker-bold">${t.text}</span>
        ${pillHtml}
        ${extraHtml}
      `;
      viewport.appendChild(slide);

      // Dot element (only if multiple tickers)
      if (activeTickers.length > 1) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = `five-ticker-dot ${idx === currentIndex ? 'is-active' : ''}`;
        dot.setAttribute('aria-label', `Ver aviso ${idx + 1}`);
        dot.addEventListener('click', () => {
          goToSlide(idx);
        });
        dotsContainer.appendChild(dot);
      }
    });

    dotsContainer.style.display = activeTickers.length > 1 ? 'flex' : 'none';
  };

  const goToSlide = (index: number) => {
    if (activeTickers.length <= 1) return;
    currentIndex = (index + activeTickers.length) % activeTickers.length;

    const slides = viewport?.querySelectorAll('.five-ticker-slide-item');
    slides?.forEach((s, idx) => {
      s.classList.toggle('is-active', idx === currentIndex);
    });

    const dots = dotsContainer?.querySelectorAll('.five-ticker-dot');
    dots?.forEach((d, idx) => {
      d.classList.toggle('is-active', idx === currentIndex);
    });
  };

  const nextSlide = () => {
    goToSlide(currentIndex + 1);
  };

  const prevSlide = () => {
    goToSlide(currentIndex - 1);
  };

  const startTimer = () => {
    stopTimer();
    if (activeTickers.length > 1) {
      timer = setInterval(() => {
        if (!isPaused) {
          nextSlide();
        }
      }, 4500);
    }
  };

  const stopTimer = () => {
    if (timer) {
      clearInterval(timer);
      timer = null;
    }
  };

  const refreshTickers = () => {
    const list = AdminStoreService.getTickers();
    activeTickers = list.filter((t) => t.active);
    if (currentIndex >= activeTickers.length) {
      currentIndex = 0;
    }
    renderSlides();
    startTimer();
  };

  // Pause on hover
  container?.addEventListener('mouseenter', () => {
    isPaused = true;
  });

  container?.addEventListener('mouseleave', () => {
    isPaused = false;
  });

  // Mobile swipe support
  let touchStartX = 0;
  let touchStartY = 0;
  container?.addEventListener('touchstart', (e) => {
    touchStartX = e.changedTouches[0].screenX;
    touchStartY = e.changedTouches[0].screenY;
    isPaused = true;
  }, { passive: true });

  container?.addEventListener('touchend', (e) => {
    const touchEndX = e.changedTouches[0].screenX;
    const touchEndY = e.changedTouches[0].screenY;
    const diffX = touchStartX - touchEndX;
    const diffY = touchStartY - touchEndY;

    // Horizontal swipe or vertical swipe
    if (Math.abs(diffX) > 40 && Math.abs(diffX) > Math.abs(diffY)) {
      if (diffX > 0) nextSlide();
      else prevSlide();
    } else if (Math.abs(diffY) > 30) {
      if (diffY > 0) nextSlide();
      else prevSlide();
    }

    isPaused = false;
  }, { passive: true });

  // Reactive sync with CMS
  window.addEventListener('five:cms-updated', refreshTickers);

  // Initial load
  AdminStoreService.init().then(refreshTickers);
</script>
