---
// Footer.astro
---

<footer class="five-footer">
  <div class="five-wrap five-footer-grid">
    <div class="five-footer-brand-col">
      <a class="five-logo" href="/" aria-label="FIVE Mascotas, inicio">
        <img src="/five-mascotas/logo.png" alt="FIVE Mascotas" width="160" height="80" loading="lazy" />
        <span class="five-logo-sub">MASCOTAS</span>
      </a>
      <p class="five-footer-tagline">
        Pequeños gestos cotidianos.<br />
        <strong>Grandes compañeros para toda la vida.</strong>
      </p>
      <div class="five-footer-contact">
        <span style="display:flex; align-items:center; gap:6px;"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#7025A8" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg> Santiago, Chile</span>
        <span style="display:flex; align-items:center; gap:6px;"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#7025A8" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg> Lun a Sáb: 10:00 - 20:00 hrs</span>
        <span style="display:flex; align-items:center; gap:6px;"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#7025A8" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg> contacto@fivemascotas.cl</span>
      </div>
    </div>

    <div class="five-footer-nav-col">
      <h4>Mascotas</h4>
      <nav aria-label="Enlaces por mascota">
        <a href="/perros">Alimentos para perros</a>
        <a href="/perros">Accesorios caninos</a>
        <a href="/gatos">Alimentos para gatos</a>
        <a href="/gatos">Arenas y accesorios felinos</a>
        <a href="/ofertas">Ofertas y promociones</a>
      </nav>
    </div>

    <div class="five-footer-nav-col">
      <h4>Departamentos</h4>
      <nav aria-label="Enlaces por departamento">
        <a href="/alimentos">Alimentos</a>
        <a href="/farmacia">Farmacia y Salud</a>
        <a href="/accesorios">Accesorios y Paseo</a>
        <a href="/higiene">Higiene y Cuidado</a>
        <a href="/snacks">Snacks y Premios</a>
      </nav>
    </div>

    <div class="five-footer-nav-col">
      <h4>Servicios & Herramientas</h4>
      <nav aria-label="Enlaces de herramientas">
        <a href="/comparador" style="color:#7025a8; font-weight:750; display:flex; align-items:center; gap:6px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#7025A8" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg> Comparador de Alimentos</a>
        <a href="/rastreo" style="color:#276717; font-weight:750; display:flex; align-items:center; gap:6px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#276717" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg> Rastrear mi Pedido</a>
        <a href="/conoce-five">Nuestra Historia</a>
        <a href="/conoce-five#contacto">Atención al Cliente</a>
        <a href="/conoce-five#politicas">Despachos y Entregas</a>
      </nav>
    </div>
  </div>

  <div class="five-footer-bottom">
    <div class="five-wrap five-footer-bottom-inner">
      <span>© 2026 FIVE Mascotas · Tienda de Nutrición y Bienestar Animal</span>
      <div class="five-footer-trust">
        <span class="five-trust-badge"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px; margin-right:4px;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg> Compra Segura SSL</span>
        <span class="five-trust-badge"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px; margin-right:4px;"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg> Envíos a todo Chile</span>
      </div>
      <span>Diseño y tecnología por Epistia</span>
    </div>
  </div>
</footer>
