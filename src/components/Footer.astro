---
// Footer.astro
---

<footer class="five-footer">
  <div class="five-wrap five-footer-grid">
    <div class="five-footer-brand-col">
      <a class="five-logo" href="/" aria-label="FIVE Mascotas, inicio">
        <img src="/five-mascotas/logo.png" alt="FIVE Mascotas" width="160" height="80" loading="lazy" />
        <span class="five-logo-sub">MASCOTAS</span>
      </a>
      <p class="five-footer-tagline">
        Pequeños gestos cotidianos.<br />
        <strong>Grandes compañeros para toda la vida.</strong>
      </p>
      <div class="five-footer-contact">
        <span>📍 Santiago, Chile</span>
        <span>🕒 Lun a Sáb: 10:00 - 20:00 hrs</span>
        <span>✉️ contacto@fivemascotas.cl</span>
      </div>
    </div>

    <div class="five-footer-nav-col">
      <h4>Mascotas</h4>
      <nav aria-label="Enlaces por mascota">
        <a href="/perros">Alimentos para perros</a>
        <a href="/perros">Accesorios caninos</a>
        <a href="/gatos">Alimentos para gatos</a>
        <a href="/gatos">Arenas y accesorios felinos</a>
        <a href="/ofertas">Ofertas y promociones</a>
      </nav>
    </div>

    <div class="five-footer-nav-col">
      <h4>Departamentos</h4>
      <nav aria-label="Enlaces por departamento">
        <a href="/alimentos">Alimentos</a>
        <a href="/farmacia">Farmacia y Salud</a>
        <a href="/accesorios">Accesorios y Paseo</a>
        <a href="/higiene">Higiene y Cuidado</a>
        <a href="/snacks">Snacks y Premios</a>
      </nav>
    </div>

    <div class="five-footer-nav-col">
      <h4>Servicios & Herramientas</h4>
      <nav aria-label="Enlaces de herramientas">
        <a href="/comparador" style="color:#7025a8; font-weight:750;">🔍 Comparador de Alimentos</a>
        <a href="/rastreo" style="color:#276717; font-weight:750;">📦 Rastrear mi Pedido</a>
        <a href="/conoce-five">Nuestra Historia</a>
        <a href="/conoce-five#contacto">Atención al Cliente</a>
        <a href="/conoce-five#politicas">Despachos y Entregas</a>
      </nav>
    </div>
  </div>

  <div class="five-footer-bottom">
    <div class="five-wrap five-footer-bottom-inner">
      <span>© 2026 FIVE Mascotas · Tienda de Nutrición y Bienestar Animal</span>
      <div class="five-footer-trust">
        <span class="five-trust-badge">🔒 Compra Segura SSL</span>
        <span class="five-trust-badge">🇨🇱 Envíos en Chile</span>
      </div>
      <span>Diseño y tecnología por Epistia</span>
    </div>
  </div>
</footer>
