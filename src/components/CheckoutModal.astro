---
// src/components/CheckoutModal.astro
// Modal de Checkout interactivo paso a paso: Datos de entrega -> Medio de Pago (Webpay Plus, Khipu o Transferencia QR) -> Confirmación & Rastreo.
import { defaultBankAccount } from '../data/pim/bank';
import { defaultShippingRates } from '../data/pim/shipping';
import { formatMoney } from '../data/pim/catalog';
---

<dialog id="five-checkout-modal" class="five-checkout-dialog" aria-labelledby="chk-title">
  <div class="five-checkout-card">
    <!-- Header with Steps -->
    <div class="five-checkout-head">
      <div style="display:flex; align-items:center; justify-content:space-between;">
        <div style="display:flex; align-items:center; gap:8px;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#7025A8" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
          <h2 id="chk-title" style="font-size:18px; font-weight:850; margin:0; color:#111827;">Finalizar Compra FIVE</h2>
        </div>
        <button type="button" class="five-dialog-close" data-chk-close aria-label="Cerrar checkout">&times;</button>
      </div>

      <!-- Step Indicator Bar -->
      <div class="five-chk-steps-bar" role="tablist">
        <div class="five-chk-step is-active" id="chk-step-pill-1">
          <span class="chk-step-num">1</span>
          <span>Despacho</span>
        </div>
        <div class="chk-step-divider"></div>
        <div class="five-chk-step" id="chk-step-pill-2">
          <span class="chk-step-num">2</span>
          <span>Medio de Pago</span>
        </div>
        <div class="chk-step-divider"></div>
        <div class="five-chk-step" id="chk-step-pill-3">
          <span class="chk-step-num">3</span>
          <span>Confirmación</span>
        </div>
      </div>
    </div>

    <!-- Body Container with 3 Steps -->
    <div class="five-checkout-body">
      <!-- ================= STEP 1: DESPACHO Y CONTACTO ================= -->
      <div id="chk-step-1" class="five-chk-step-pane">
        <h3 style="font-size:15px; font-weight:800; margin-bottom:12px; color:#111827;">1. Datos de Entrega y Contacto</h3>
        <form id="chk-form-step1" style="display:flex; flex-direction:column; gap:12px;">
          <div class="five-form-grid-2">
            <div>
              <label for="chk-name" class="five-label">Nombre y Apellido *</label>
              <input type="text" id="chk-name" class="five-input" required placeholder="ej: Constanza Silva" />
            </div>
            <div>
              <label for="chk-phone" class="five-label">Teléfono WhatsApp *</label>
              <input type="tel" id="chk-phone" class="five-input" required placeholder="+56 9 1234 5678" />
            </div>
          </div>

          <div class="five-form-grid-2">
            <div>
              <label for="chk-email" class="five-label">Correo Electrónico (opcional)</label>
              <input type="email" id="chk-email" class="five-input" placeholder="tu@correo.cl" />
            </div>
            <div>
              <label for="chk-city" class="five-label">Ciudad / Comuna de Despacho *</label>
              <select id="chk-city" class="five-select" style="width:100%;" required>
                {defaultShippingRates.map((r) => (
                  <option value={r.id} selected={r.isDefault} data-price={r.price} data-city={r.city}>
                    {r.city} — {formatMoney(r.price)}
                  </option>
                ))}
              </select>
            </div>
          </div>

          <div>
            <label for="chk-address" class="five-label">Dirección de Entrega (Calle, Número, Depto/Casa) *</label>
            <input type="text" id="chk-address" class="five-input" required placeholder="ej: Av. San Miguel 3420, Dpto 402" />
          </div>

          <div>
            <label for="chk-notes" class="five-label">Instrucciones o Referencias de Entrega</label>
            <textarea id="chk-notes" class="five-textarea" rows="2" placeholder="ej: Dejar en conserjería o llamar al citófono"></textarea>
          </div>

          <!-- Order Summary snippet -->
          <fieldset id="chk-quotation-option" hidden>
            <legend>Compra o cotización</legend>
            <label><input id="chk-quotation" type="checkbox" /> Solicitar cotización formal en lugar de comprar</label>
            <label for="chk-rut" class="five-label">RUT para la cotización (opcional)</label>
            <input id="chk-rut" class="five-input" maxlength="12" placeholder="12345678-9" />
            <p>El correo es obligatorio para solicitudes a Nexo. La cotización no reserva inventario.</p>
          </fieldset>
          <p id="chk-nexo-feedback" role="status" aria-live="polite"></p>
          <div class="five-chk-mini-summary" id="chk-mini-summary">
            <!-- Dynamically populated -->
          </div>

          <div style="display:flex; justify-content:space-between; margin-top:8px;">
            <button type="button" class="five-text-btn" data-chk-close>Cancelar</button>
            <button type="submit" class="five-button" style="padding:10px 24px; display:inline-flex; align-items:center; gap:8px;">
              <span>Continuar al Pago</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          </div>
        </form>
      </div>

      <!-- ================= STEP 2: MEDIO DE PAGO ================= -->
      <div id="chk-step-2" class="five-chk-step-pane" hidden>
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:14px;">
          <div>
            <h3 style="font-size:16px; font-weight:800; margin:0 0 4px; color:#111827;">2. Selecciona tu Medio de Pago</h3>
            <p style="font-size:12.5px; color:#6b7280; margin:0;">Elige cómo prefieres abonar tu compra:</p>
          </div>
          <span class="five-badge-pill green" style="font-size:11px;">Pago Seguro</span>
        </div>

        <!-- Selector de Métodos de Pago con botones táctiles (mínimo 52px de alto) -->
        <div class="five-pay-methods-grid" role="radiogroup" aria-label="Métodos de Pago">
          <!-- Opción 1: Webpay Plus -->
          <button type="button" class="five-pay-method-btn is-selected" id="chk-tab-webpay" data-pay-method="webpay" aria-checked="true">
            <span class="five-pay-method-badge">Transbank</span>
            <div class="five-pay-method-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#7025A8" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
            </div>
            <div class="five-pay-method-info">
              <strong>Webpay Plus</strong>
              <small>Débito, Crédito, Prepago</small>
            </div>
          </button>

          <!-- Opción 2: Khipu -->
          <button type="button" class="five-pay-method-btn" id="chk-tab-khipu" data-pay-method="khipu" aria-checked="false">
            <span class="five-pay-method-badge info">Automático</span>
            <div class="five-pay-method-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2"><path d="M3 21h18"></path><path d="M3 10h18"></path><path d="M5 6l7-3 7 3"></path><path d="M4 10v11"></path><path d="M20 10v11"></path><path d="M8 14v4"></path><path d="M12 14v4"></path><path d="M16 14v4"></path></svg>
            </div>
            <div class="five-pay-method-info">
              <strong>Khipu</strong>
              <small>Transferencia instantánea</small>
            </div>
          </button>

          <!-- Opción 3: Transferencia Manual / QR -->
          <button type="button" class="five-pay-method-btn" id="chk-tab-transfer" data-pay-method="transfer" aria-checked="false">
            <span class="five-pay-method-badge green">Directo</span>
            <div class="five-pay-method-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#276717" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
            </div>
            <div class="five-pay-method-info">
              <strong>Transferencia QR</strong>
              <small>Manual con comprobante</small>
            </div>
          </button>
        </div>

        <!-- ================= PANEL 1: WEBPAY PLUS ================= -->
        <div id="chk-panel-webpay" class="five-pay-content-panel">
          <div class="five-pay-summary-card">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
              <span style="font-size:13px; color:#4b5563;">Total a pagar con tarjeta:</span>
              <strong id="chk-webpay-amount" style="font-size:22px; color:#7025a8;">$0</strong>
            </div>
            <p style="font-size:12px; color:#6b7280; margin:0 0 12px; line-height:1.45;">
              Paga en línea con Redcompra, tarjeta de débito, crédito o prepago a través de la pasarela certificada de Transbank Webpay Plus con confirmación inmediata.
            </p>
            <div style="display:flex; align-items:center; gap:8px; font-size:11.5px; color:#276717; background:#f0fdf4; padding:8px 12px; border-radius:8px; border:1px solid #bbf7d0;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#276717" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              <span>Transacción cifrada y protegida por los estándares de seguridad de Transbank</span>
            </div>
          </div>

          <div id="chk-webpay-feedback" role="status" aria-live="polite" hidden></div>

          <div style="display:flex; justify-content:space-between; align-items:center; margin-top:16px;">
            <button type="button" class="five-text-btn chk-back-btn">Volver a Datos</button>
            <button type="button" class="five-button" id="chk-btn-pay-webpay" style="background:#7025a8; padding:12px 28px; font-size:14.5px; font-weight:800; min-height:48px; display:inline-flex; align-items:center; gap:8px;">
              <span>Pagar con Webpay Plus</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          </div>
        </div>

        <!-- ================= PANEL 2: KHIPU ================= -->
        <div id="chk-panel-khipu" class="five-pay-content-panel" hidden>
          <div class="five-pay-summary-card">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
              <span style="font-size:13px; color:#4b5563;">Total a transferir vía Khipu:</span>
              <strong id="chk-khipu-amount" style="font-size:22px; color:#0284c7;">$0</strong>
            </div>
            <p style="font-size:12px; color:#6b7280; margin:0 0 12px; line-height:1.45;">
              Transfiere desde cualquier banco nacional (BancoEstado, Santander, Banco de Chile, BCI, Scotiabank, etc.) con verificación automática instantánea sin necesidad de adjuntar comprobantes.
            </p>
            <div style="display:flex; align-items:center; gap:8px; font-size:11.5px; color:#0369a1; background:#f0f9ff; padding:8px 12px; border-radius:8px; border:1px solid #bae6fd;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              <span>Confirmación automática de pago en segundos vinculada a tu pedido</span>
            </div>
          </div>

          <div id="chk-khipu-feedback" role="status" aria-live="polite" hidden></div>

          <div style="display:flex; justify-content:space-between; align-items:center; margin-top:16px;">
            <button type="button" class="five-text-btn chk-back-btn">Volver a Datos</button>
            <button type="button" class="five-button" id="chk-btn-pay-khipu" style="background:#0284c7; padding:12px 28px; font-size:14.5px; font-weight:800; min-height:48px; display:inline-flex; align-items:center; gap:8px;">
              <span>Pagar con Khipu</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          </div>
        </div>

        <!-- ================= PANEL 3: TRANSFERENCIA MANUAL + QR ================= -->
        <div id="chk-panel-transfer" class="five-pay-content-panel" hidden>
          <div class="five-qr-payment-grid">
            <!-- QR Code Display Box -->
            <div class="five-qr-box">
              <div class="five-qr-code-canvas-wrap">
                <!-- Dynamic QR Code generated via API / SVG -->
                <img
                  id="chk-qr-image"
                  alt="Código QR para Transferencia Bancaria"
                  width="190"
                  height="190"
                  loading="eager"
                />
              </div>
              <span class="five-qr-hint" style="display:flex; align-items:center; justify-content:center; gap:6px;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#7025A8" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>
                Escanea con tu cámara o app bancaria para obtener los datos
              </span>
            </div>

            <!-- Bank Details text card -->
            <div class="five-bank-details-card">
              <div class="five-bank-row">
                <div class="five-bank-text-wrap">
                  <span class="five-bank-label">Banco:</span>
                  <strong id="chk-bank-name" class="five-bank-val">{defaultBankAccount.bankName}</strong>
                </div>
                <button type="button" class="five-mini-copy-btn" data-copy-target="#chk-bank-name" aria-label="Copiar Banco">
                  <span>Copiar</span>
                </button>
              </div>

              <div class="five-bank-row">
                <div class="five-bank-text-wrap">
                  <span class="five-bank-label">Tipo de Cuenta:</span>
                  <strong id="chk-bank-type" class="five-bank-val">{defaultBankAccount.accountType}</strong>
                </div>
                <button type="button" class="five-mini-copy-btn" data-copy-target="#chk-bank-type" aria-label="Copiar Tipo de Cuenta">
                  <span>Copiar</span>
                </button>
              </div>

              <div class="five-bank-row highlight-row">
                <div class="five-bank-text-wrap">
                  <span class="five-bank-label">Número de Cuenta:</span>
                  <strong id="chk-bank-number" class="five-bank-val" style="color:#7025a8; font-size:15px; font-family:monospace;">{defaultBankAccount.accountNumber}</strong>
                </div>
                <button type="button" class="five-mini-copy-btn prominent" data-copy-target="#chk-bank-number" aria-label="Copiar Número de Cuenta">
                  <span>Copiar Cuenta</span>
                </button>
              </div>

              <div class="five-bank-row highlight-row">
                <div class="five-bank-text-wrap">
                  <span class="five-bank-label">RUT:</span>
                  <strong id="chk-bank-rut" class="five-bank-val" style="font-family:monospace;">{defaultBankAccount.holderRut}</strong>
                </div>
                <button type="button" class="five-mini-copy-btn prominent" data-copy-target="#chk-bank-rut" aria-label="Copiar RUT">
                  <span>Copiar RUT</span>
                </button>
              </div>

              <div class="five-bank-row">
                <div class="five-bank-text-wrap">
                  <span class="five-bank-label">Titular:</span>
                  <strong id="chk-bank-holder" class="five-bank-val">{defaultBankAccount.holderName}</strong>
                </div>
                <button type="button" class="five-mini-copy-btn" data-copy-target="#chk-bank-holder" aria-label="Copiar Titular">
                  <span>Copiar</span>
                </button>
              </div>

              <div class="five-bank-row">
                <div class="five-bank-text-wrap">
                  <span class="five-bank-label">Correo para Comprobante:</span>
                  <strong id="chk-bank-email" class="five-bank-val">{defaultBankAccount.email}</strong>
                </div>
                <button type="button" class="five-mini-copy-btn" data-copy-target="#chk-bank-email" aria-label="Copiar Correo">
                  <span>Copiar</span>
                </button>
              </div>

              <div class="five-bank-row total-row">
                <div class="five-bank-text-wrap">
                  <span class="five-bank-label" style="font-weight:800; color:#111827;">Monto Exacto a Transferir:</span>
                  <strong id="chk-bank-amount" class="five-bank-val" style="font-size:17px; color:#276717;">$0</strong>
                </div>
                <button type="button" class="five-mini-copy-btn prominent green" data-copy-target="#chk-bank-amount" aria-label="Copiar Monto Exacto">
                  <span>Copiar Monto</span>
                </button>
              </div>

              <button type="button" class="five-copy-data-btn" id="chk-copy-btn">
                <span>Copiar todos los datos de transferencia juntos</span>
              </button>
            </div>
          </div>

          <div class="five-cart-notice" style="margin-block:14px 10px; font-size:11.5px; background:#faf5ff; border:1px solid #e9d5ff; color:#6b21a8;">
            <strong>Importante:</strong> Al transferir, escribe tu código de pedido en el asunto/comentario de la transferencia. Luego pulsa "Ya Transferí / Confirmar Pedido" para enviarnos tu comprobante por WhatsApp.
          </div>

          <div style="display:flex; justify-content:space-between; align-items:center; margin-top:14px;">
            <button type="button" class="five-text-btn chk-back-btn" id="chk-back-to-step1">Volver a Datos</button>
            <button type="button" class="five-button" id="chk-confirm-pay-btn" style="background:#276717; padding:10px 24px; min-height:46px; display:inline-flex; align-items:center; gap:8px;">
              <span>Ya Transferí / Confirmar Pedido</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          </div>
        </div>
      </div>

      <!-- ================= STEP 3: CONFIRMACIÓN Y CÓDIGO DE SEGUIMIENTO ================= -->
      <div id="chk-step-3" class="five-chk-step-pane" hidden>
        <div style="text-align:center; padding:10px 0 16px;">
          <div style="display:flex; justify-content:center; margin-bottom:12px;"><div style="width:56px; height:56px; border-radius:50%; background:#edf8e8; display:flex; align-items:center; justify-content:center;"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#276717" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg></div></div>
          <h3 style="font-size:20px; font-weight:850; color:#111827; margin:0 0 6px;">Solicitud registrada</h3>
          <p id="chk-result-message" style="color:#4b5563; font-size:13.5px; margin:0;">
            Guarda el número de tu solicitud. La tienda verificará el pago y la disponibilidad:
          </p>

          <!-- Tracking Code Hero Box -->
          <div class="five-tracking-code-hero">
            <span style="font-size:11px; text-transform:uppercase; letter-spacing:0.8px; color:#6b7280; font-weight:700;">Número de solicitud</span>
            <div style="display:flex; align-items:center; justify-content:center; gap:10px; margin-block:4px;">
              <strong id="chk-tracking-code" class="five-tracking-code-text">FIVE-TRK-8492</strong>
              <button type="button" class="five-mini-copy-btn prominent" id="chk-copy-track-code" data-copy-target="#chk-tracking-code" aria-label="Copiar código de seguimiento">
                <span>Copiar</span>
              </button>
            </div>
            <small id="chk-result-status" style="color:#276717; font-weight:600; font-size:11.5px;">Estado: Pendiente de confirmación de transferencia</small>
          </div>

          <!-- WhatsApp Verification Button -->
          <div style="max-width:440px; margin:18px auto 0;">
            <a id="chk-whatsapp-proof-btn" href="#" target="_blank" rel="noopener noreferrer" class="five-button" style="background:#25d366; color:#ffffff; width:100%; justify-content:center; padding:12px 18px; font-size:14px; box-shadow:0 4px 14px rgba(37,211,102,0.3);">
              <span>Enviar Comprobante por WhatsApp</span>
            </a>
            <small id="chk-proof-help" style="color:#6b7280; font-size:11px; margin-top:6px;">
              Haz clic para abrir WhatsApp con el mensaje pre-llenado listo para adjuntar tu captura o comprobante.
            </small>
          </div>

          <div style="margin-top:24px; display:flex; justify-content:center; gap:12px; flex-wrap:wrap;">
            <a id="chk-quotation-pdf" class="five-button" hidden download>Descargar cotización PDF</a>
            <a href="/rastreo" id="chk-go-track-btn" class="five-button" style="background:#7025a8; font-size:13px; padding:9px 18px; display:inline-flex; align-items:center; gap:6px;">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              <span>Ir a Rastrear este Pedido</span>
            </a>
            <button type="button" class="five-text-btn" data-chk-close>
              Continuar comprando
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</dialog>

<style>
  .five-checkout-dialog {
    width: min(720px, calc(100% - 24px));
    max-height: 94vh;
    border: 1px solid var(--border-color);
    border-radius: 20px;
    padding: 0;
    background: #ffffff;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.25);
    overflow: hidden;
  }

  .five-checkout-dialog::backdrop {
    background: rgba(23, 12, 33, 0.68);
    backdrop-filter: blur(3px);
  }

  .five-checkout-card {
    padding: 24px 28px;
    max-height: 92vh;
    overflow-y: auto;
  }

  .five-chk-steps-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block: 16px 20px;
    padding: 10px 16px;
    background: #f9fafb;
    border-radius: 12px;
  }

  .five-chk-step {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    font-weight: 750;
    color: #9ca3af;
  }

  .five-chk-step.is-active {
    color: #7025a8;
  }

  .chk-step-num {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #e5e7eb;
    color: #4b5563;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 850;
  }

  .five-chk-step.is-active .chk-step-num {
    background: #7025a8;
    color: #ffffff;
  }

  .chk-step-divider {
    flex: 1;
    height: 2px;
    background: #e5e7eb;
    margin-inline: 12px;
  }

  .five-form-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
