---
import type { Product } from '../data/pim/types';
import { formatMoney } from '../data/pim/catalog';

interface Props {
  product: Product;
}

const { product } = Astro.props;

// Calculate debit surcharge (+5%)
const debitPrice = Math.round(product.price * 1.05);

// Calculate discount percentage if oldPrice exists
const discountPercent = product.oldPrice > product.price
  ? Math.round(((product.oldPrice - product.price) / product.oldPrice) * 100)
  : 0;

const cleanId = product.id.replace('prod-', '');
---

<article
  class="five-product-card"
  data-product
  data-id={product.id}
  data-pet={product.pet}
  data-brand={product.brand}
  data-category={product.category}
  data-subcategory={product.subcategory}
  data-type={product.category}
  data-format={product.format}
  data-lifestage={product.lifeStage}
  data-price={product.price}
  data-offer={product.oldPrice > 0 ? "true" : "false"}
  data-search={`${product.name} ${product.brand} ${product.detail} ${product.category} ${product.subcategory} ${product.pet}`}
>
  <div class={`five-product-image-box ${product.color}`}>
    <span class="five-product-pet-tag">
      {product.pet === 'Perros Gatos' ? 'Perros y gatos' : product.pet}
    </span>

    {product.badge && (
      <span class="five-product-badge">
        {product.badge}
      </span>
    )}

    <a href={`/producto/${product.id}`} class="five-product-image-link" aria-label={`Ver ficha de ${product.name}`}>
      <img
        src={product.image}
        alt={`Envase: ${product.name}`}
        width="300"
        height="360"
        loading="lazy"
      />
    </a>

    <button
      type="button"
      class="five-card-quickview-btn"
      data-quickview={product.id}
      data-name={product.name}
      data-brand={product.brand}
      data-detail={product.detail}
      data-price={product.price}
      data-oldprice={product.oldPrice}
      data-image={product.image}
      data-format={product.format}
      data-cleanid={cleanId}
      aria-label={`Vista rápida de ${product.name}`}
      title="Vista rápida"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
        <circle cx="12" cy="12" r="3"></circle>
      </svg>
      <span>Vista Rápida</span>
    </button>

    <button
      type="button"
      class="five-wishlist-btn"
      aria-label={`Guardar ${product.name} en favoritos`}
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
      </svg>
    </button>
  </div>

  <div class="five-product-details">
    <div class="five-product-meta-header">
      <span class="five-product-brand">{product.brand}®</span>
    </div>

    <h3 class="five-product-title">
      <a href={`/producto/${product.id}`}>{product.name}</a>
    </h3>
    <span class="five-product-meta">{product.detail}</span>

    <!-- ID and Stock availability row (Foto usuario) -->
    <div class="five-product-sku-row">
      <span class="five-sku-text">ID {cleanId.padStart(5, '0')}</span>
      <span class="five-stock-badge">+15 Unid.</span>
    </div>

    <!-- Discount row if on sale (Foto usuario) -->
    <div class="five-product-discount-row">
      {discountPercent > 0 ? (
        <span class="five-discount-pill">-{discountPercent}%</span>
      ) : null}
      {product.oldPrice > 0 ? (
        <del class="five-old-price" aria-label="Precio normal anterior">
          {formatMoney(product.oldPrice)}
        </del>
      ) : (
        <span class="five-old-price-spacer"></span>
      )}
    </div>

    <!-- Dual Pricing Block (Foto usuario: Transferencia/Efectivo vs Tarjeta Débito) -->
    <div class="five-dual-pricing-block">
      <!-- Primary Price (Transferencia / Efectivo) -->
      <div class="five-primary-price-group">
        <strong class="five-price-hero">{formatMoney(product.price)}</strong>
        <span class="five-price-type-label">Transferencia / Efectivo</span>
      </div>

      <!-- Secondary Price (Débito +5%) -->
      <div class="five-secondary-price-group">
        <strong class="five-price-debit">{formatMoney(debitPrice)}</strong>
        <span class="five-price-type-sublabel">Tarjeta Débito (+5%)</span>
      </div>
    </div>

    <!-- Action Button (Foto usuario: Dark button con icono carrito) -->
    <div class="five-product-bottom-row">
      <button
        class="five-card-add-btn"
        data-add={product.id}
        data-name={product.name}
        data-price={product.price}
        data-image={product.image}
        aria-label={`Agregar ${product.name} al carro`}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <span>Agregar al carro</span>
      </button>
    </div>
  </div>
</article>
