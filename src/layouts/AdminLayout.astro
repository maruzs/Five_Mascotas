---
import '@fontsource-variable/dm-sans';
import '../styles/admin.css';

interface Props {
  title?: string;
  activeNav?: 'dashboard' | 'pim' | 'pedidos' | 'cms' | 'categorias' | 'despacho' | 'imagenes';
  breadcrumbTitle?: string;
}

const {
  title = 'FIVE Mascotas — Panel de Administración',
  activeNav = 'dashboard',
  breadcrumbTitle = 'Dashboard General',
} = Astro.props;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#7025a8" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="FIVE Admin" />

    <link rel="manifest" href="/admin-manifest.webmanifest" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <title>{title}</title>
  </head>
  <body class="admin-body">
    <!-- Admin Sidebar (Desktop View) -->
    <aside class="admin-sidebar" aria-label="Navegación del panel de control">
      <div class="admin-sidebar-brand">
        <a href="/admin" aria-label="Ir al inicio de FIVE Admin">
          <img src="/five-mascotas/logo.png" alt="FIVE Mascotas" width="100" height="50" />
        </a>
        <span class="admin-badge-role">Backoffice PWA</span>
      </div>

      <nav class="admin-nav">
        <a href="/admin" class={`admin-nav-item ${activeNav === 'dashboard' ? 'is-active' : ''}`}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          <span>Dashboard</span>
        </a>

        <a href="/admin/pedidos" class={`admin-nav-item ${activeNav === 'pedidos' ? 'is-active' : ''}`}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          <span>Control de Pedidos</span>
        </a>

        <a href="/admin/pim" class={`admin-nav-item ${activeNav === 'pim' ? 'is-active' : ''}`}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span>Catálogo PIM</span>
        </a>

        <a href="/admin/pim-imagenes" class={`admin-nav-item ${activeNav === 'imagenes' ? 'is-active' : ''}`}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
          <span>Imágenes y Fichas</span>
        </a>

        <a href="/admin/cms" class={`admin-nav-item ${activeNav === 'cms' ? 'is-active' : ''}`}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
          <span>CMS Banners</span>
        </a>

        <a href="/admin/categorias" class={`admin-nav-item ${activeNav === 'categorias' ? 'is-active' : ''}`}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="8" y1="6" x2="21" y2="6"></line>
            <line x1="8" y1="12" x2="21" y2="12"></line>
            <line x1="8" y1="18" x2="21" y2="18"></line>
            <line x1="3" y1="6" x2="3.01" y2="6"></line>
            <line x1="3" y1="12" x2="3.01" y2="12"></line>
            <line x1="3" y1="18" x2="3.01" y2="18"></line>
          </svg>
          <span>Mega-Menú</span>
        </a>

        <a href="/admin/despacho" class={`admin-nav-item ${activeNav === 'despacho' ? 'is-active' : ''}`}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
          <span>Tarifas Despacho</span>
        </a>
      </nav>

      <div class="admin-sidebar-footer">
        <a href="/" target="_blank" rel="noopener noreferrer" class="admin-view-store-btn" title="Abrir tienda en nueva pestaña">
          <span>Ver Tienda Pública</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      </div>
    </aside>

    <!-- Admin Main Body Wrapper -->
    <div class="admin-main-wrap">
      <!-- Topbar Header -->
      <header class="admin-topbar">
        <div class="admin-breadcrumbs">
          <a href="/admin" class="admin-brand-link-mobile">
            <img src="/five-mascotas/logo.png" alt="FIVE" class="admin-topbar-mobile-logo" />
          </a>
          <span class="admin-breadcrumbs-separator">/</span>
          <strong class="admin-breadcrumbs-current">{breadcrumbTitle}</strong>
        </div>

        <div class="admin-topbar-actions">
          <!-- Install PWA Button (Visible only when eligible or installable) -->
          <button
            type="button"
            id="pwa-install-btn"
            class="admin-pwa-btn"
            style="display:none;"
            title="Instalar FIVE Admin en este dispositivo"
            aria-label="Instalar FIVE Admin PWA"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span class="admin-pwa-label">Instalar App</span>
          </button>

          <!-- Push Notifications Toggle / Status Button -->
          <button
            type="button"
            id="admin-push-btn"
            class="admin-icon-btn"
            title="Configurar Notificaciones Push"
            aria-label="Notificaciones Push"
          >
            <svg id="push-icon-active" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
              <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
            </svg>
            <span id="push-status-dot" class="admin-push-dot"></span>
          </button>

          <!-- System Status Pill -->
          <div class="admin-status-pill">
            <span class="admin-status-dot"></span>
            <span class="admin-status-text">PIM En Línea</span>
          </div>

          <!-- User Profile & Logout -->
          <div class="admin-user-ctrl">
            <div class="admin-user-meta">
              <strong id="admin-user-name">Admin</strong>
              <small>Sesión Activa</small>
            </div>
            <button
              type="button"
              id="admin-logout-btn"
              class="admin-btn secondary admin-logout-action"
              title="Cerrar sesión segura"
              aria-label="Cerrar sesión"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
              </svg>
              <span>Salir</span>
            </button>
          </div>
        </div>
      </header>

      <!-- Main Content Area -->
      <main class="admin-content">
        <slot />
      </main>
    </div>

    <!-- Mobile Bottom Navigation Bar (Screens < 768px) -->
    <nav class="admin-bottom-nav" aria-label="Navegación inferior móvil">
      <a href="/admin" class={`admin-bottom-item ${activeNav === 'dashboard' ? 'is-active' : ''}`}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        <span>Inicio</span>
      </a>

      <a href="/admin/pedidos" class={`admin-bottom-item ${activeNav === 'pedidos' ? 'is-active' : ''}`}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
        </svg>
        <span>Pedidos</span>
      </a>

      <a href="/admin/pim" class={`admin-bottom-item ${activeNav === 'pim' ? 'is-active' : ''}`}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span>Catálogo</span>
      </a>

      <a href="/admin/cms" class={`admin-bottom-item ${activeNav === 'cms' ? 'is-active' : ''}`}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
          <line x1="8" y1="21" x2="16" y2="21"></line>
          <line x1="12" y1="17" x2="12" y2="21"></line>
        </svg>
        <span>Banners</span>
      </a>

      <button type="button" id="admin-mobile-more-trigger" class="admin-bottom-item" aria-label="Abrir menú de herramientas">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="1"></circle>
          <circle cx="19" cy="12" r="1"></circle>
          <circle cx="5" cy="12" r="1"></circle>
        </svg>
        <span>Más</span>
      </button>
    </nav>

    <!-- Mobile "Más Herramientas" Bottom Sheet Backdrop -->
    <div id="admin-more-sheet" class="admin-sheet-backdrop" hidden>
      <div class="admin-sheet-dialog" role="dialog" aria-modal="true" aria-labelledby="sheet-title">
        <div class="admin-sheet-handle-bar">
          <div class="admin-sheet-handle"></div>
        </div>

        <div class="admin-sheet-header">
          <h3 id="sheet-title" class="admin-sheet-title">Herramientas Operativas</h3>
          <button type="button" id="admin-more-sheet-close" class="admin-sheet-close-btn" aria-label="Cerrar menú">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <div class="admin-sheet-content">
          <!-- Quick Links -->
          <div class="admin-sheet-section">
            <span class="admin-sheet-section-title">Navegación</span>
            <div class="admin-sheet-grid">
              <a href="/admin/pim-imagenes" class="admin-sheet-tile">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <circle cx="8.5" cy="8.5" r="1.5"></circle>
                  <polyline points="21 15 16 10 5 21"></polyline>
                </svg>
                <span>Imágenes y Fichas</span>
              </a>

              <a href="/admin/categorias" class="admin-sheet-tile">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="8" y1="6" x2="21" y2="6"></line>
                  <line x1="8" y1="12" x2="21" y2="12"></line>
                  <line x1="8" y1="18" x2="21" y2="18"></line>
                  <line x1="3" y1="6" x2="3.01" y2="6"></line>
                  <line x1="3" y1="12" x2="3.01" y2="12"></line>
                  <line x1="3" y1="18" x2="3.01" y2="18"></line>
                </svg>
                <span>Mega-Menú</span>
              </a>

              <a href="/admin/despacho" class="admin-sheet-tile">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="1" y="3" width="15" height="13"></rect>
                  <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                  <circle cx="5.5" cy="18.5" r="2.5"></circle>
                  <circle cx="18.5" cy="18.5" r="2.5"></circle>
                </svg>
                <span>Tarifas Despacho</span>
              </a>

              <a href="/" target="_blank" rel="noopener noreferrer" class="admin-sheet-tile">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
                <span>Ver Tienda</span>
              </a>
            </div>
          </div>

          <!-- PWA & Push Controls -->
          <div class="admin-sheet-section">
            <span class="admin-sheet-section-title">PWA & Alertas Push</span>
            <div class="admin-sheet-actions">
              <button type="button" id="sheet-push-toggle-btn" class="admin-sheet-action-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                  <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
                <div class="admin-sheet-action-text">
                  <strong id="sheet-push-label">Activar Notificaciones Push</strong>
                  <small id="sheet-push-sub">Alertas en tiempo real ante compras y pedidos</small>
                </div>
              </button>

              <button type="button" id="sheet-push-test-btn" class="admin-sheet-action-btn secondary">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
                <div class="admin-sheet-action-text">
                  <strong>Enviar Notificación de Prueba</strong>
                  <small>Verificar sonido y alerta en este dispositivo</small>
                </div>
              </button>

              <button type="button" id="sheet-install-btn" class="admin-sheet-action-btn secondary" style="display:none;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <div class="admin-sheet-action-text">
                  <strong>Instalar en Pantalla de Inicio</strong>
                  <small>Añadir PWA a tu teléfono o escritorio</small>
                </div>
              </button>
            </div>
          </div>

          <!-- Security Session -->
          <div class="admin-sheet-section">
            <button type="button" id="sheet-logout-btn" class="admin-sheet-action-btn danger">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
              </svg>
              <div class="admin-sheet-action-text">
                <strong>Cerrar Sesión Segura</strong>
                <small>Finalizar credencial en este navegador</small>
              </div>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Push Notification Modal / Popover (Desktop) -->
    <div id="admin-push-modal" class="admin-modal-backdrop" hidden>
      <div class="admin-modal" role="dialog" aria-modal="true" style="max-width:440px;">
        <div class="admin-modal-head">
          <h3 style="display:flex; align-items:center; gap:8px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
              <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
            </svg>
            <span>Notificaciones Push Web</span>
          </h3>
          <button type="button" id="push-modal-close" class="admin-sheet-close-btn" aria-label="Cerrar modal">&times;</button>
        </div>
        <div class="admin-modal-body">
          <p style="font-size:13.5px; color:#4b5563; margin:0 0 12px; line-height:1.5;">
            Recibe alertas instantáneas en tu dispositivo móvil o navegador cada vez que entre un nuevo pedido o se genere un evento crítico en bodega.
          </p>
          <div id="push-status-card" style="background:#f9fafb; border:1px solid #e5e7eb; border-radius:10px; padding:12px 14px; margin-bottom:14px;">
            <div style="display:flex; align-items:center; justify-content:space-between;">
              <span style="font-size:12.5px; font-weight:700; color:#1f2937;">Estado del Dispositivo:</span>
              <span id="push-state-badge" class="admin-badge-trend" style="font-size:11px;">Consultando...</span>
            </div>
          </div>
          <div style="display:flex; flex-direction:column; gap:10px;">
            <button type="button" id="modal-subscribe-btn" class="admin-btn primary" style="width:100%; justify-content:center;">
              Activar Notificaciones Push
            </button>
            <button type="button" id="modal-test-btn" class="admin-btn secondary" style="width:100%; justify-content:center;">
              Enviar Notificación de Prueba
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- PWA & Push Controller Script -->
    <script>
      // 1. Authentication Guard
      const checkAuth = async () => {
        try {
          const res = await fetch('/api/auth/me');
          if (!res.ok) {
            window.location.href = '/mi-cuenta?redirect=' + encodeURIComponent(window.location.pathname);
            return;
          }
          const data = await res.json();
          if (data?.user?.role !== 'admin') {
            alert('Acceso restringido: Se requieren permisos de administrador.');
            window.location.href = '/mi-cuenta';
            return;
          }
          const nameEl = document.querySelector('#admin-user-name');
          if (nameEl && data?.user?.name) {
            nameEl.textContent = data.user.name;
          }
        } catch {
          // Allow offline inspection
        }
      };

      const handleLogout = async () => {
        try {
          await fetch('/api/auth/logout', { method: 'POST' });
        } catch {}
        window.location.href = '/mi-cuenta';
      };

      document.querySelector('#admin-logout-btn')?.addEventListener('click', handleLogout);
      document.querySelector('#sheet-logout-btn')?.addEventListener('click', handleLogout);

      // 2. Service Worker Registration
      let swRegistration: ServiceWorkerRegistration | null = null;

      const registerServiceWorker = async () => {
        if (!('serviceWorker' in navigator)) return;
        try {
          swRegistration = await navigator.serviceWorker.register('/sw-admin.js', { scope: '/admin' });
          console.log('[PWA] Service Worker registrado para FIVE Admin (scope:', swRegistration.scope, ')');
          updatePushStatusUI();
        } catch (err) {
          console.warn('[PWA] No se pudo registrar Service Worker:', err);
        }
      };

      // 3. PWA Installation Handler (beforeinstallprompt)
      let deferredPrompt: any = null;
      const pwaBtn = document.querySelector<HTMLButtonElement>('#pwa-install-btn');
      const sheetInstallBtn = document.querySelector<HTMLButtonElement>('#sheet-install-btn');

      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;
        if (pwaBtn) pwaBtn.style.display = 'inline-flex';
        if (sheetInstallBtn) sheetInstallBtn.style.display = 'flex';
      });

      const triggerInstallPrompt = async () => {
        if (!deferredPrompt) {
          alert('FIVE Admin ya se encuentra instalado o tu navegador no soporta instalación automática. En iOS usa "Compartir > Agregar a Inicio".');
          return;
        }
        deferredPrompt.prompt();
        const { outcome } = await deferredPrompt.userChoice;
        if (outcome === 'accepted') {
          if (pwaBtn) pwaBtn.style.display = 'none';
          if (sheetInstallBtn) sheetInstallBtn.style.display = 'none';
        }
        deferredPrompt = null;
      };

      pwaBtn?.addEventListener('click', triggerInstallPrompt);
      sheetInstallBtn?.addEventListener('click', triggerInstallPrompt);

      window.addEventListener('appinstalled', () => {
        if (pwaBtn) pwaBtn.style.display = 'none';
        if (sheetInstallBtn) sheetInstallBtn.style.display = 'none';
        console.log('[PWA] FIVE Admin instalado con éxito en el dispositivo.');
      });

      // 4. Web Push Notifications Management
      const urlBase64ToUint8Array = (base64String: string) => {
        const padding = '='.repeat((4 - (base64String.length % 4)) % 4);
        const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
        const rawData = window.atob(base64);
        const outputArray = new Uint8Array(rawData.length);
        for (let i = 0; i < rawData.length; ++i) {
          outputArray[i] = rawData.charCodeAt(i);
        }
        return outputArray;
      };

      const pushBtn = document.querySelector<HTMLButtonElement>('#admin-push-btn');
      const pushDot = document.querySelector<HTMLElement>('#push-status-dot');
      const pushModal = document.querySelector<HTMLElement>('#admin-push-modal');
      const pushModalClose = document.querySelector<HTMLButtonElement>('#push-modal-close');
      const pushStateBadge = document.querySelector<HTMLElement>('#push-state-badge');
      const modalSubscribeBtn = document.querySelector<HTMLButtonElement>('#modal-subscribe-btn');
      const modalTestBtn = document.querySelector<HTMLButtonElement>('#modal-test-btn');
      const sheetPushToggleBtn = document.querySelector<HTMLButtonElement>('#sheet-push-toggle-btn');
      const sheetPushLabel = document.querySelector<HTMLElement>('#sheet-push-label');
      const sheetPushSub = document.querySelector<HTMLElement>('#sheet-push-sub');
      const sheetPushTestBtn = document.querySelector<HTMLButtonElement>('#sheet-push-test-btn');

      const isPushSubscribed = async () => {
        if (!swRegistration) return false;
        try {
          const subscription = await swRegistration.pushManager.getSubscription();
          return Boolean(subscription);
        } catch {
          return false;
        }
      };

      const updatePushStatusUI = async () => {
        const subscribed = await isPushSubscribed();
        if (pushDot) {
          pushDot.classList.toggle('is-active', subscribed);
        }
        if (pushStateBadge) {
          if (subscribed) {
            pushStateBadge.textContent = 'Activo y Suscrito';
            pushStateBadge.className = 'admin-badge-trend up';
          } else {
            pushStateBadge.textContent = 'Inactivo';
            pushStateBadge.className = 'admin-badge-trend warning';
          }
        }
        if (modalSubscribeBtn) {
          modalSubscribeBtn.textContent = subscribed ? 'Desactivar Notificaciones Push' : 'Activar Notificaciones Push';
        }
        if (sheetPushLabel) {
          sheetPushLabel.textContent = subscribed ? 'Notificaciones Push Activas' : 'Activar Notificaciones Push';
        }
        if (sheetPushSub) {
          sheetPushSub.textContent = subscribed ? 'Toca para pausar alertas en este equipo' : 'Alertas en tiempo real ante compras y pedidos';
        }
      };

      const togglePushSubscription = async () => {
        if (!('Notification' in window) || !('serviceWorker' in navigator)) {
          alert('Tu navegador no soporta la Web Push API.');
          return;
        }

        if (!swRegistration) {
          swRegistration = await navigator.serviceWorker.ready;
        }

        const currentSub = await swRegistration.pushManager.getSubscription();

        if (currentSub) {
          // Unsubscribe
          await currentSub.unsubscribe();
          await fetch('/api/admin/push-unsubscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ endpoint: currentSub.endpoint }),
          });
          alert('Notificaciones Push desactivadas en este dispositivo.');
          updatePushStatusUI();
          return;
        }

        // Request Permission
        const permission = await Notification.requestPermission();
        if (permission !== 'granted') {
          alert('Debes conceder permisos de notificación en el navegador para recibir alertas.');
          return;
        }

        // Fetch Public Key
        const keyRes = await fetch('/api/admin/push-vapid-key');
        if (!keyRes.ok) {
          alert('No se pudo obtener la llave pública del servidor.');
          return;
        }
        const { publicKey } = await keyRes.json();
        const applicationServerKey = urlBase64ToUint8Array(publicKey);

        // Subscribe with Push Manager
        const newSub = await swRegistration.pushManager.subscribe({
          userVisibleOnly: true,
          applicationServerKey,
        });

        // Send to backend
        const subRes = await fetch('/api/admin/push-subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            subscription: newSub.toJSON(),
            userAgent: navigator.userAgent,
          }),
        });

        if (subRes.ok) {
          alert('¡Listo! Notificaciones Push activadas con éxito.');
          updatePushStatusUI();
        } else {
          alert('Error al registrar la suscripción en el servidor.');
        }
      };

      const sendTestPush = async () => {
        try {
          const res = await fetch('/api/admin/push-test', { method: 'POST' });
          const data = await res.json();
          if (data.ok) {
            alert(`Alerta de prueba enviada a ${data.result?.sent || 1} dispositivo(s). Revisa tus notificaciones.`);
          } else {
            alert('Error al enviar prueba: ' + (data.error || 'Desconocido'));
          }
        } catch (err: any) {
          alert('Error de red al probar notificación: ' + err.message);
        }
      };

      pushBtn?.addEventListener('click', () => {
        if (pushModal) {
          pushModal.hidden = false;
          pushModal.style.display = 'flex';
          updatePushStatusUI();
        }
      });

      pushModalClose?.addEventListener('click', () => {
        if (pushModal) {
          pushModal.hidden = true;
          pushModal.style.display = 'none';
        }
      });

      modalSubscribeBtn?.addEventListener('click', togglePushSubscription);
      modalTestBtn?.addEventListener('click', sendTestPush);
      sheetPushToggleBtn?.addEventListener('click', togglePushSubscription);
      sheetPushTestBtn?.addEventListener('click', sendTestPush);

      // 5. Mobile "Más" Bottom Sheet Dialog Controller
      const sheet = document.querySelector<HTMLElement>('#admin-more-sheet');
      const sheetTrigger = document.querySelector<HTMLButtonElement>('#admin-mobile-more-trigger');
      const sheetClose = document.querySelector<HTMLButtonElement>('#admin-more-sheet-close');

      const openSheet = () => {
        if (!sheet) return;
        sheet.hidden = false;
        sheet.style.display = 'flex';
        document.body.classList.add('overflow-hidden');
        updatePushStatusUI();
      };

      const closeSheet = () => {
        if (!sheet) return;
        sheet.hidden = true;
        sheet.style.display = 'none';
        document.body.classList.remove('overflow-hidden');
      };

      sheetTrigger?.addEventListener('click', openSheet);
      sheetClose?.addEventListener('click', closeSheet);
      sheet?.addEventListener('click', (e) => {
        if (e.target === sheet) closeSheet();
      });

      // Initialization
      checkAuth();
      registerServiceWorker();
    </script>
  </body>
</html>
