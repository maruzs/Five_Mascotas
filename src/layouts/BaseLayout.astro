---
import '@fontsource-variable/dm-sans';
import '../styles/five-mascotas.css';
import TopTicker from '../components/TopTicker.astro';
import Header from '../components/Header.astro';
import MegaMenu from '../components/MegaMenu.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import QuickViewModal from '../components/QuickViewModal.astro';
import CheckoutModal from '../components/CheckoutModal.astro';
import MobileDrawer from '../components/MobileDrawer.astro';
import MobileBottomNav from '../components/MobileBottomNav.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'FIVE Mascotas — Su felicidad empieza en el plato',
  description = 'Tienda online FIVE Mascotas. Nutrición premium, alimentos, accesorios y farmacia para perros y gatos.',
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#7025A8" />
    <title>{title}</title>
  </head>
  <body class="five-body">
    <a class="five-skip" href="#contenido">Saltar al contenido</a>

    <!-- Top Announcement Ticker (Foto 4) -->
    <TopTicker />

    <!-- Main Header Bar -->
    <Header />

    <!-- Mega-Navbar Category Bar (Foto 2) -->
    <MegaMenu currentPath={currentPath} />

    <!-- Main Content Area -->
    <main id="contenido" class="five-main-content">
      <slot />
    </main>

    <!-- Full-width Footer -->
    <Footer />

    <!-- Shopping Cart Modal / Drawer -->
    <CartDrawer />

    <!-- Quick View Product Modal -->
    <QuickViewModal />

    <!-- Checkout Modal Step-by-Step with QR -->
    <CheckoutModal />

    <!-- Mobile Navigation Drawer -->
    <MobileDrawer />

    <!-- Sticky Mobile Bottom Bar (Foto 1) -->
    <MobileBottomNav currentPath={currentPath} />

    <!-- Store Client Logic -->
    <script>
      import '../scripts/store';
    </script>
  </body>
</html>
